# Optional RouterCloud versioned-backup overrides.
# Copy to:
#   ~/.config/routercloud-backup.env
#
# EnvironmentFile values are literal. Use absolute paths for path overrides.
# Never store the restic password itself here.

ROUTERCLOUD_BACKUP_HOST=192.168.50.1
ROUTERCLOUD_BACKUP_USER=admin1
ROUTERCLOUD_BACKUP_SSH_PORT=1122
ROUTERCLOUD_BACKUP_REMOTE=/tmp/mnt/ROUTER_DATA/RouterCloud/

# Optional deployment-specific overrides:
# ROUTERCLOUD_BACKUP_KEY=/home/USER/.ssh/id_ed25519_routercloud_backup
# ROUTERCLOUD_BACKUP_MOUNT=/mnt/dysk-lokalny
# ROUTERCLOUD_RESTIC_REPO=/mnt/dysk-lokalny/backups/routercloud-restic
# ROUTERCLOUD_RESTIC_PASSWORD_FILE=/home/USER/.config/routercloud-backup/restic-password
# ROUTERCLOUD_VM_IMPORT_URL=http://127.0.0.1:8428/api/v1/import/prometheus
