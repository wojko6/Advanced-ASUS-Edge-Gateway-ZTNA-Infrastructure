# Copy to ~/.config/pihole-dns-collector.env and replace placeholders.
# Do not put the Pi-hole application password in this file.

ROUTER_HOST=REPLACE_ROUTER_HOST
ROUTER_PORT=1122
ROUTER_USER=REPLACE_ME

# Pi-hole FTL web/API listener as reachable from the router itself.
PIHOLE_REMOTE_HOST=REPLACE_PIHOLE_LAN_IP
PIHOLE_REMOTE_PORT=8080
PIHOLE_LOCAL_PORT=18080

# Collector only sends credentials to loopback cleartext HTTP.
PIHOLE_API_URL=http://127.0.0.1:18080
PIHOLE_APP_PASSWORD_FILE=/home/REPLACE_ME/.config/pihole-dns-collector/app-password

PIHOLE_STATE_DIR=/home/REPLACE_ME/.local/state/pihole-dns-collector
PIHOLE_OUTPUT_FILE=/home/REPLACE_ME/.local/state/pihole-dns-collector/queries.ndjson
PIHOLE_STATE_DB=/home/REPLACE_ME/.local/state/pihole-dns-collector/state.sqlite3

PIHOLE_HTTP_TIMEOUT=15
PIHOLE_PAGE_SIZE=500
PIHOLE_MAX_PAGES=1000
