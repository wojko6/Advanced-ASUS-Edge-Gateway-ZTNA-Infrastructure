*nat
:PREROUTING ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
:EDGE_TS_PREROUTING - [0:0]
-A PREROUTING -i tailscale0 -j EDGE_TS_PREROUTING
-A EDGE_TS_PREROUTING -p udp --dport 53 -j REDIRECT --to-ports 53
-A EDGE_TS_PREROUTING -p tcp --dport 53 -j REDIRECT --to-ports 53
-A POSTROUTING -o ppp0 ! -s 198.51.100.25/32 -j MASQUERADE
COMMIT
