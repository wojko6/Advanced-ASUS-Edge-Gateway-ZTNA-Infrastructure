#!/bin/sh
# shellcheck shell=dash

PATH="/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Resolve executables directly because older Asuswrt-Merlin BusyBox shells may
# not implement "command -v". Keep this helper local so each script is standalone.
executable_exists() {
    executable_name="$1"
    case "$executable_name" in
        */*) [ -x "$executable_name" ]; return ;;
    esac
    for executable_dir in /opt/sbin /opt/bin /usr/sbin /usr/bin /sbin /bin; do
        [ -x "$executable_dir/$executable_name" ] && return 0
    done
    return 1
}

CONFIG_FILE="${EDGE_CONFIG_FILE:-/jffs/configs/asus-edge.conf}"
IPTABLES="${EDGE_IPTABLES:-iptables}"
IP6TABLES="${EDGE_IP6TABLES:-ip6tables}"
LOGGER="${EDGE_LOGGER:-logger}"

log() { "$LOGGER" -t asus-edge "$*"; }
die() { log "ERROR: $*"; exit 1; }

[ -r "$CONFIG_FILE" ] || die "missing configuration: $CONFIG_FILE"
# shellcheck disable=SC1090
. "$CONFIG_FILE"

: "${EDGE_TS_IF:=tailscale0}"
: "${EDGE_LAN_IF:=br0}"
: "${EDGE_TAILNET_V4_CIDR:=100.64.0.0/10}"
: "${EDGE_ROUTER_LAN_IP:=192.168.50.1}"
: "${EDGE_ADMIN_TS_SOURCES:=}"
: "${EDGE_ALLOW_ROUTER_HTTPS:=1}"
: "${EDGE_ROUTER_HTTPS_PORT:=8443}"
: "${EDGE_ALLOW_ROUTER_SSH:=0}"
: "${EDGE_ROUTER_SSH_PORT:=22}"
: "${EDGE_INTERCEPT_DNS:=1}"
: "${EDGE_DNS_PORT:=53}"
: "${EDGE_ALLOWED_LAN_HOSTS:=}"
: "${EDGE_ALLOWED_LAN_TCP_PORTS:=}"
: "${EDGE_ALLOWED_LAN_UDP_PORTS:=}"
: "${EDGE_ALLOW_LAN_ICMP:=0}"
: "${EDGE_PRINTER_TS_SOURCES:=}"
: "${EDGE_PRINTER_LAN_IP:=}"
: "${EDGE_PRINTER_TCP_PORTS:=80 631 9100}"
: "${EDGE_PRINTER_UDP_PORTS:=161}"
: "${EDGE_ENABLE_EXIT_NODE:=0}"
: "${EDGE_WAN_IF:=}"
: "${EDGE_LOG_DROPS:=1}"
: "${EDGE_LOG_PREFIX:=ASUS-EDGE-DROP }"

executable_exists "$IPTABLES" >/dev/null 2>&1 || die "iptables not found"

valid_port() {
    case "$1" in ''|*[!0-9]*) return 1 ;; esac
    [ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 65535 ] 2>/dev/null
}
valid_boolean() { case "$1" in 0|1) return 0 ;; *) return 1 ;; esac; }
validate_boolean() { valid_boolean "$2" || die "invalid boolean $1: $2"; }
valid_interface() {
    case "$1" in
        ''|*[!A-Za-z0-9_.:+-]*) return 1 ;;
        *) [ "${#1}" -le 15 ] ;;
    esac
}
valid_ipv4() {
    old_ifs="$IFS"; IFS=.; set -- $1; IFS="$old_ifs"
    [ "$#" -eq 4 ] || return 1
    for octet in "$@"; do
        case "$octet" in ''|*[!0-9]*) return 1 ;; esac
        [ "$octet" -le 255 ] 2>/dev/null || return 1
    done
}
valid_ipv4_cidr() {
    case "$1" in */*) address=${1%/*}; prefix=${1#*/} ;; *) return 1 ;; esac
    valid_ipv4 "$address" || return 1
    case "$prefix" in ''|*[!0-9]*) return 1 ;; esac
    [ "$prefix" -le 32 ] 2>/dev/null
}
valid_ipv4_or_cidr() { valid_ipv4 "$1" || valid_ipv4_cidr "$1"; }

validate_boolean EDGE_ALLOW_ROUTER_HTTPS "$EDGE_ALLOW_ROUTER_HTTPS"
validate_boolean EDGE_ALLOW_ROUTER_SSH "$EDGE_ALLOW_ROUTER_SSH"
validate_boolean EDGE_INTERCEPT_DNS "$EDGE_INTERCEPT_DNS"
validate_boolean EDGE_ALLOW_LAN_ICMP "$EDGE_ALLOW_LAN_ICMP"
validate_boolean EDGE_ENABLE_EXIT_NODE "$EDGE_ENABLE_EXIT_NODE"
validate_boolean EDGE_LOG_DROPS "$EDGE_LOG_DROPS"

for port in "$EDGE_ROUTER_HTTPS_PORT" "$EDGE_ROUTER_SSH_PORT" "$EDGE_DNS_PORT" $EDGE_ALLOWED_LAN_TCP_PORTS $EDGE_ALLOWED_LAN_UDP_PORTS $EDGE_PRINTER_TCP_PORTS $EDGE_PRINTER_UDP_PORTS; do
    valid_port "$port" || die "invalid port: $port"
done

valid_interface "$EDGE_TS_IF" || die "invalid Tailscale interface: $EDGE_TS_IF"
valid_interface "$EDGE_LAN_IF" || die "invalid LAN interface: $EDGE_LAN_IF"
[ -z "$EDGE_WAN_IF" ] || valid_interface "$EDGE_WAN_IF" || die "invalid WAN interface: $EDGE_WAN_IF"
valid_ipv4 "$EDGE_ROUTER_LAN_IP" || die "invalid router LAN IPv4: $EDGE_ROUTER_LAN_IP"
valid_ipv4_cidr "$EDGE_TAILNET_V4_CIDR" || die "invalid tailnet IPv4 CIDR: $EDGE_TAILNET_V4_CIDR"
for source in $EDGE_ADMIN_TS_SOURCES $EDGE_PRINTER_TS_SOURCES; do
    valid_ipv4_or_cidr "$source" || die "invalid Tailscale source: $source"
done
for host in $EDGE_ALLOWED_LAN_HOSTS; do
    valid_ipv4_or_cidr "$host" || die "invalid allowed LAN host: $host"
done
[ -z "$EDGE_PRINTER_LAN_IP" ] || valid_ipv4 "$EDGE_PRINTER_LAN_IP" || die "invalid printer LAN IPv4: $EDGE_PRINTER_LAN_IP"

if [ -n "$EDGE_PRINTER_TS_SOURCES" ] && [ -z "$EDGE_PRINTER_LAN_IP" ]; then die "printer sources configured without EDGE_PRINTER_LAN_IP"; fi
if [ -z "$EDGE_PRINTER_TS_SOURCES" ] && [ -n "$EDGE_PRINTER_LAN_IP" ]; then die "printer LAN IP configured without EDGE_PRINTER_TS_SOURCES"; fi

detect_wan_if() {
    [ -n "$EDGE_WAN_IF" ] && { printf '%s\n' "$EDGE_WAN_IF"; return; }
    if executable_exists nvram >/dev/null 2>&1; then
        wan_if="$(nvram get wan0_gw_ifname 2>/dev/null)"
        [ -n "$wan_if" ] || wan_if="$(nvram get wan0_ifname 2>/dev/null)"
        [ -n "$wan_if" ] && { valid_interface "$wan_if" || return 1; printf '%s\n' "$wan_if"; return; }
    fi
    wan_if="$(ip route 2>/dev/null | awk '/^default / { print $5; exit }')"
    [ -n "$wan_if" ] && valid_interface "$wan_if" && printf '%s\n' "$wan_if"
}

flush_chain() { table="$1"; chain="$2"; "$IPTABLES" -t "$table" -N "$chain" 2>/dev/null || true; "$IPTABLES" -t "$table" -F "$chain" || die "cannot flush $table/$chain"; }
single_jump() { table="$1"; parent="$2"; interface="$3"; chain="$4"; while "$IPTABLES" -t "$table" -D "$parent" -i "$interface" -j "$chain" 2>/dev/null; do :; done; "$IPTABLES" -t "$table" -I "$parent" 1 -i "$interface" -j "$chain" || die "cannot attach $chain"; }
remove_all_rules() { table="$1"; chain="$2"; shift 2; while "$IPTABLES" -t "$table" -D "$chain" "$@" 2>/dev/null; do :; done; }
remove_legacy_tailscale_rules() {
    remove_all_rules filter INPUT -i tailscale+ -j ACCEPT
    remove_all_rules filter FORWARD -i tailscale+ -j ACCEPT
    remove_all_rules filter INPUT -i tailscale+ -p tcp -m tcp --dport "$EDGE_DNS_PORT" -j ACCEPT
    remove_all_rules filter INPUT -i tailscale+ -p udp -m udp --dport "$EDGE_DNS_PORT" -j ACCEPT
    remove_all_rules nat PREROUTING -i tailscale+ -p tcp -m tcp --dport "$EDGE_DNS_PORT" -j DNAT --to-destination "$EDGE_ROUTER_LAN_IP:$EDGE_DNS_PORT"
    remove_all_rules nat PREROUTING -i tailscale+ -p udp -m udp --dport "$EDGE_DNS_PORT" -j DNAT --to-destination "$EDGE_ROUTER_LAN_IP:$EDGE_DNS_PORT"
    remove_all_rules nat PREROUTING -i tailscale+ -p tcp -m tcp --dport "$EDGE_ROUTER_HTTPS_PORT" -j DNAT --to-destination "$EDGE_ROUTER_LAN_IP:$EDGE_ROUTER_HTTPS_PORT"
}
add_admin_input_rules() {
    for source in $EDGE_ADMIN_TS_SOURCES; do
        [ "$EDGE_ALLOW_ROUTER_HTTPS" = "1" ] && "$IPTABLES" -A EDGE_TS_INPUT -s "$source" -p tcp --dport "$EDGE_ROUTER_HTTPS_PORT" -m conntrack --ctstate NEW -j ACCEPT || [ "$EDGE_ALLOW_ROUTER_HTTPS" != "1" ] || die "HTTPS rule failed"
        [ "$EDGE_ALLOW_ROUTER_SSH" = "1" ] && "$IPTABLES" -A EDGE_TS_INPUT -s "$source" -p tcp --dport "$EDGE_ROUTER_SSH_PORT" -m conntrack --ctstate NEW -j ACCEPT || [ "$EDGE_ALLOW_ROUTER_SSH" != "1" ] || die "SSH rule failed"
    done
}
add_admin_nat_rules() { [ "$EDGE_ALLOW_ROUTER_HTTPS" = "1" ] || return 0; for source in $EDGE_ADMIN_TS_SOURCES; do "$IPTABLES" -t nat -A EDGE_TS_PREROUTING -s "$source" -p tcp --dport "$EDGE_ROUTER_HTTPS_PORT" -j DNAT --to-destination "$EDGE_ROUTER_LAN_IP:$EDGE_ROUTER_HTTPS_PORT" || die "HTTPS DNAT rule failed"; done; }
add_lan_forward_rules() {
    for host in $EDGE_ALLOWED_LAN_HOSTS; do
        for port in $EDGE_ALLOWED_LAN_TCP_PORTS; do "$IPTABLES" -A EDGE_TS_FORWARD -d "$host" -p tcp --dport "$port" -m conntrack --ctstate NEW -j ACCEPT || die "LAN TCP rule failed"; done
        for port in $EDGE_ALLOWED_LAN_UDP_PORTS; do "$IPTABLES" -A EDGE_TS_FORWARD -d "$host" -p udp --dport "$port" -m conntrack --ctstate NEW -j ACCEPT || die "LAN UDP rule failed"; done
        [ "$EDGE_ALLOW_LAN_ICMP" = "1" ] && "$IPTABLES" -A EDGE_TS_FORWARD -d "$host" -p icmp --icmp-type echo-request -j ACCEPT || [ "$EDGE_ALLOW_LAN_ICMP" != "1" ] || die "LAN ICMP rule failed"
    done
}
add_printer_forward_rules() {
    [ -n "$EDGE_PRINTER_TS_SOURCES" ] || return 0
    for source in $EDGE_PRINTER_TS_SOURCES; do
        for port in $EDGE_PRINTER_TCP_PORTS; do "$IPTABLES" -A EDGE_TS_FORWARD -i "$EDGE_TS_IF" -o "$EDGE_LAN_IF" -s "$source" -d "$EDGE_PRINTER_LAN_IP" -p tcp --dport "$port" -m conntrack --ctstate NEW -j ACCEPT || die "printer TCP rule failed"; done
        for port in $EDGE_PRINTER_UDP_PORTS; do "$IPTABLES" -A EDGE_TS_FORWARD -i "$EDGE_TS_IF" -o "$EDGE_LAN_IF" -s "$source" -d "$EDGE_PRINTER_LAN_IP" -p udp --dport "$port" -j ACCEPT || die "printer UDP rule failed"; done
    done
}

"$IPTABLES" -t filter -I INPUT 1 -i "$EDGE_TS_IF" -j DROP || die "cannot install temporary INPUT guard"
"$IPTABLES" -t filter -I FORWARD 1 -i "$EDGE_TS_IF" -j DROP || die "cannot install temporary FORWARD guard"
remove_legacy_tailscale_rules
flush_chain filter EDGE_TS_INPUT
flush_chain filter EDGE_TS_FORWARD
flush_chain nat EDGE_TS_PREROUTING
"$IPTABLES" -A EDGE_TS_INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT || die "state rule failed"
if [ "$EDGE_INTERCEPT_DNS" = "1" ]; then
    "$IPTABLES" -A EDGE_TS_INPUT -s "$EDGE_TAILNET_V4_CIDR" -p udp --dport "$EDGE_DNS_PORT" -j ACCEPT || die "DNS UDP input rule failed"
    "$IPTABLES" -A EDGE_TS_INPUT -s "$EDGE_TAILNET_V4_CIDR" -p tcp --dport "$EDGE_DNS_PORT" -j ACCEPT || die "DNS TCP input rule failed"
    "$IPTABLES" -t nat -A EDGE_TS_PREROUTING -p udp --dport "$EDGE_DNS_PORT" -j REDIRECT --to-ports "$EDGE_DNS_PORT" || die "DNS UDP redirect failed"
    "$IPTABLES" -t nat -A EDGE_TS_PREROUTING -p tcp --dport "$EDGE_DNS_PORT" -j REDIRECT --to-ports "$EDGE_DNS_PORT" || die "DNS TCP redirect failed"
fi
add_admin_nat_rules
add_admin_input_rules
if [ "$EDGE_LOG_DROPS" = "1" ]; then "$IPTABLES" -A EDGE_TS_INPUT -m limit --limit 6/min --limit-burst 10 -j LOG --log-prefix "$EDGE_LOG_PREFIX" --log-level 6 || die "INPUT log rule failed"; fi
"$IPTABLES" -A EDGE_TS_INPUT -j DROP || die "INPUT drop rule failed"
"$IPTABLES" -A EDGE_TS_FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT || die "forward state rule failed"
add_lan_forward_rules
add_printer_forward_rules
if [ "$EDGE_ENABLE_EXIT_NODE" = "1" ]; then WAN_IF="$(detect_wan_if)"; [ -n "$WAN_IF" ] || die "cannot detect WAN interface; set EDGE_WAN_IF"; "$IPTABLES" -A EDGE_TS_FORWARD -o "$WAN_IF" -j ACCEPT || die "exit-node rule failed"; fi
if [ "$EDGE_LOG_DROPS" = "1" ]; then "$IPTABLES" -A EDGE_TS_FORWARD -m limit --limit 6/min --limit-burst 10 -j LOG --log-prefix "$EDGE_LOG_PREFIX" --log-level 6 || die "FORWARD log rule failed"; fi
"$IPTABLES" -A EDGE_TS_FORWARD -j DROP || die "FORWARD drop rule failed"
single_jump filter INPUT "$EDGE_TS_IF" EDGE_TS_INPUT
single_jump filter FORWARD "$EDGE_TS_IF" EDGE_TS_FORWARD
single_jump nat PREROUTING "$EDGE_TS_IF" EDGE_TS_PREROUTING

if executable_exists "$IP6TABLES" >/dev/null 2>&1; then
    "$IP6TABLES" -t filter -I INPUT 1 -i "$EDGE_TS_IF" -j DROP || die "cannot install temporary IPv6 INPUT guard"
    "$IP6TABLES" -t filter -I FORWARD 1 -i "$EDGE_TS_IF" -j DROP || die "cannot install temporary IPv6 FORWARD guard"
    for chain in EDGE_TS6_INPUT EDGE_TS6_FORWARD; do
        "$IP6TABLES" -t filter -N "$chain" 2>/dev/null || true
        "$IP6TABLES" -t filter -F "$chain" || die "cannot flush IPv6 chain $chain"
        "$IP6TABLES" -t filter -A "$chain" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT || die "IPv6 state rule failed"
        if [ "$EDGE_LOG_DROPS" = "1" ]; then "$IP6TABLES" -t filter -A "$chain" -m limit --limit 6/min --limit-burst 10 -j LOG --log-prefix "$EDGE_LOG_PREFIX" --log-level 6 || die "IPv6 log rule failed"; fi
        "$IP6TABLES" -t filter -A "$chain" -j DROP || die "IPv6 drop rule failed"
    done
    while "$IP6TABLES" -t filter -D INPUT -i "$EDGE_TS_IF" -j EDGE_TS6_INPUT 2>/dev/null; do :; done
    while "$IP6TABLES" -t filter -D FORWARD -i "$EDGE_TS_IF" -j EDGE_TS6_FORWARD 2>/dev/null; do :; done
    "$IP6TABLES" -t filter -I INPUT 1 -i "$EDGE_TS_IF" -j EDGE_TS6_INPUT || die "cannot attach IPv6 INPUT guard"
    "$IP6TABLES" -t filter -I FORWARD 1 -i "$EDGE_TS_IF" -j EDGE_TS6_FORWARD || die "cannot attach IPv6 FORWARD guard"
    "$IP6TABLES" -t filter -D INPUT -i "$EDGE_TS_IF" -j DROP || die "cannot remove temporary IPv6 INPUT guard"
    "$IP6TABLES" -t filter -D FORWARD -i "$EDGE_TS_IF" -j DROP || die "cannot remove temporary IPv6 FORWARD guard"
else
    log "WARNING: ip6tables unavailable; verify IPv6 is disabled"
fi
"$IPTABLES" -t filter -D INPUT -i "$EDGE_TS_IF" -j DROP || die "cannot remove temporary INPUT guard"
"$IPTABLES" -t filter -D FORWARD -i "$EDGE_TS_IF" -j DROP || die "cannot remove temporary FORWARD guard"
log "firewall policy applied: interface=$EDGE_TS_IF"
exit 0
