#!/bin/sh
# shellcheck shell=dash

PATH="/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Resolve executables directly because older Asuswrt-Merlin BusyBox shells may
# not implement "command -v". Keep this helper local so each script is standalone.
executable_exists() {
    executable_name="$1"
    case "$executable_name" in
        */*)
            [ -x "$executable_name" ]
            return
            ;;
    esac

    for executable_dir in /opt/sbin /opt/bin /usr/sbin /usr/bin /sbin /bin; do
        [ -x "$executable_dir/$executable_name" ] && return 0
    done
    return 1
}

CONFIG_FILE="${EDGE_CONFIG_FILE:-/jffs/configs/asus-edge.conf}"
LOCK_DIR="/var/run/asus-edge-services.lock"

log() {
    logger -t asus-edge "$*"
}

[ -r "$CONFIG_FILE" ] || { log "ERROR: missing $CONFIG_FILE"; exit 1; }
# shellcheck disable=SC1090
. "$CONFIG_FILE"

: "${EDGE_OPT_WAIT_SECONDS:=90}"
: "${EDGE_RUN_RC_UNSLUNG:=0}"
: "${EDGE_ENTWARE_START_WAIT_SECONDS:=330}"
: "${EDGE_SERVICE_STABILITY_SECONDS:=5}"
: "${EDGE_TS_SOCKET:=/var/run/tailscale/tailscaled.sock}"
: "${EDGE_TS_STATE:=/opt/var/lib/tailscale/tailscaled.state}"
: "${EDGE_ADVERTISE_ROUTES:=}"
: "${EDGE_ENABLE_EXIT_NODE:=0}"
: "${EDGE_ACCEPT_DNS:=false}"
: "${EDGE_HOSTNAME:=asus-edge-gateway}"

opt_is_ready() {
    [ -d /opt ] || return 1
    [ -x /opt/bin/opkg ] || [ -x /opt/sbin/opkg ]
}

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    log "services-start already running; exiting"
    exit 0
fi
trap 'rmdir "$LOCK_DIR" 2>/dev/null' EXIT HUP INT TERM

elapsed=0
while ! opt_is_ready 2>/dev/null; do
    elapsed=$((elapsed + 1))
    if [ "$elapsed" -ge "$EDGE_OPT_WAIT_SECONDS" ]; then
        log "ERROR: Entware /opt not ready after ${EDGE_OPT_WAIT_SECONDS}s"
        exit 1
    fi
    sleep 1
done

amtm_entware_startup_detected() {
    [ -r /jffs/scripts/post-mount ] &&
        grep -F '/jffs/addons/amtm/mount-entware.mod' /jffs/scripts/post-mount >/dev/null 2>&1
}

external_entware_start_running() {
    ps w 2>/dev/null |
        grep -E '[/](rc\.unslung|S[0-9][0-9]*unbound)([[:space:]]|$)' |
        grep -v grep >/dev/null 2>&1
}

wait_for_amtm_entware_startup() {
    elapsed=0
    quiet_seconds=0

    while [ "$elapsed" -lt "$EDGE_ENTWARE_START_WAIT_SECONDS" ]; do
        ntp_ready=1
        if executable_exists nvram >/dev/null 2>&1; then
            [ "$(nvram get ntp_ready 2>/dev/null)" = "1" ] || ntp_ready=0
        fi

        if external_entware_start_running || [ "$ntp_ready" != "1" ]; then
            quiet_seconds=0
        else
            quiet_seconds=$((quiet_seconds + 1))
            [ "$quiet_seconds" -ge 3 ] && return 0
        fi

        elapsed=$((elapsed + 1))
        sleep 1
    done

    return 1
}

if amtm_entware_startup_detected; then
    if wait_for_amtm_entware_startup; then
        log "amtm Entware startup settled"
    else
        log "WARNING: amtm Entware startup did not settle after ${EDGE_ENTWARE_START_WAIT_SECONDS}s"
    fi
fi

if [ "$EDGE_RUN_RC_UNSLUNG" = "1" ] && [ -x /opt/etc/init.d/rc.unslung ]; then
    /opt/etc/init.d/rc.unslung start >/tmp/asus-edge-entware-start.log 2>&1 ||
        log "WARNING: Entware startup returned non-zero"
fi

mkdir -p /opt/var/lib/unbound

if executable_exists tailscaled >/dev/null 2>&1; then
    if ! pidof tailscaled >/dev/null 2>&1; then
        mkdir -p "$(dirname "$EDGE_TS_STATE")" "$(dirname "$EDGE_TS_SOCKET")"
        tailscaled \
            --state="$EDGE_TS_STATE" \
            --socket="$EDGE_TS_SOCKET" \
            >/opt/var/log/tailscaled.log 2>&1 &
        sleep 3
    fi

    if tailscale --socket="$EDGE_TS_SOCKET" status >/dev/null 2>&1; then
        set -- tailscale --socket="$EDGE_TS_SOCKET" up --accept-dns="$EDGE_ACCEPT_DNS" --hostname="$EDGE_HOSTNAME"
        [ -n "$EDGE_ADVERTISE_ROUTES" ] && set -- "$@" --advertise-routes="$EDGE_ADVERTISE_ROUTES"
        [ "$EDGE_ENABLE_EXIT_NODE" = "1" ] && set -- "$@" --advertise-exit-node
        "$@" >/tmp/asus-edge-tailscale-up.log 2>&1 || log "WARNING: tailscale up failed; inspect /tmp/asus-edge-tailscale-up.log"
    else
        log "WARNING: Tailscale is not authenticated; run tailscale up interactively once"
    fi
else
    log "WARNING: tailscaled not installed"
fi

process_stays_running() {
    monitored_process="$1"
    stable_seconds=0

    while [ "$stable_seconds" -lt "$EDGE_SERVICE_STABILITY_SECONDS" ]; do
        pidof "$monitored_process" >/dev/null 2>&1 || return 1
        stable_seconds=$((stable_seconds + 1))
        sleep 1
    done

    return 0
}

start_entware_service_if_stopped() {
    process_name="$1"
    service_log="$2"
    shift 2

    if pidof "$process_name" >/dev/null 2>&1; then
        if process_stays_running "$process_name"; then
            log "$process_name already running and stable; preserving current process"
            return 0
        fi
        log "WARNING: $process_name exited during startup; attempting recovery"
    fi

    for service_path in "$@"; do
        [ -x "$service_path" ] || continue
        : >"$service_log"
        attempt=1
        while [ "$attempt" -le 3 ]; do
            printf 'Attempt %s: %s start\n' "$attempt" "$service_path" >>"$service_log"
            "$service_path" start >>"$service_log" 2>&1 || true
            if process_stays_running "$process_name"; then
                log "$process_name started via $service_path on attempt $attempt"
                return 0
            fi
            attempt=$((attempt + 1))
            sleep 2
        done
        log "WARNING: failed to stabilize $process_name; inspect $service_log"
        return 1
    done

    return 0
}

# amtm normally starts Entware daemons from post-mount. After that external
# startup settles, preserve stable processes and recover only a missing daemon.
start_entware_service_if_stopped unbound /tmp/asus-edge-unbound-start.log /opt/etc/init.d/S*unbound
start_entware_service_if_stopped syslog-ng /tmp/asus-edge-syslog-ng-start.log /opt/etc/init.d/S*syslog-ng

if [ -x /jffs/scripts/firewall-start ]; then
    /jffs/scripts/firewall-start || log "ERROR: firewall policy failed"
fi

log "services startup completed"
exit 0
