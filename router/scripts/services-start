#!/bin/sh
# shellcheck shell=dash

PATH="/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Resolve executables directly because older Asuswrt-Merlin BusyBox shells may
# not implement "command -v". Keep this helper local so each script is standalone.
executable_exists() {
    executable_name="$1"
    case "$executable_name" in
        */*)
            [ -x "$executable_name" ]
            return
            ;;
    esac

    for executable_dir in /opt/sbin /opt/bin /usr/sbin /usr/bin /sbin /bin; do
        [ -x "$executable_dir/$executable_name" ] && return 0
    done
    return 1
}

CONFIG_FILE="${EDGE_CONFIG_FILE:-/jffs/configs/asus-edge.conf}"
LOCK_DIR="/var/run/asus-edge-services.lock"
SWAPS_FILE="${EDGE_PROC_SWAPS:-/proc/swaps}"
OVERCOMMIT_FILE="${EDGE_PROC_OVERCOMMIT_MEMORY:-/proc/sys/vm/overcommit_memory}"

log() {
    logger -t asus-edge "$*"
}

[ -r "$CONFIG_FILE" ] || { log "ERROR: missing $CONFIG_FILE"; exit 1; }
# shellcheck disable=SC1090
. "$CONFIG_FILE"

: "${EDGE_OPT_WAIT_SECONDS:=90}"
: "${EDGE_RUN_RC_UNSLUNG:=0}"
: "${EDGE_ENTWARE_START_WAIT_SECONDS:=330}"
: "${EDGE_ENTWARE_QUIET_SECONDS:=20}"
: "${EDGE_SERVICE_STABILITY_SECONDS:=5}"
: "${EDGE_SERVICE_START_ATTEMPTS:=6}"
: "${EDGE_SERVICE_RETRY_SECONDS:=5}"
: "${EDGE_UNBOUND_PIDFILE:=/opt/var/run/unbound.pid}"
: "${EDGE_UNBOUND_BIN:=/opt/sbin/unbound}"
: "${EDGE_UNBOUND_CONFIG:=}"
: "${EDGE_ENTWARE_LD_LIBRARY_PATH:=/opt/lib:/opt/usr/lib}"
: "${EDGE_TS_SOCKET:=/var/run/tailscale/tailscaled.sock}"
: "${EDGE_TS_STATE:=/opt/var/lib/tailscale/tailscaled.state}"
: "${EDGE_TS_NETFILTER_MODE:=off}"
: "${EDGE_ADVERTISE_ROUTES:=}"
: "${EDGE_ENABLE_EXIT_NODE:=0}"
: "${EDGE_ACCEPT_DNS:=false}"
: "${EDGE_HOSTNAME:=asus-edge-gateway}"
: "${EDGE_REQUIRE_SWAP:=auto}"
: "${EDGE_SWAP_WAIT_SECONDS:=60}"
: "${EDGE_TS_READY_WAIT_SECONDS:=20}"
: "${EDGE_TAILSCALED_LOG:=/opt/var/log/tailscaled.log}"

valid_positive_integer() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$1" -gt 0 ]
}

for timing_name in \
    EDGE_OPT_WAIT_SECONDS \
    EDGE_ENTWARE_START_WAIT_SECONDS \
    EDGE_ENTWARE_QUIET_SECONDS \
    EDGE_SERVICE_STABILITY_SECONDS \
    EDGE_SERVICE_START_ATTEMPTS \
    EDGE_SERVICE_RETRY_SECONDS \
    EDGE_SWAP_WAIT_SECONDS \
    EDGE_TS_READY_WAIT_SECONDS
do
    case "$timing_name" in
        EDGE_OPT_WAIT_SECONDS) timing_value="$EDGE_OPT_WAIT_SECONDS" ;;
        EDGE_ENTWARE_START_WAIT_SECONDS) timing_value="$EDGE_ENTWARE_START_WAIT_SECONDS" ;;
        EDGE_ENTWARE_QUIET_SECONDS) timing_value="$EDGE_ENTWARE_QUIET_SECONDS" ;;
        EDGE_SERVICE_STABILITY_SECONDS) timing_value="$EDGE_SERVICE_STABILITY_SECONDS" ;;
        EDGE_SERVICE_START_ATTEMPTS) timing_value="$EDGE_SERVICE_START_ATTEMPTS" ;;
        EDGE_SERVICE_RETRY_SECONDS) timing_value="$EDGE_SERVICE_RETRY_SECONDS" ;;
        EDGE_SWAP_WAIT_SECONDS) timing_value="$EDGE_SWAP_WAIT_SECONDS" ;;
        EDGE_TS_READY_WAIT_SECONDS) timing_value="$EDGE_TS_READY_WAIT_SECONDS" ;;
    esac
    valid_positive_integer "$timing_value" || {
        log "ERROR: $timing_name must be a positive integer"
        exit 1
    }
done

case "$EDGE_RUN_RC_UNSLUNG" in
    0|1) ;;
    *) log "ERROR: EDGE_RUN_RC_UNSLUNG must be 0 or 1"; exit 1 ;;
esac

case "$EDGE_ENABLE_EXIT_NODE" in
    0|1) ;;
    *) log "ERROR: EDGE_ENABLE_EXIT_NODE must be 0 or 1"; exit 1 ;;
esac

case "$EDGE_ACCEPT_DNS" in
    true|false) ;;
    *) log "ERROR: EDGE_ACCEPT_DNS must be true or false"; exit 1 ;;
esac

case "$EDGE_REQUIRE_SWAP" in
    0|1|auto) ;;
    *) log "ERROR: EDGE_REQUIRE_SWAP must be 0, 1, or auto"; exit 1 ;;
esac

[ "$EDGE_TS_NETFILTER_MODE" = "off" ] || {
    log "ERROR: EDGE_TS_NETFILTER_MODE must be off because ASUS Edge owns the firewall policy"
    exit 1
}

opt_is_ready() {
    [ -d /opt ] || return 1
    [ -x /opt/bin/opkg ] || [ -x /opt/sbin/opkg ]
}

process_stays_running() {
    monitored_process="$1"
    stable_seconds=0

    while [ "$stable_seconds" -lt "$EDGE_SERVICE_STABILITY_SECONDS" ]; do
        pidof "$monitored_process" >/dev/null 2>&1 || return 1
        stable_seconds=$((stable_seconds + 1))
        sleep 1
    done

    return 0
}

swap_is_active() {
    [ -r "$SWAPS_FILE" ] &&
        awk 'NR > 1 { found=1 } END { exit !found }' "$SWAPS_FILE"
}

swap_is_required() {
    case "$EDGE_REQUIRE_SWAP" in
        1) return 0 ;;
        0) return 1 ;;
        auto) ;;
    esac

    [ -r "$OVERCOMMIT_FILE" ] || return 1
    [ "$(cat "$OVERCOMMIT_FILE" 2>/dev/null)" = "2" ] || return 1

    case "$(uname -m 2>/dev/null)" in
        armv[5-8]*|i[3-6]86|mips*|ppc) return 0 ;;
        *) return 1 ;;
    esac
}

wait_for_required_swap() {
    swap_is_required || return 0
    swap_is_active && return 0

    log "waiting for active swap before starting tailscaled"
    elapsed=0
    while ! swap_is_active; do
        if [ "$elapsed" -ge "$EDGE_SWAP_WAIT_SECONDS" ]; then
            log "ERROR: required swap not active after ${EDGE_SWAP_WAIT_SECONDS}s"
            return 1
        fi
        elapsed=$((elapsed + 1))
        sleep 1
    done
    log "required swap is active"
}

rotate_tailscaled_log() {
    [ -s "$EDGE_TAILSCALED_LOG" ] || return 0
    cp -f "$EDGE_TAILSCALED_LOG" "$EDGE_TAILSCALED_LOG.previous" 2>/dev/null || return 1
    chmod 0600 "$EDGE_TAILSCALED_LOG.previous" 2>/dev/null || true
}

start_tailscaled_with_retry() {
    if pidof tailscaled >/dev/null 2>&1; then
        if process_stays_running tailscaled; then
            return 0
        fi
        log "WARNING: tailscaled exited during startup; attempting recovery"
    fi

    wait_for_required_swap || return 1
    mkdir -p "$(dirname "$EDGE_TS_STATE")" "$(dirname "$EDGE_TS_SOCKET")" \
        "$(dirname "$EDGE_TAILSCALED_LOG")"
    rotate_tailscaled_log || log "WARNING: could not preserve previous tailscaled log"
    : >"$EDGE_TAILSCALED_LOG" || return 1
    chmod 0600 "$EDGE_TAILSCALED_LOG" 2>/dev/null || true

    attempt=1
    while [ "$attempt" -le "$EDGE_SERVICE_START_ATTEMPTS" ]; do
        if pidof tailscaled >/dev/null 2>&1; then
            if process_stays_running tailscaled; then
                return 0
            fi
            log "WARNING: competing tailscaled process exited during startup"
        fi
        rm -f "$EDGE_TS_SOCKET"
        printf 'Attempt %s/%s: tailscaled startup\n' \
            "$attempt" "$EDGE_SERVICE_START_ATTEMPTS" >>"$EDGE_TAILSCALED_LOG"
        tailscaled \
            --state="$EDGE_TS_STATE" \
            --socket="$EDGE_TS_SOCKET" \
            >>"$EDGE_TAILSCALED_LOG" 2>&1 &

        if process_stays_running tailscaled; then
            log "tailscaled started and stabilized on attempt $attempt"
            return 0
        fi

        log "WARNING: tailscaled attempt ${attempt}/${EDGE_SERVICE_START_ATTEMPTS} failed"
        attempt=$((attempt + 1))
        [ "$attempt" -le "$EDGE_SERVICE_START_ATTEMPTS" ] &&
            sleep "$EDGE_SERVICE_RETRY_SECONDS"
    done

    log "ERROR: failed to stabilize tailscaled; inspect $EDGE_TAILSCALED_LOG"
    return 1
}

wait_for_tailscale_api() {
    elapsed=0
    while [ "$elapsed" -lt "$EDGE_TS_READY_WAIT_SECONDS" ]; do
        pidof tailscaled >/dev/null 2>&1 || return 1
        tailscale --socket="$EDGE_TS_SOCKET" status >/dev/null 2>&1 && return 0
        elapsed=$((elapsed + 1))
        sleep 1
    done
    return 1
}

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    log "services-start already running; exiting"
    exit 0
fi
trap 'rmdir "$LOCK_DIR" 2>/dev/null' EXIT HUP INT TERM

elapsed=0
while ! opt_is_ready 2>/dev/null; do
    elapsed=$((elapsed + 1))
    if [ "$elapsed" -ge "$EDGE_OPT_WAIT_SECONDS" ]; then
        log "ERROR: Entware /opt not ready after ${EDGE_OPT_WAIT_SECONDS}s"
        exit 1
    fi
    sleep 1
done

amtm_entware_startup_detected() {
    [ -r /jffs/scripts/post-mount ] &&
        grep -F '/jffs/addons/amtm/mount-entware.mod' /jffs/scripts/post-mount >/dev/null 2>&1
}

external_entware_start_running() {
    ps w 2>/dev/null |
        grep -E '[/](rc\.unslung|S[0-9][0-9]*unbound)([[:space:]]|$)' |
        grep -v grep >/dev/null 2>&1
}

wait_for_amtm_entware_startup() {
    elapsed=0
    quiet_seconds=0
    unbound_stable_seconds=0

    while [ "$elapsed" -lt "$EDGE_ENTWARE_START_WAIT_SECONDS" ]; do
        ntp_ready=1
        if executable_exists nvram >/dev/null 2>&1; then
            [ "$(nvram get ntp_ready 2>/dev/null)" = "1" ] || ntp_ready=0
        fi

        if pidof unbound >/dev/null 2>&1; then
            quiet_seconds=0
            unbound_stable_seconds=$((unbound_stable_seconds + 1))
            [ "$unbound_stable_seconds" -ge "$EDGE_SERVICE_STABILITY_SECONDS" ] && return 0
        elif external_entware_start_running || [ "$ntp_ready" != "1" ]; then
            quiet_seconds=0
            unbound_stable_seconds=0
        else
            unbound_stable_seconds=0
            quiet_seconds=$((quiet_seconds + 1))
            [ "$quiet_seconds" -ge "$EDGE_ENTWARE_QUIET_SECONDS" ] && return 0
        fi

        elapsed=$((elapsed + 1))
        sleep 1
    done

    return 1
}

if amtm_entware_startup_detected; then
    if wait_for_amtm_entware_startup; then
        log "amtm Entware startup settled"
    else
        log "WARNING: amtm Entware startup did not settle after ${EDGE_ENTWARE_START_WAIT_SECONDS}s"
    fi
fi

if [ "$EDGE_RUN_RC_UNSLUNG" = "1" ] && [ -x /opt/etc/init.d/rc.unslung ]; then
    /opt/etc/init.d/rc.unslung start >/tmp/asus-edge-entware-start.log 2>&1 ||
        log "WARNING: Entware startup returned non-zero"
fi

mkdir -p /opt/var/lib/unbound
