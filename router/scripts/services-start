#!/bin/sh
# shellcheck shell=dash

PATH="/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin"

executable_exists() {
    executable_name="$1"
    case "$executable_name" in
        */*) [ -x "$executable_name" ]; return ;;
    esac
    for executable_dir in /opt/sbin /opt/bin /usr/sbin /usr/bin /sbin /bin; do
        [ -x "$executable_dir/$executable_name" ] && return 0
    done
    return 1
}

CONFIG_FILE="${EDGE_CONFIG_FILE:-/jffs/configs/asus-edge.conf}"
LOCK_DIR="/var/run/asus-edge-services.lock"
log() { logger -t asus-edge "$*"; }

[ -r "$CONFIG_FILE" ] || { log "ERROR: missing $CONFIG_FILE"; exit 1; }
# shellcheck disable=SC1090
. "$CONFIG_FILE"

: "${EDGE_OPT_WAIT_SECONDS:=90}"
: "${EDGE_RUN_RC_UNSLUNG:=0}"
: "${EDGE_ENTWARE_START_WAIT_SECONDS:=330}"
: "${EDGE_ENTWARE_QUIET_SECONDS:=20}"
: "${EDGE_SERVICE_STABILITY_SECONDS:=5}"
: "${EDGE_SERVICE_START_ATTEMPTS:=6}"
: "${EDGE_SERVICE_RETRY_SECONDS:=5}"
: "${EDGE_UNBOUND_PIDFILE=/opt/var/run/unbound.pid}"
: "${EDGE_UNBOUND_PORT:=53535}"
: "${EDGE_UNBOUND_READY_WAIT_SECONDS:=10}"
: "${EDGE_UNBOUND_BIN:=/opt/sbin/unbound}"
: "${EDGE_UNBOUND_CONFIG:=}"
: "${EDGE_ENTWARE_LD_LIBRARY_PATH:=/opt/lib:/opt/usr/lib}"
: "${EDGE_TS_SOCKET=/var/run/tailscale/tailscaled.sock}"
: "${EDGE_TS_STATE=/opt/var/lib/tailscale/tailscaled.state}"
: "${EDGE_TS_NETFILTER_MODE:=off}"
: "${EDGE_ADVERTISE_ROUTES:=}"
: "${EDGE_ENABLE_EXIT_NODE:=0}"
: "${EDGE_ACCEPT_DNS:=false}"
: "${EDGE_HOSTNAME:=asus-edge-gateway}"
: "${EDGE_REQUIRE_SWAP:=auto}"
: "${EDGE_SWAP_WAIT_SECONDS:=60}"
: "${EDGE_TS_READY_WAIT_SECONDS:=20}"
: "${EDGE_SERVICES_LOCK_WAIT_SECONDS:=20}"
: "${EDGE_TAILSCALED_LOG=/opt/var/log/tailscaled.log}"
: "${EDGE_TAILSCALE_HELPER:=/jffs/addons/asus-edge/bin/tailscale-reconcile}"

valid_positive_integer() {
    case "$1" in ''|*[!0-9]*) return 1 ;; esac
    [ "$1" -gt 0 ]
}

valid_absolute_path() {
    candidate_path="$1"
    case "$candidate_path" in
        /*) ;;
        *) return 1 ;;
    esac
    case "$candidate_path" in
        /|*'//'*) return 1 ;;
        */../*|*/..|*/./*|*/.) return 1 ;;
    esac
    return 0
}

path_below_prefix() {
    candidate_path="$1"
    allowed_prefix="$2"
    valid_absolute_path "$candidate_path" || return 1
    [ "$candidate_path" != "$allowed_prefix" ] || return 1
    case "$candidate_path" in
        "$allowed_prefix"/*) return 0 ;;
        *) return 1 ;;
    esac
}

validate_mutable_path() {
    value_name="$1"
    candidate_path="$2"
    allowed_prefix="$3"
    path_below_prefix "$candidate_path" "$allowed_prefix" || {
        log "ERROR: $value_name must be an absolute path below $allowed_prefix"
        return 1
    }
    [ ! -L "$candidate_path" ] || {
        log "ERROR: $value_name must not reference a symlink: $candidate_path"
        return 1
    }
    return 0
}

validate_mutable_path EDGE_TS_SOCKET "$EDGE_TS_SOCKET" /var/run/tailscale || exit 1
validate_mutable_path EDGE_TS_STATE "$EDGE_TS_STATE" /opt/var/lib/tailscale || exit 1
validate_mutable_path EDGE_TAILSCALED_LOG "$EDGE_TAILSCALED_LOG" /opt/var/log || exit 1
validate_mutable_path EDGE_UNBOUND_PIDFILE "$EDGE_UNBOUND_PIDFILE" /opt/var/run || exit 1
path_below_prefix "$EDGE_TAILSCALE_HELPER" /jffs/addons/asus-edge/bin || {
    log "ERROR: EDGE_TAILSCALE_HELPER must be below /jffs/addons/asus-edge/bin"
    exit 1
}
[ ! -L "$EDGE_TAILSCALE_HELPER" ] || { log "ERROR: EDGE_TAILSCALE_HELPER must not be a symlink"; exit 1; }
case "$EDGE_UNBOUND_PORT" in
    ''|*[!0-9]*) log "ERROR: EDGE_UNBOUND_PORT must be an integer between 1 and 65535"; exit 1 ;;
esac
[ "$EDGE_UNBOUND_PORT" -ge 1 ] && [ "$EDGE_UNBOUND_PORT" -le 65535 ] || {
    log "ERROR: EDGE_UNBOUND_PORT must be between 1 and 65535"
    exit 1
}

for timing_name in EDGE_OPT_WAIT_SECONDS EDGE_ENTWARE_START_WAIT_SECONDS EDGE_ENTWARE_QUIET_SECONDS EDGE_SERVICE_STABILITY_SECONDS EDGE_SERVICE_START_ATTEMPTS EDGE_SERVICE_RETRY_SECONDS EDGE_SWAP_WAIT_SECONDS EDGE_TS_READY_WAIT_SECONDS EDGE_UNBOUND_READY_WAIT_SECONDS EDGE_SERVICES_LOCK_WAIT_SECONDS; do
    case "$timing_name" in
        EDGE_OPT_WAIT_SECONDS) timing_value="$EDGE_OPT_WAIT_SECONDS" ;;
        EDGE_ENTWARE_START_WAIT_SECONDS) timing_value="$EDGE_ENTWARE_START_WAIT_SECONDS" ;;
        EDGE_ENTWARE_QUIET_SECONDS) timing_value="$EDGE_ENTWARE_QUIET_SECONDS" ;;
        EDGE_SERVICE_STABILITY_SECONDS) timing_value="$EDGE_SERVICE_STABILITY_SECONDS" ;;
        EDGE_SERVICE_START_ATTEMPTS) timing_value="$EDGE_SERVICE_START_ATTEMPTS" ;;
        EDGE_SERVICE_RETRY_SECONDS) timing_value="$EDGE_SERVICE_RETRY_SECONDS" ;;
        EDGE_SWAP_WAIT_SECONDS) timing_value="$EDGE_SWAP_WAIT_SECONDS" ;;
        EDGE_TS_READY_WAIT_SECONDS) timing_value="$EDGE_TS_READY_WAIT_SECONDS" ;;
        EDGE_UNBOUND_READY_WAIT_SECONDS) timing_value="$EDGE_UNBOUND_READY_WAIT_SECONDS" ;;
        EDGE_SERVICES_LOCK_WAIT_SECONDS) timing_value="$EDGE_SERVICES_LOCK_WAIT_SECONDS" ;;
    esac
    valid_positive_integer "$timing_value" || { log "ERROR: $timing_name must be a positive integer"; exit 1; }
done
case "$EDGE_RUN_RC_UNSLUNG" in 0|1) ;; *) log "ERROR: EDGE_RUN_RC_UNSLUNG must be 0 or 1"; exit 1 ;; esac
case "$EDGE_ENABLE_EXIT_NODE" in 0|1) ;; *) log "ERROR: EDGE_ENABLE_EXIT_NODE must be 0 or 1"; exit 1 ;; esac
case "$EDGE_ACCEPT_DNS" in true|false) ;; *) log "ERROR: EDGE_ACCEPT_DNS must be true or false"; exit 1 ;; esac
case "$EDGE_REQUIRE_SWAP" in 0|1|auto) ;; *) log "ERROR: EDGE_REQUIRE_SWAP must be 0, 1, or auto"; exit 1 ;; esac
[ "$EDGE_TS_NETFILTER_MODE" = "off" ] || { log "ERROR: EDGE_TS_NETFILTER_MODE must be off because ASUS Edge owns the firewall policy"; exit 1; }

opt_is_ready() { [ -d /opt ] || return 1; [ -x /opt/bin/opkg ] || [ -x /opt/sbin/opkg ]; }
process_stays_running() {
    monitored_process="$1"; stable_seconds=0
    while [ "$stable_seconds" -lt "$EDGE_SERVICE_STABILITY_SECONDS" ]; do
        pidof "$monitored_process" >/dev/null 2>&1 || return 1
        stable_seconds=$((stable_seconds + 1)); sleep 1
    done
    return 0
}
lock_owned=0
release_services_lock() {
    if [ "$lock_owned" = "1" ] && [ -d "$LOCK_DIR" ] &&
       [ "$(cat "$LOCK_DIR/owner" 2>/dev/null)" = "$" ]; then
        rm -f "$LOCK_DIR/owner" 2>/dev/null || true
        rmdir "$LOCK_DIR" 2>/dev/null || true
    fi
}

acquire_services_lock() {
    elapsed=0
    while [ "$elapsed" -lt "$EDGE_SERVICES_LOCK_WAIT_SECONDS" ]; do
        if mkdir "$LOCK_DIR" 2>/dev/null; then
            printf '%s\n' "$" >"$LOCK_DIR/owner" || {
                rmdir "$LOCK_DIR" 2>/dev/null || true
                return 1
            }
            lock_owned=1
            return 0
        fi

        owner_pid="$(cat "$LOCK_DIR/owner" 2>/dev/null)"
        if [ -z "$owner_pid" ] || ! kill -0 "$owner_pid" 2>/dev/null; then
            rm -f "$LOCK_DIR/owner" 2>/dev/null || true
            rmdir "$LOCK_DIR" 2>/dev/null || true
            continue
        fi

        elapsed=$((elapsed + 1))
        sleep 1
    done
    log "services-start already active after bounded wait; skipping concurrent mutation"
    return 2
}

trap release_services_lock EXIT
trap 'exit 1' HUP INT TERM
lock_rc=0
acquire_services_lock || lock_rc=$?
case "$lock_rc" in
    0) ;;
    2) exit 0 ;;
    *) log "ERROR: could not acquire services-start lock"; exit 1 ;;
esac

elapsed=0
while ! opt_is_ready 2>/dev/null; do
    elapsed=$((elapsed + 1))
    [ "$elapsed" -ge "$EDGE_OPT_WAIT_SECONDS" ] && { log "ERROR: Entware /opt not ready after ${EDGE_OPT_WAIT_SECONDS}s"; exit 1; }
    sleep 1
done

amtm_entware_startup_detected() { [ -r /jffs/scripts/post-mount ] && grep -F '/jffs/addons/amtm/mount-entware.mod' /jffs/scripts/post-mount >/dev/null 2>&1; }
external_entware_start_running() { ps w 2>/dev/null | grep -E '[/](rc\.unslung|S[0-9][0-9]*unbound)([[:space:]]|$)' | grep -v grep >/dev/null 2>&1; }
wait_for_amtm_entware_startup() {
    elapsed=0; quiet_seconds=0; unbound_stable_seconds=0
    while [ "$elapsed" -lt "$EDGE_ENTWARE_START_WAIT_SECONDS" ]; do
        ntp_ready=1
        if executable_exists nvram >/dev/null 2>&1; then [ "$(nvram get ntp_ready 2>/dev/null)" = "1" ] || ntp_ready=0; fi
        if pidof unbound >/dev/null 2>&1; then
            quiet_seconds=0; unbound_stable_seconds=$((unbound_stable_seconds + 1)); [ "$unbound_stable_seconds" -ge "$EDGE_SERVICE_STABILITY_SECONDS" ] && return 0
        elif external_entware_start_running || [ "$ntp_ready" != "1" ]; then quiet_seconds=0; unbound_stable_seconds=0
        else unbound_stable_seconds=0; quiet_seconds=$((quiet_seconds + 1)); [ "$quiet_seconds" -ge "$EDGE_ENTWARE_QUIET_SECONDS" ] && return 0
        fi
        elapsed=$((elapsed + 1)); sleep 1
    done
    return 1
}
if amtm_entware_startup_detected; then
    if wait_for_amtm_entware_startup; then log "amtm Entware startup settled"; else log "WARNING: amtm Entware startup did not settle after ${EDGE_ENTWARE_START_WAIT_SECONDS}s"; fi
fi
if [ "$EDGE_RUN_RC_UNSLUNG" = "1" ] && [ -x /opt/etc/init.d/rc.unslung ]; then /opt/etc/init.d/rc.unslung start >/tmp/asus-edge-entware-start.log 2>&1 || log "WARNING: Entware startup returned non-zero"; fi
mkdir -p /opt/var/lib/unbound

startup_failed=0
if [ -x "$EDGE_TAILSCALE_HELPER" ]; then
    if "$EDGE_TAILSCALE_HELPER" ensure; then
        log "Tailscale daemon and policy reconciled"
    else
        log "ERROR: Tailscale reconciliation failed"
        startup_failed=1
    fi
else
    log "ERROR: required Tailscale reconciliation helper missing: $EDGE_TAILSCALE_HELPER"
    startup_failed=1
fi

remove_stale_process_pidfile() {
    stale_process_name="$1"; stale_pidfile="$2"
    [ -n "$stale_pidfile" ] || return 0
    [ ! -L "$stale_pidfile" ] || { log "ERROR: refusing symlink pidfile: $stale_pidfile"; return 1; }
    [ -f "$stale_pidfile" ] || return 0
    pidof "$stale_process_name" >/dev/null 2>&1 && return 0
    rm -f "$stale_pidfile" || return 1
    log "removed stale $stale_process_name pidfile $stale_pidfile"
}
resolve_unbound_config() {
    if [ -n "$EDGE_UNBOUND_CONFIG" ] && [ -r "$EDGE_UNBOUND_CONFIG" ]; then printf '%s\n' "$EDGE_UNBOUND_CONFIG"; return 0; fi
    for unbound_config_candidate in /opt/var/lib/unbound/unbound.conf /opt/etc/unbound/unbound.conf; do
        [ -r "$unbound_config_candidate" ] && { printf '%s\n' "$unbound_config_candidate"; return 0; }
    done
    return 1
}

unbound_control_ready() {
    executable_exists unbound-control >/dev/null 2>&1 || return 0
    unbound_config="$(resolve_unbound_config)" || return 1
    LD_LIBRARY_PATH="$EDGE_ENTWARE_LD_LIBRARY_PATH" unbound-control -c "$unbound_config" status >/dev/null 2>&1
}

unbound_query_ready() {
    executable_exists dig >/dev/null 2>&1 || return 0
    dig +time=2 +tries=1 +noall +comments -p "$EDGE_UNBOUND_PORT" @127.0.0.1 localhost. A 2>/dev/null |
        grep -q 'status: NOERROR'
}

unbound_ready() {
    pidof unbound >/dev/null 2>&1 || return 1
    netstat -ln 2>/dev/null |
        grep -q "127\.0\.0\.1:${EDGE_UNBOUND_PORT}[[:space:]]" || return 1
    unbound_control_ready || return 1
    unbound_query_ready || return 1
    return 0
}

wait_for_unbound_ready() {
    elapsed=0
    while [ "$elapsed" -lt "$EDGE_UNBOUND_READY_WAIT_SECONDS" ]; do
        unbound_ready && return 0
        elapsed=$((elapsed + 1))
        sleep 1
    done
    return 1
}
start_unbound_direct_if_stopped() {
    unbound_log=/tmp/asus-edge-unbound-start.log
    if pidof unbound >/dev/null 2>&1; then
        if process_stays_running unbound && wait_for_unbound_ready; then
            log "unbound already running and functionally ready; preserving current process"
            return 0
        fi
        log "WARNING: unbound process is not functionally ready; attempting direct recovery"
    fi
    [ -x "$EDGE_UNBOUND_BIN" ] || { log "ERROR: Unbound binary is not executable: $EDGE_UNBOUND_BIN"; return 1; }
    unbound_config="$(resolve_unbound_config)" || { log "ERROR: no readable Unbound configuration found"; return 1; }
    : >"$unbound_log"
    if executable_exists unbound-checkconf >/dev/null 2>&1; then
        if ! LD_LIBRARY_PATH="$EDGE_ENTWARE_LD_LIBRARY_PATH" unbound-checkconf "$unbound_config" >>"$unbound_log" 2>&1; then log "ERROR: Unbound configuration validation failed; inspect $unbound_log"; return 1; fi
    fi
    attempt=1
    while [ "$attempt" -le "$EDGE_SERVICE_START_ATTEMPTS" ]; do
        remove_stale_process_pidfile unbound "$EDGE_UNBOUND_PIDFILE" || log "WARNING: could not remove stale pidfile $EDGE_UNBOUND_PIDFILE"
        printf 'Attempt %s/%s: %s -c %s\n' "$attempt" "$EDGE_SERVICE_START_ATTEMPTS" "$EDGE_UNBOUND_BIN" "$unbound_config" >>"$unbound_log"
        LD_LIBRARY_PATH="$EDGE_ENTWARE_LD_LIBRARY_PATH" "$EDGE_UNBOUND_BIN" -c "$unbound_config" >>"$unbound_log" 2>&1
        unbound_start_rc=$?; printf 'Launcher exit status: %s\n' "$unbound_start_rc" >>"$unbound_log"
        if process_stays_running unbound && wait_for_unbound_ready; then
            log "unbound recovered and passed functional readiness on attempt $attempt"
            if service restart_dnsmasq >/dev/null 2>&1; then
                log "dnsmasq restarted after unbound recovery"
            else
                log "ERROR: failed to restart dnsmasq after unbound recovery"
                return 1
            fi
            return 0
        fi
        attempt=$((attempt + 1)); [ "$attempt" -le "$EDGE_SERVICE_START_ATTEMPTS" ] && sleep "$EDGE_SERVICE_RETRY_SECONDS"
    done
    log "ERROR: failed to stabilize unbound; inspect $unbound_log"; return 1
}
start_entware_service_if_stopped() {
    process_name="$1"; service_log="$2"; process_pidfile="$3"; shift 3
    if pidof "$process_name" >/dev/null 2>&1; then process_stays_running "$process_name" && { log "$process_name already running and stable; preserving current process"; return 0; }; log "WARNING: $process_name exited during startup; attempting recovery"; fi
    service_found=0
    for service_path in "$@"; do
        [ -x "$service_path" ] || continue; service_found=1; : >"$service_log"; attempt=1
        while [ "$attempt" -le "$EDGE_SERVICE_START_ATTEMPTS" ]; do
            remove_stale_process_pidfile "$process_name" "$process_pidfile" || log "WARNING: could not remove stale pidfile $process_pidfile"
            printf 'Attempt %s/%s: %s start\n' "$attempt" "$EDGE_SERVICE_START_ATTEMPTS" "$service_path" >>"$service_log"
            "$service_path" start >>"$service_log" 2>&1 || true
            if process_stays_running "$process_name"; then log "$process_name started via $service_path on attempt $attempt"; return 0; fi
            attempt=$((attempt + 1)); [ "$attempt" -le "$EDGE_SERVICE_START_ATTEMPTS" ] && sleep "$EDGE_SERVICE_RETRY_SECONDS"
        done
        log "WARNING: failed to stabilize $process_name; inspect $service_log"; return 1
    done
    [ "$service_found" -eq 1 ] || log "WARNING: no executable init script found for $process_name"; return 1
}

start_unbound_direct_if_stopped || startup_failed=1
start_entware_service_if_stopped syslog-ng /tmp/asus-edge-syslog-ng-start.log "" /opt/etc/init.d/S*syslog-ng || log "WARNING: optional syslog-ng service unavailable"
if [ -x /jffs/scripts/firewall-start ]; then
    /jffs/scripts/firewall-start || { log "ERROR: firewall policy failed"; startup_failed=1; }
else
    log "ERROR: required managed firewall hook is missing or not executable: /jffs/scripts/firewall-start"
    startup_failed=1
fi
if [ "$startup_failed" -ne 0 ]; then log "ERROR: required service startup failed"; exit 1; fi
log "services startup completed"
exit 0