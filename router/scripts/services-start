#!/bin/sh
# shellcheck shell=dash

PATH="/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Resolve executables directly because older Asuswrt-Merlin BusyBox shells may
# not implement "command -v". Keep this helper local so each script is standalone.
executable_exists() {
    executable_name="$1"
    case "$executable_name" in
        */*)
            [ -x "$executable_name" ]
            return
            ;;
    esac

    for executable_dir in /opt/sbin /opt/bin /usr/sbin /usr/bin /sbin /bin; do
        [ -x "$executable_dir/$executable_name" ] && return 0
    done
    return 1
}

CONFIG_FILE="${EDGE_CONFIG_FILE:-/jffs/configs/asus-edge.conf}"
LOCK_DIR="/var/run/asus-edge-services.lock"

log() {
    logger -t asus-edge "$*"
}

[ -r "$CONFIG_FILE" ] || { log "ERROR: missing $CONFIG_FILE"; exit 1; }
# shellcheck disable=SC1090
. "$CONFIG_FILE"

: "${EDGE_OPT_WAIT_SECONDS:=90}"
: "${EDGE_RUN_RC_UNSLUNG:=0}"
: "${EDGE_ENTWARE_START_WAIT_SECONDS:=330}"
: "${EDGE_ENTWARE_QUIET_SECONDS:=20}"
: "${EDGE_SERVICE_STABILITY_SECONDS:=5}"
: "${EDGE_SERVICE_START_ATTEMPTS:=6}"
: "${EDGE_SERVICE_RETRY_SECONDS:=5}"
: "${EDGE_UNBOUND_PIDFILE:=/opt/var/run/unbound.pid}"
: "${EDGE_UNBOUND_BIN:=/opt/sbin/unbound}"
: "${EDGE_UNBOUND_CONFIG:=}"
: "${EDGE_TS_SOCKET:=/var/run/tailscale/tailscaled.sock}"
: "${EDGE_TS_STATE:=/opt/var/lib/tailscale/tailscaled.state}"
: "${EDGE_ADVERTISE_ROUTES:=}"
: "${EDGE_ENABLE_EXIT_NODE:=0}"
: "${EDGE_ACCEPT_DNS:=false}"
: "${EDGE_HOSTNAME:=asus-edge-gateway}"

opt_is_ready() {
    [ -d /opt ] || return 1
    [ -x /opt/bin/opkg ] || [ -x /opt/sbin/opkg ]
}

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    log "services-start already running; exiting"
    exit 0
fi
trap 'rmdir "$LOCK_DIR" 2>/dev/null' EXIT HUP INT TERM

elapsed=0
while ! opt_is_ready 2>/dev/null; do
    elapsed=$((elapsed + 1))
    if [ "$elapsed" -ge "$EDGE_OPT_WAIT_SECONDS" ]; then
        log "ERROR: Entware /opt not ready after ${EDGE_OPT_WAIT_SECONDS}s"
        exit 1
    fi
    sleep 1
done

amtm_entware_startup_detected() {
    [ -r /jffs/scripts/post-mount ] &&
        grep -F '/jffs/addons/amtm/mount-entware.mod' /jffs/scripts/post-mount >/dev/null 2>&1
}

external_entware_start_running() {
    ps w 2>/dev/null |
        grep -E '[/](rc\.unslung|S[0-9][0-9]*unbound)([[:space:]]|$)' |
        grep -v grep >/dev/null 2>&1
}

wait_for_amtm_entware_startup() {
    elapsed=0
    quiet_seconds=0
    unbound_stable_seconds=0

    while [ "$elapsed" -lt "$EDGE_ENTWARE_START_WAIT_SECONDS" ]; do
        ntp_ready=1
        if executable_exists nvram >/dev/null 2>&1; then
            [ "$(nvram get ntp_ready 2>/dev/null)" = "1" ] || ntp_ready=0
        fi

        if pidof unbound >/dev/null 2>&1; then
            quiet_seconds=0
            unbound_stable_seconds=$((unbound_stable_seconds + 1))
            [ "$unbound_stable_seconds" -ge "$EDGE_SERVICE_STABILITY_SECONDS" ] && return 0
        elif external_entware_start_running || [ "$ntp_ready" != "1" ]; then
            quiet_seconds=0
            unbound_stable_seconds=0
        else
            unbound_stable_seconds=0
            quiet_seconds=$((quiet_seconds + 1))
            [ "$quiet_seconds" -ge "$EDGE_ENTWARE_QUIET_SECONDS" ] && return 0
        fi

        elapsed=$((elapsed + 1))
        sleep 1
    done

    return 1
}

if amtm_entware_startup_detected; then
    if wait_for_amtm_entware_startup; then
        log "amtm Entware startup settled"
    else
        log "WARNING: amtm Entware startup did not settle after ${EDGE_ENTWARE_START_WAIT_SECONDS}s"
    fi
fi

if [ "$EDGE_RUN_RC_UNSLUNG" = "1" ] && [ -x /opt/etc/init.d/rc.unslung ]; then
    /opt/etc/init.d/rc.unslung start >/tmp/asus-edge-entware-start.log 2>&1 ||
        log "WARNING: Entware startup returned non-zero"
fi

mkdir -p /opt/var/lib/unbound

if executable_exists tailscaled >/dev/null 2>&1; then
    if ! pidof tailscaled >/dev/null 2>&1; then
        mkdir -p "$(dirname "$EDGE_TS_STATE")" "$(dirname "$EDGE_TS_SOCKET")"
        tailscaled \
            --state="$EDGE_TS_STATE" \
            --socket="$EDGE_TS_SOCKET" \
            >/opt/var/log/tailscaled.log 2>&1 &
        sleep 3
    fi

    if tailscale --socket="$EDGE_TS_SOCKET" status >/dev/null 2>&1; then
        set -- tailscale --socket="$EDGE_TS_SOCKET" up --accept-dns="$EDGE_ACCEPT_DNS" --hostname="$EDGE_HOSTNAME"
        [ -n "$EDGE_ADVERTISE_ROUTES" ] && set -- "$@" --advertise-routes="$EDGE_ADVERTISE_ROUTES"
        [ "$EDGE_ENABLE_EXIT_NODE" = "1" ] && set -- "$@" --advertise-exit-node
        "$@" >/tmp/asus-edge-tailscale-up.log 2>&1 || log "WARNING: tailscale up failed; inspect /tmp/asus-edge-tailscale-up.log"
    else
        log "WARNING: Tailscale is not authenticated; run tailscale up interactively once"
    fi
else
    log "WARNING: tailscaled not installed"
fi

process_stays_running() {
    monitored_process="$1"
    stable_seconds=0

    while [ "$stable_seconds" -lt "$EDGE_SERVICE_STABILITY_SECONDS" ]; do
        pidof "$monitored_process" >/dev/null 2>&1 || return 1
        stable_seconds=$((stable_seconds + 1))
        sleep 1
    done

    return 0
}

remove_stale_process_pidfile() {
    stale_process_name="$1"
    stale_pidfile="$2"

    [ -n "$stale_pidfile" ] || return 0
    [ -f "$stale_pidfile" ] || return 0
    pidof "$stale_process_name" >/dev/null 2>&1 && return 0

    rm -f "$stale_pidfile" || return 1
    log "removed stale $stale_process_name pidfile $stale_pidfile"
}

resolve_unbound_config() {
    if [ -n "$EDGE_UNBOUND_CONFIG" ] && [ -r "$EDGE_UNBOUND_CONFIG" ]; then
        printf '%s\n' "$EDGE_UNBOUND_CONFIG"
        return 0
    fi

    for unbound_config_candidate in \
        /opt/var/lib/unbound/unbound.conf \
        /opt/etc/unbound/unbound.conf
    do
        if [ -r "$unbound_config_candidate" ]; then
            printf '%s\n' "$unbound_config_candidate"
            return 0
        fi
    done

    return 1
}

start_unbound_direct_if_stopped() {
    unbound_log=/tmp/asus-edge-unbound-start.log

    if pidof unbound >/dev/null 2>&1; then
        if process_stays_running unbound; then
            log "unbound already running and stable; preserving current process"
            return 0
        fi
        log "WARNING: unbound exited during startup; attempting direct recovery"
    fi

    [ -x "$EDGE_UNBOUND_BIN" ] || {
        log "ERROR: Unbound binary is not executable: $EDGE_UNBOUND_BIN"
        return 1
    }

    unbound_config="$(resolve_unbound_config)" || {
        log "ERROR: no readable Unbound configuration found"
        return 1
    }

    : >"$unbound_log"
    if executable_exists unbound-checkconf >/dev/null 2>&1; then
        if ! unbound-checkconf "$unbound_config" >>"$unbound_log" 2>&1; then
            log "ERROR: Unbound configuration validation failed; inspect $unbound_log"
            return 1
        fi
    fi

    attempt=1
    while [ "$attempt" -le "$EDGE_SERVICE_START_ATTEMPTS" ]; do
        remove_stale_process_pidfile unbound "$EDGE_UNBOUND_PIDFILE" || {
            log "WARNING: could not remove stale pidfile $EDGE_UNBOUND_PIDFILE"
        }
        printf 'Attempt %s/%s: %s -c %s\n' \
            "$attempt" "$EDGE_SERVICE_START_ATTEMPTS" \
            "$EDGE_UNBOUND_BIN" "$unbound_config" >>"$unbound_log"

        "$EDGE_UNBOUND_BIN" -c "$unbound_config" >>"$unbound_log" 2>&1
        unbound_start_rc=$?
        printf 'Launcher exit status: %s\n' "$unbound_start_rc" >>"$unbound_log"

        if process_stays_running unbound; then
            log "unbound recovered directly on attempt $attempt"
            return 0
        fi

        attempt=$((attempt + 1))
        [ "$attempt" -le "$EDGE_SERVICE_START_ATTEMPTS" ] &&
            sleep "$EDGE_SERVICE_RETRY_SECONDS"
    done

    log "ERROR: failed to stabilize unbound; inspect $unbound_log"
    return 1
}

start_entware_service_if_stopped() {
    process_name="$1"
    service_log="$2"
    process_pidfile="$3"
    shift 3

    if pidof "$process_name" >/dev/null 2>&1; then
        if process_stays_running "$process_name"; then
            log "$process_name already running and stable; preserving current process"
            return 0
        fi
        log "WARNING: $process_name exited during startup; attempting recovery"
    fi

    service_found=0
    for service_path in "$@"; do
        [ -x "$service_path" ] || continue
        service_found=1
        : >"$service_log"
        attempt=1
        while [ "$attempt" -le "$EDGE_SERVICE_START_ATTEMPTS" ]; do
            remove_stale_process_pidfile "$process_name" "$process_pidfile" || {
                log "WARNING: could not remove stale pidfile $process_pidfile"
            }
            printf 'Attempt %s/%s: %s start\n' \
                "$attempt" "$EDGE_SERVICE_START_ATTEMPTS" "$service_path" >>"$service_log"
            "$service_path" start >>"$service_log" 2>&1 || true
            if process_stays_running "$process_name"; then
                log "$process_name started via $service_path on attempt $attempt"
                return 0
            fi
            attempt=$((attempt + 1))
            [ "$attempt" -le "$EDGE_SERVICE_START_ATTEMPTS" ] &&
                sleep "$EDGE_SERVICE_RETRY_SECONDS"
        done
        log "WARNING: failed to stabilize $process_name; inspect $service_log"
        return 1
    done

    [ "$service_found" -eq 1 ] ||
        log "WARNING: no executable init script found for $process_name"
    return 1
}

# amtm normally starts Entware daemons from post-mount. Preserve its stable
# Unbound process. Recovery invokes the daemon directly so the third-party
# S61unbound POSTCMD cannot restart dnsmasq after every failed launch.
startup_failed=0
start_unbound_direct_if_stopped || startup_failed=1

start_entware_service_if_stopped \
    syslog-ng /tmp/asus-edge-syslog-ng-start.log "" \
    /opt/etc/init.d/S*syslog-ng ||
    log "WARNING: optional syslog-ng service unavailable"

if [ -x /jffs/scripts/firewall-start ]; then
    /jffs/scripts/firewall-start || {
        log "ERROR: firewall policy failed"
        startup_failed=1
    }
fi

if [ "$startup_failed" -ne 0 ]; then
    log "ERROR: required service startup failed"
    exit 1
fi

log "services startup completed"
exit 0
