#!/bin/sh
# shellcheck shell=dash
# Project-native ASUSWRT-Merlin WebUI mount helper.
# Phase 1 mounts/unmounts a read-only page only; it does not touch DNS/services.

set -eu

PATH="/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin"

WEBUI_SOURCE="${EDGE_WEBUI_SOURCE:-/jffs/addons/asus-edge/webui/EdgeGateway.asp}"
WEBUI_TITLE="Edge Gateway"
MENU_INDEX="menu_Dashboard"
MENU_BEGIN_MARKER="/* ASUS-EDGE-MENU-BEGIN */"
MENU_END_MARKER="/* ASUS-EDGE-MENU-END */"
PL_WEBUI_HELPER="/jffs/addons/asus-edge/bin/webui-pl-mount"
MENU_ORIGINAL="/www/require/modules/menuTree.js"
MENU_TMP="/tmp/menuTree.js"
LOCKFILE="/tmp/addonwebui.lock"
STATE_FILE="/tmp/asus-edge-webui.page"
STATUS_DIR="/www/ext/asus-edge"
STATUS_FILE="$STATUS_DIR/status.js"
STATUS_TMP="$STATUS_DIR/status.js.tmp"
STATUS_CRON_ID="AsusEdgeWebUIStatus"

[ -r /usr/sbin/helper.sh ] || {
    echo "ERROR: Merlin helper API is unavailable" >&2
    exit 1
}
# shellcheck disable=SC1091
. /usr/sbin/helper.sh

addon_supported() {
    nvram get rc_support 2>/dev/null | tr ' ' '\n' | grep -F -x 'am_addons' >/dev/null 2>&1
}

remount_menu_tree() {
    umount "$MENU_ORIGINAL" 2>/dev/null || true
    mount -o bind "$MENU_TMP" "$MENU_ORIGINAL"
}

mount_polish_overlay() {
    [ -x "$PL_WEBUI_HELPER" ] || {
        echo "WARNING: Polish WebUI helper unavailable: $PL_WEBUI_HELPER" >&2
        return 0
    }

    if "$PL_WEBUI_HELPER" mount >/tmp/asus-edge-webui-pl-mount.log 2>&1; then
        echo "Polish WebUI overlay active"
    else
        echo "WARNING: Polish WebUI overlay failed; inspect /tmp/asus-edge-webui-pl-mount.log" >&2
    fi

    return 0
}

unmount_polish_overlay() {
    [ -x "$PL_WEBUI_HELPER" ] || return 0

    if "$PL_WEBUI_HELPER" unmount >/tmp/asus-edge-webui-pl-unmount.log 2>&1; then
        echo "Polish WebUI overlay inactive"
    else
        echo "ERROR: Polish WebUI overlay unmount failed; inspect /tmp/asus-edge-webui-pl-unmount.log" >&2
        return 1
    fi
}


mount_webui() {
    addon_supported || {
        echo "ERROR: firmware does not advertise am_addons support" >&2
        exit 1
    }
    [ -f "$WEBUI_SOURCE" ] || {
        echo "ERROR: missing WebUI source: $WEBUI_SOURCE" >&2
        exit 1
    }
    [ -f "$MENU_ORIGINAL" ] || {
        echo "ERROR: missing menu tree: $MENU_ORIGINAL" >&2
        exit 1
    }

    exec 9>"$LOCKFILE"
    flock -x 9

    am_webui_page="none"
    am_get_webui_page "$WEBUI_SOURCE"
    [ "$am_webui_page" != "none" ] || {
        echo "ERROR: no free Merlin addon WebUI page" >&2
        exit 1
    }

    cp "$WEBUI_SOURCE" "/www/user/$am_webui_page"
    chmod 0644 "/www/user/$am_webui_page"

    if [ ! -f "$MENU_TMP" ]; then
        cp "$MENU_ORIGINAL" "$MENU_TMP"
    fi

    menu_stage="/tmp/asus-edge-menu-build.$$"
    menu_clean="/tmp/asus-edge-menu-clean.$$"
    rm -f "$menu_stage" "$menu_clean"

    # Remove either the legacy Administration tab or a previous project-owned
    # standalone block before rebuilding the menu entry idempotently.
    sed \
        -e '/ASUS-EDGE-MENU-BEGIN/,/ASUS-EDGE-MENU-END/d' \
        -e "\~tabName: \"$WEBUI_TITLE\"},~d" \
        "$MENU_TMP" >"$menu_clean" || {
            rm -f "$menu_stage" "$menu_clean" "/www/user/$am_webui_page"
            echo "ERROR: failed to prepare Edge Gateway menu base" >&2
            exit 1
        }

    # The stock firmware already provides CSS for menu_Dashboard but no menu
    # object uses that index. Fail closed if a future firmware starts using it.
    if grep -F "index: \"$MENU_INDEX\"" "$menu_clean" >/dev/null 2>&1; then
        rm -f "$menu_stage" "$menu_clean" "/www/user/$am_webui_page"
        echo "ERROR: reserved menu index already in use: $MENU_INDEX" >&2
        exit 1
    fi

    awk \
        -v page="$am_webui_page" \
        -v title="$WEBUI_TITLE" \
        -v menu_index="$MENU_INDEX" \
        -v begin="$MENU_BEGIN_MARKER" \
        -v end="$MENU_END_MARKER" '
        BEGIN {
            pending = ""
            inserted = 0
        }
        {
            if (pending != "") {
                if ($0 ~ /^menuName: "<#519#>",[[:space:]]*$/) {
                    print begin
                    print "{"
                    print "menuName: \"" title "\","
                    print "index: \"" menu_index "\","
                    print "tab: ["
                    print "{url: \"" page "\", tabName: \"" title "\"},"
                    print "{url: \"NULL\", tabName: \"__INHERIT__\"}"
                    print "]"
                    print "},"
                    print end
                    print pending
                    print $0
                    pending = ""
                    inserted++
                    next
                }
                print pending
                pending = ""
            }

            if ($0 ~ /^[[:space:]]*\{[[:space:]]*$/) {
                pending = $0
                next
            }

            print
        }
        END {
            if (pending != "")
                print pending
            if (inserted != 1)
                exit 42
        }
        ' "$menu_clean" >"$menu_stage" || {
            rm -f "$menu_stage" "$menu_clean" "/www/user/$am_webui_page"
            echo "ERROR: Administration menu anchor not found exactly once" >&2
            exit 1
        }
    rm -f "$menu_clean"

    edge_index_count="$(grep -F -c "index: \"$MENU_INDEX\"" "$menu_stage" || true)"
    edge_title_count="$(grep -F -c "tabName: \"$WEBUI_TITLE\"" "$menu_stage" || true)"
    edge_begin_count="$(grep -F -c "$MENU_BEGIN_MARKER" "$menu_stage" || true)"
    edge_end_count="$(grep -F -c "$MENU_END_MARKER" "$menu_stage" || true)"

    [ "$edge_index_count" = "1" ] &&
    [ "$edge_title_count" = "1" ] &&
    [ "$edge_begin_count" = "1" ] &&
    [ "$edge_end_count" = "1" ] || {
        rm -f "$menu_stage" "/www/user/$am_webui_page"
        echo "ERROR: Edge Gateway standalone menu validation failed" >&2
        exit 1
    }

    awk -v menu_index="$MENU_INDEX" '
        $0 ~ "index: \"" menu_index "\"" { edge = NR }
        $0 ~ /index: "menu_Setting"/ { settings = NR }
        END { exit !(edge > 0 && settings > edge) }
    ' "$menu_stage" || {
        rm -f "$menu_stage" "/www/user/$am_webui_page"
        echo "ERROR: Edge Gateway menu is not positioned before Administration" >&2
        exit 1
    }

    # Preserve the inode because menuTree.js may already be bind-mounted.
    cat "$menu_stage" >"$MENU_TMP"
    rm -f "$menu_stage"

    remount_menu_tree
    printf '%s\n' "$am_webui_page" >"$STATE_FILE"

    mount_polish_overlay

    echo "Mounted $WEBUI_TITLE as $am_webui_page"
    echo "URL: /$am_webui_page"
}

unmount_webui() {
    exec 9>"$LOCKFILE"
    flock -x 9

    unmount_polish_overlay || return 1

    page=""
    if [ -r "$STATE_FILE" ]; then
        read -r page <"$STATE_FILE" || true
    fi

    if [ -z "$page" ] && [ -f "$WEBUI_SOURCE" ]; then
        am_webui_page="none"
        am_get_webui_page "$WEBUI_SOURCE"
        [ "$am_webui_page" = "none" ] || page="$am_webui_page"
    fi

    if [ -n "$page" ] && [ -f "/www/user/$page" ]; then
        rm -f "/www/user/$page"
    fi
    rm -f "$STATE_FILE"

    if [ -x /usr/sbin/cru ]; then
        /usr/sbin/cru d "$STATUS_CRON_ID" >/dev/null 2>&1 || true
    fi
    rm -f "$STATUS_FILE" "$STATUS_TMP"
    rmdir "$STATUS_DIR" 2>/dev/null || true

    if [ -f "$MENU_TMP" ]; then
        menu_stage="/tmp/asus-edge-menu-unmount.$$"
        sed \
            -e '/ASUS-EDGE-MENU-BEGIN/,/ASUS-EDGE-MENU-END/d' \
            -e "\~tabName: \"$WEBUI_TITLE\"},~d" \
            "$MENU_TMP" >"$menu_stage" || {
                rm -f "$menu_stage"
                echo "ERROR: failed to remove Edge Gateway menu entry" >&2
                return 1
            }
        cat "$menu_stage" >"$MENU_TMP"
        rm -f "$menu_stage"

        umount "$MENU_ORIGINAL" 2>/dev/null || true
        if cmp -s "$MENU_TMP" "$MENU_ORIGINAL"; then
            rm -f "$MENU_TMP"
        else
            mount -o bind "$MENU_TMP" "$MENU_ORIGINAL"
        fi
    fi

    echo "Unmounted $WEBUI_TITLE"
}

status_webui() {
    if [ -r "$STATE_FILE" ]; then
        read -r page <"$STATE_FILE" || true
        printf 'page=%s\n' "${page:-unknown}"
    else
        echo "page=untracked"
    fi
    grep -F "tabName: \"$WEBUI_TITLE\"" "$MENU_TMP" 2>/dev/null || true
    mount | grep -F "$MENU_ORIGINAL" || true
}

case "${1:-}" in
    mount) mount_webui ;;
    unmount) unmount_webui ;;
    status) status_webui ;;
    *)
        echo "Usage: $0 {mount|unmount|status}" >&2
        exit 2
        ;;
esac
