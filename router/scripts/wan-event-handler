#!/bin/sh
# shellcheck shell=dash

BASE_PATH="/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin"

if [ -n "${EDGE_TEST_PATH_PREFIX:-}" ]; then
    PATH="${EDGE_TEST_PATH_PREFIX}:${BASE_PATH}"
else
    PATH="$BASE_PATH"
fi
export PATH

CONFIG_FILE="${EDGE_CONFIG_FILE:-/jffs/configs/asus-edge.conf}"
RESOLV_CONF="${EDGE_RESOLV_CONF:-/tmp/resolv.conf}"
TAILSCALE_HELPER="${EDGE_TAILSCALE_HELPER:-/jffs/addons/asus-edge/bin/tailscale-reconcile}"

log() {
    logger -t asus-edge "$*"
}

[ -r "$CONFIG_FILE" ] || {
    log "ERROR: missing $CONFIG_FILE"
    exit 1
}

# shellcheck disable=SC1090
. "$CONFIG_FILE"

: "${EDGE_UNBOUND_PORT:=53535}"
: "${EDGE_TS_SOCKET:=/var/run/tailscale/tailscaled.sock}"
: "${EDGE_WAN_DNS_WAIT_SECONDS:=90}"
: "${EDGE_TAILSCALE_WAIT_SECONDS:=20}"
: "${EDGE_ENTWARE_LD_LIBRARY_PATH:=/opt/lib:/opt/usr/lib}"

validate_positive_integer() {
    value_name="$1"
    value="$2"

    case "$value" in
        ''|*[!0-9]*)
            log "ERROR: $value_name must be a positive integer"
            return 1
            ;;
    esac

    [ "$value" -gt 0 ] || {
        log "ERROR: $value_name must be greater than zero"
        return 1
    }
}

validate_positive_integer EDGE_WAN_DNS_WAIT_SECONDS "$EDGE_WAN_DNS_WAIT_SECONDS" || exit 1
validate_positive_integer EDGE_TAILSCALE_WAIT_SECONDS "$EDGE_TAILSCALE_WAIT_SECONDS" || exit 1

case "$EDGE_UNBOUND_PORT" in
    ''|*[!0-9]*)
        log "ERROR: EDGE_UNBOUND_PORT must be an integer between 1 and 65535"
        exit 1
        ;;
esac
if [ "$EDGE_UNBOUND_PORT" -lt 1 ] || [ "$EDGE_UNBOUND_PORT" -gt 65535 ]; then
    log "ERROR: EDGE_UNBOUND_PORT must be between 1 and 65535"
    exit 1
fi

executable_exists() {
    executable_name="$1"
    case "$executable_name" in
        */*) [ -x "$executable_name" ]; return ;;
    esac
    for executable_dir in /opt/sbin /opt/bin /usr/sbin /usr/bin /sbin /bin; do
        [ -x "$executable_dir/$executable_name" ] && return 0
    done
    return 1
}

dns_path_ready() {
    pidof dnsmasq >/dev/null 2>&1 || return 1
    pidof unbound >/dev/null 2>&1 || return 1

    netstat -ln 2>/dev/null |
        grep -q "127\.0\.0\.1:${EDGE_UNBOUND_PORT}[[:space:]]" ||
        return 1

    if executable_exists dig >/dev/null 2>&1; then
        dig +time=2 +tries=1 +noall +comments -p "$EDGE_UNBOUND_PORT" @127.0.0.1 localhost. A 2>/dev/null |
            grep -q 'status: NOERROR' || return 1
    fi

    return 0
}

wait_for_dns_path() {
    elapsed=0

    while [ "$elapsed" -lt "$EDGE_WAN_DNS_WAIT_SECONDS" ]; do
        dns_path_ready && return 0

        elapsed=$((elapsed + 1))
        sleep 1
    done

    return 1
}

enforce_system_resolver() {
    [ -f "$RESOLV_CONF" ] || {
        log "ERROR: missing $RESOLV_CONF"
        return 1
    }
    [ ! -L "$RESOLV_CONF" ] || {
        log "ERROR: refusing symlink resolver path: $RESOLV_CONF"
        return 1
    }

    case "$RESOLV_CONF" in
        /*) ;;
        *) log "ERROR: resolver path must be absolute"; return 1 ;;
    esac
    if [ -z "${EDGE_TEST_PATH_PREFIX:-}" ] && [ "$RESOLV_CONF" != "/tmp/resolv.conf" ]; then
        log "ERROR: refusing unexpected production resolver path: $RESOLV_CONF"
        return 1
    fi

    if [ "$(cat "$RESOLV_CONF" 2>/dev/null)" = "nameserver 127.0.0.1" ]; then
        log "system resolver already points to 127.0.0.1"
        return 0
    fi

    resolv_tmp="${RESOLV_CONF}.asus-edge.$"
    [ ! -L "$resolv_tmp" ] || {
        log "ERROR: refusing symlink temporary resolver path: $resolv_tmp"
        return 1
    }
    umask 022
    printf 'nameserver 127.0.0.1\n' >"$resolv_tmp" || {
        rm -f "$resolv_tmp" 2>/dev/null || true
        log "ERROR: failed to stage resolver update"
        return 1
    }
    chmod 0644 "$resolv_tmp" 2>/dev/null || true
    mv "$resolv_tmp" "$RESOLV_CONF" || {
        rm -f "$resolv_tmp" 2>/dev/null || true
        log "ERROR: failed to atomically update $RESOLV_CONF"
        return 1
    }

    log "system resolver enforced atomically: 127.0.0.1"
    return 0
}

restart_tailscaled() {
    [ -x "$TAILSCALE_HELPER" ] || {
        log "ERROR: Tailscale reconciliation helper not found"
        return 1
    }

    "$TAILSCALE_HELPER" restart >/dev/null 2>&1 || {
        log "ERROR: canonical Tailscale restart/reconciliation failed after WAN DNS update"
        return 1
    }

    elapsed=0
    while [ "$elapsed" -lt "$EDGE_TAILSCALE_WAIT_SECONDS" ]; do
        if pidof tailscaled >/dev/null 2>&1 &&
            tailscale --socket="$EDGE_TS_SOCKET" status >/dev/null 2>&1; then
            netfilter_mode="$(
                tailscale --socket="$EDGE_TS_SOCKET" debug prefs 2>/dev/null |
                    awk -F: '/"NetfilterMode"/ {
                        value=$2
                        gsub(/[[:space:],]/, "", value)
                        print value
                        exit
                    }'
            )"
            if [ "$netfilter_mode" = "0" ]; then
                log "tailscaled restarted with netfilter-mode=off after WAN DNS update"
                return 0
            fi
        fi

        elapsed=$((elapsed + 1))
        sleep 1
    done

    log "ERROR: tailscaled restart completed without verified netfilter-mode=off"
    return 1
}

if ! wait_for_dns_path; then
    log "ERROR: local DNS path not ready after WAN connected event"
    exit 1
fi

if ! enforce_system_resolver; then
    exit 1
fi

if ! restart_tailscaled; then
    exit 1
fi

exit 0
