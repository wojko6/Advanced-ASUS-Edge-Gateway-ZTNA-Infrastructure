#!/bin/sh
# shellcheck shell=dash
# ASUS Edge WAN-connected DNS policy handler.

BASE_PATH="/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin"

if [ -n "${EDGE_TEST_PATH_PREFIX:-}" ]; then
    PATH="${EDGE_TEST_PATH_PREFIX}:${BASE_PATH}"
else
    PATH="$BASE_PATH"
fi
export PATH

CONFIG_FILE="${EDGE_CONFIG_FILE:-/jffs/configs/asus-edge.conf}"
TAILSCALED_INIT="${EDGE_TAILSCALED_INIT:-/opt/etc/init.d/S06tailscaled}"
DNS_GUARD="${EDGE_DNS_GUARD:-/jffs/addons/asus-edge/bin/dns-guard}"

log() {
    logger -t asus-edge "$*"
}

[ -r "$CONFIG_FILE" ] || {
    log "ERROR: missing $CONFIG_FILE"
    exit 1
}

# shellcheck disable=SC1090
. "$CONFIG_FILE"

: "${EDGE_UNBOUND_PORT:=53535}"
: "${EDGE_TS_SOCKET:=/var/run/tailscale/tailscaled.sock}"
: "${EDGE_WAN_DNS_WAIT_SECONDS:=90}"
: "${EDGE_TAILSCALE_WAIT_SECONDS:=20}"

validate_positive_integer() {
    value_name="$1"
    value="$2"

    case "$value" in
        ''|*[!0-9]*)
            log "ERROR: $value_name must be a positive integer"
            return 1
            ;;
    esac

    [ "$value" -gt 0 ] || {
        log "ERROR: $value_name must be greater than zero"
        return 1
    }
}

validate_positive_integer     EDGE_WAN_DNS_WAIT_SECONDS     "$EDGE_WAN_DNS_WAIT_SECONDS" || exit 1

validate_positive_integer     EDGE_TAILSCALE_WAIT_SECONDS     "$EDGE_TAILSCALE_WAIT_SECONDS" || exit 1

case "$EDGE_UNBOUND_PORT" in
    ''|*[!0-9]*)
        log "ERROR: EDGE_UNBOUND_PORT must be an integer between 1 and 65535"
        exit 1
        ;;
esac

if [ "$EDGE_UNBOUND_PORT" -lt 1 ] ||
   [ "$EDGE_UNBOUND_PORT" -gt 65535 ]; then
    log "ERROR: EDGE_UNBOUND_PORT must be between 1 and 65535"
    exit 1
fi

dns_path_ready() {
    pidof dnsmasq >/dev/null 2>&1 || return 1
    pidof unbound >/dev/null 2>&1 || return 1

    netstat -ln 2>/dev/null |
        grep -q "127\\.0\\.0\\.1:${EDGE_UNBOUND_PORT}[[:space:]]" ||
        return 1

    return 0
}

wait_for_dns_path() {
    elapsed=0

    while [ "$elapsed" -lt "$EDGE_WAN_DNS_WAIT_SECONDS" ]; do
        dns_path_ready && return 0

        elapsed=$((elapsed + 1))
        sleep 1
    done

    return 1
}

apply_dns_policy() {
    phase="$1"

    [ -x "$DNS_GUARD" ] || {
        log "ERROR: DNS Guard not found or not executable: $DNS_GUARD"
        return 1
    }

    guard_output="$("$DNS_GUARD" auto 2>&1)"
    guard_rc=$?

    if [ "$guard_rc" -eq 0 ]; then
        log "DNS Guard policy applied during WAN ${phase} phase"
        return 0
    fi

    log "ERROR: DNS Guard policy failed during WAN ${phase} phase: $guard_output"
    return 1
}

restart_tailscaled() {
    [ -x "$TAILSCALED_INIT" ] || {
        log "ERROR: tailscaled init script not found"
        return 1
    }

    "$TAILSCALED_INIT" restart >/dev/null 2>&1 || {
        log "ERROR: failed to restart tailscaled after WAN DNS update"
        return 1
    }

    elapsed=0

    while [ "$elapsed" -lt "$EDGE_TAILSCALE_WAIT_SECONDS" ]; do
        if pidof tailscaled >/dev/null 2>&1 &&
           tailscale --socket="$EDGE_TS_SOCKET" status >/dev/null 2>&1; then
            log "tailscaled restarted after WAN DNS update"
            return 0
        fi

        elapsed=$((elapsed + 1))
        sleep 1
    done

    log "ERROR: tailscaled did not become ready after WAN DNS update"
    return 1
}

# Fail open immediately. If the local stack is not healthy yet,
# DNS Guard keeps or restores independent WAN DNS.
if ! apply_dns_policy initial; then
    exit 1
fi

# Give Entware/Unbound a bounded opportunity to become healthy.
# Failure here is not fatal because DNS Guard has already selected
# the safe bootstrap path.
if wait_for_dns_path; then
    apply_dns_policy settled ||
        log "WARNING: settled DNS Guard policy failed; bootstrap state preserved"
else
    log "WARNING: local DNS path not ready after ${EDGE_WAN_DNS_WAIT_SECONDS}s; keeping bootstrap DNS"
fi

if ! restart_tailscaled; then
    exit 1
fi

exit 0
