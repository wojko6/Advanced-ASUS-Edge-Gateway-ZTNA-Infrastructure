find_hash_backend() {
    # Firmware OpenSSL is available before Entware /opt is mounted.
    if [ -x /usr/sbin/openssl ]; then
        printf '%s\n' "openssl:/usr/sbin/openssl"
        return 0
    fi

    for candidate in /usr/bin/sha256sum /bin/sha256sum /opt/bin/sha256sum /opt/sbin/sha256sum; do
        if [ -x "$candidate" ]; then
            printf '%s\n' "sha256sum:$candidate"
            return 0
        fi
    done

    echo "ERROR: no SHA-256 backend available" >&2
    return 1
}

HASH_BACKEND="$(find_hash_backend)"

file_hash() {
    file="$1"

    case "$HASH_BACKEND" in
        openssl:*)
            openssl_bin="${HASH_BACKEND#openssl:}"
            "$openssl_bin" dgst -sha256 "$file" | awk '{print $NF}'
            ;;
        sha256sum:*)
            sha_bin="${HASH_BACKEND#sha256sum:}"
            "$sha_bin" "$file" | awk '{print $1}'
            ;;
        *)
            echo "ERROR: unsupported hash backend: $HASH_BACKEND" >&2
            return 1
            ;;
    esac
}

require_hash() {
    file="$1"
    expected="$2"
    label="$3"

    [ -f "$file" ] || {
        echo "ERROR: missing $label: $file" >&2
        return 1
    }

    actual="$(file_hash "$file")"
    [ "$actual" = "$expected" ] || {
        echo "ERROR: $label hash mismatch" >&2
        echo "EXPECTED=$expected" >&2
        echo "ACTUAL=$actual" >&2
        return 1
    }
}

mount_one() {
    source="$1"
    target="$2"
    base_sha="$3"
    patched_sha="$4"
    label="$5"

    require_hash "$source" "$patched_sha" "$label candidate" || return 1

    current="$(file_hash "$target")"

    if [ "$current" = "$patched_sha" ]; then
        echo "$label: already active"
        return 0
    fi

    if [ "$current" != "$base_sha" ]; then
        echo "ERROR: $label firmware baseline mismatch" >&2
        echo "EXPECTED_BASE=$base_sha" >&2
        echo "ACTIVE=$current" >&2
        return 1
    fi

    mount -o bind "$source" "$target" || return 1

    active="$(file_hash "$target")"
    [ "$active" = "$patched_sha" ] || {
        echo "ERROR: $label post-mount verification failed" >&2
        umount "$target" 2>/dev/null || true
        return 1
    }

    echo "$label: mounted"
}

localize_menu() {
    [ -f "$MENU_BASE" ] || {
        echo "ERROR: missing Merlin/project menu base: $MENU_BASE" >&2
        return 1
    }

    # If the active menu is already Polish, do nothing.
    if grep -F 'menuName: "Informacje o systemie",' "$MENU_TARGET" >/dev/null 2>&1 &&
       grep -F 'tabName: "Dostrajanie"' "$MENU_TARGET" >/dev/null 2>&1 &&
       grep -F 'tabName: "Edge Gateway"' "$MENU_TARGET" >/dev/null 2>&1; then
        echo "menuTree: already active"
        return 0
    fi

    sysinfo_count="$(grep -F -c 'menuName: "System Info",' "$MENU_BASE" || true)"
    tweaks_count="$(grep -F -c '{url: "Tools_OtherSettings.asp", tabName: "Tweaks"},' "$MENU_BASE" || true)"
    edge_count="$(grep -F -c 'tabName: "Edge Gateway"' "$MENU_BASE" || true)"

    [ "$sysinfo_count" = "1" ] || {
        echo "ERROR: unexpected System Info menu structure: $sysinfo_count" >&2
        return 1
    }

    [ "$tweaks_count" = "1" ] || {
        echo "ERROR: unexpected Tweaks menu structure: $tweaks_count" >&2
        return 1
    }

    [ "$edge_count" = "1" ] || {
        echo "ERROR: unexpected Edge Gateway menu structure: $edge_count" >&2
        return 1
    }

    build="/tmp/asus-edge-menu-pl-build.$$"

    sed \
        -e 's/menuName: "System Info",/menuName: "Informacje o systemie",/' \
        -e 's/{url: "Tools_OtherSettings.asp", tabName: "Tweaks"},/{url: "Tools_OtherSettings.asp", tabName: "Dostrajanie"},/' \
        "$MENU_BASE" >"$build" || {
            rm -f "$build"
            return 1
        }

    grep -F 'menuName: "Informacje o systemie",' "$build" >/dev/null || {
        rm -f "$build"
        return 1
    }
    grep -F 'tabName: "Dostrajanie"' "$build" >/dev/null || {
        rm -f "$build"
        return 1
    }
    grep -F 'tabName: "Edge Gateway"' "$build" >/dev/null || {
        rm -f "$build"
        return 1
    }

    # Important: overwrite the existing file contents instead of sed -i/rename.
    # /www/.../menuTree.js may already be bind-mounted to this inode.
    cat "$build" >"$MENU_BASE" || {
        rm -f "$build"
        return 1
    }
    rm -f "$build"

    if grep -F 'menuName: "Informacje o systemie",' "$MENU_TARGET" >/dev/null 2>&1 &&
       grep -F 'tabName: "Dostrajanie"' "$MENU_TARGET" >/dev/null 2>&1 &&
       grep -F 'tabName: "Edge Gateway"' "$MENU_TARGET" >/dev/null 2>&1; then
        echo "menuTree: localized"
        return 0
    fi

    echo "ERROR: active menuTree does not reflect localized menu base" >&2
    return 1
}

