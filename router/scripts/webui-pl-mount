    localize_menu || return 1

    echo "WEBUI_PL_OVERLAY=PASS"
}

restore_menu_labels() {
    [ -f "$MENU_BASE" ] || {
        echo "menuTree: base unavailable, nothing to restore"
        return 0
    }

    if grep -F 'menuName: "System Info",' "$MENU_BASE" >/dev/null 2>&1 &&
       grep -F 'tabName: "Tweaks"' "$MENU_BASE" >/dev/null 2>&1; then
        echo "menuTree labels: already base"
        return 0
    fi

    sysinfo_count="$(grep -F -c 'menuName: "Informacje o systemie",' "$MENU_BASE" || true)"
    tweaks_count="$(grep -F -c 'tabName: "Dostrajanie"' "$MENU_BASE" || true)"

    [ "$sysinfo_count" = "1" ] || {
        echo "ERROR: unexpected Polish System Info menu structure: $sysinfo_count" >&2
        return 1
    }

    [ "$tweaks_count" = "1" ] || {
        echo "ERROR: unexpected Polish Tweaks menu structure: $tweaks_count" >&2
        return 1
    }

    build="/tmp/asus-edge-menu-base-build.$$"

    sed \
        -e 's/menuName: "Informacje o systemie",/menuName: "System Info",/' \
        -e 's/{url: "Tools_OtherSettings.asp", tabName: "Dostrajanie"},/{url: "Tools_OtherSettings.asp", tabName: "Tweaks"},/' \
        "$MENU_BASE" >"$build" || {
            rm -f "$build"
            return 1
        }

    cat "$build" >"$MENU_BASE" || {
        rm -f "$build"
        return 1
    }
    rm -f "$build"

    echo "menuTree labels: restored"
}

unmount_one() {
    target="$1"
    base_sha="$2"
    patched_sha="$3"
    label="$4"

    [ -f "$target" ] || {
        echo "ERROR: missing target during unmount: $target" >&2
        return 1
    }

    current="$(file_hash "$target")"

    if [ "$current" = "$base_sha" ]; then
        echo "$label: already inactive"
        return 0
    fi

    if [ "$current" != "$patched_sha" ]; then
        echo "ERROR: $label active hash is neither baseline nor project overlay" >&2
        echo "ACTIVE=$current" >&2
        return 1
    fi

    while [ "$(file_hash "$target")" = "$patched_sha" ]; do
        if ! grep -F " $target " /proc/mounts >/dev/null 2>&1; then
            echo "ERROR: $label has patched content but is not a bind mount" >&2
            return 1
        fi

        umount "$target" || return 1
    done

    current="$(file_hash "$target")"
    [ "$current" = "$base_sha" ] || {
        echo "ERROR: $label baseline not restored after unmount" >&2
        echo "EXPECTED_BASE=$base_sha" >&2
        echo "ACTIVE=$current" >&2
        return 1
    }

    echo "$label: unmounted"
}

unmount_overlay() {
    unmount_one "$PL_TARGET" \
        "$PL_BASE_SHA" "$PL_PATCHED_SHA" "PL.dict" || return 1

    unmount_one "$HELP_TARGET" \
        "$HELP_BASE_SHA" "$HELP_PATCHED_SHA" "help.js" || return 1

    unmount_one "$SYSINFO_TARGET" \
        "$SYSINFO_BASE_SHA" "$SYSINFO_PATCHED_SHA" "Tools_Sysinfo.asp" || return 1

    unmount_one "$TWEAKS_TARGET" \
        "$TWEAKS_BASE_SHA" "$TWEAKS_PATCHED_SHA" "Tools_OtherSettings.asp" || return 1

    unmount_one "$WADV_TARGET" \
        "$WADV_BASE_SHA" "$WADV_PATCHED_SHA" "Advanced_WAdvanced_Content.asp" || return 1

    unmount_one "$STATE_TARGET" \
        "$STATE_BASE_SHA" "$STATE_PATCHED_SHA" "state.js" || return 1

    unmount_one "$ROUTER_STATUS_TARGET" \
        "$ROUTER_STATUS_BASE_SHA" "$ROUTER_STATUS_PATCHED_SHA" "router_status.asp" || return 1

    unmount_one "$ROUTER_TARGET" \
        "$ROUTER_BASE_SHA" "$ROUTER_PATCHED_SHA" "router.asp" || return 1

    unmount_one "$INTERNET_TARGET" \
        "$INTERNET_BASE_SHA" "$INTERNET_PATCHED_SHA" "internet.asp" || return 1

    unmount_one "$ADV_WAN_TARGET" \
        "$ADV_WAN_BASE_SHA" "$ADV_WAN_PATCHED_SHA" "Advanced_WAN_Content.asp" || return 1

    unmount_one "$ADV_BASICFW_TARGET" \
        "$ADV_BASICFW_BASE_SHA" "$ADV_BASICFW_PATCHED_SHA" "Advanced_BasicFirewall_Content.asp" || return 1

    unmount_one "$ADV_FIREWALL_TARGET" \
        "$ADV_FIREWALL_BASE_SHA" "$ADV_FIREWALL_PATCHED_SHA" "Advanced_Firewall_Content.asp" || return 1

    unmount_one "$ADV_FWUP_TARGET" \
        "$ADV_FWUP_BASE_SHA" "$ADV_FWUP_PATCHED_SHA" "Advanced_FirmwareUpgrade_Content.asp" || return 1

    unmount_one "$ADV_SYSTEM_TARGET" \
        "$ADV_SYSTEM_BASE_SHA" "$ADV_SYSTEM_PATCHED_SHA" "Advanced_System_Content.asp" || return 1

    unmount_one "$ADV_BACKUP_TARGET" \
        "$ADV_BACKUP_BASE_SHA" "$ADV_BACKUP_PATCHED_SHA" "Advanced_SettingBackup_Content.asp" || return 1

    unmount_one "$ADV_SNMP_TARGET" \
        "$ADV_SNMP_BASE_SHA" "$ADV_SNMP_PATCHED_SHA" "Advanced_SNMP_Content.asp" || return 1

    unmount_one "$MAIN_LOG_TARGET" \
        "$MAIN_LOG_BASE_SHA" "$MAIN_LOG_PATCHED_SHA" "Main_LogStatus_Content.asp" || return 1

    unmount_one "$MAIN_WSTATUS_TARGET" \
        "$MAIN_WSTATUS_BASE_SHA" "$MAIN_WSTATUS_PATCHED_SHA" "Main_WStatus_Content.asp" || return 1

    unmount_one "$MAIN_DHCP_TARGET" \
        "$MAIN_DHCP_BASE_SHA" "$MAIN_DHCP_PATCHED_SHA" "Main_DHCPStatus_Content.asp" || return 1

    unmount_one "$MAIN_IPV6_TARGET" \
        "$MAIN_IPV6_BASE_SHA" "$MAIN_IPV6_PATCHED_SHA" "Main_IPV6Status_Content.asp" || return 1

    unmount_one "$MAIN_ROUTE_TARGET" \
        "$MAIN_ROUTE_BASE_SHA" "$MAIN_ROUTE_PATCHED_SHA" "Main_RouteStatus_Content.asp" || return 1

    unmount_one "$MAIN_IPT_TARGET" \
        "$MAIN_IPT_BASE_SHA" "$MAIN_IPT_PATCHED_SHA" "Main_IPTStatus_Content.asp" || return 1

    unmount_one "$MAIN_CONN_TARGET" \
        "$MAIN_CONN_BASE_SHA" "$MAIN_CONN_PATCHED_SHA" "Main_ConnStatus_Content.asp" || return 1

    unmount_one "$TRAFFIC_RT_TARGET" \
        "$TRAFFIC_RT_BASE_SHA" "$TRAFFIC_RT_PATCHED_SHA" "Main_TrafficMonitor_realtime.asp" || return 1

    unmount_one "$TRAFFIC_SETTINGS_TARGET" \
        "$TRAFFIC_SETTINGS_BASE_SHA" "$TRAFFIC_SETTINGS_PATCHED_SHA" "Main_TrafficMonitor_settings.asp" || return 1

    unmount_one "$DNSDIRECTOR_TARGET" \
        "$DNSDIRECTOR_BASE_SHA" "$DNSDIRECTOR_PATCHED_SHA" "DNSDirector.asp" || return 1

    unmount_one "$TRAFFIC_MONTHLY_TARGET" \
        "$TRAFFIC_MONTHLY_BASE_SHA" "$TRAFFIC_MONTHLY_PATCHED_SHA" "Main_TrafficMonitor_monthly.asp" || return 1

    unmount_one "$TRAFFIC_DAILY_TARGET" \
        "$TRAFFIC_DAILY_BASE_SHA" "$TRAFFIC_DAILY_PATCHED_SHA" "Main_TrafficMonitor_daily.asp" || return 1

    unmount_one "$TRAFFIC_LAST24_TARGET" \
        "$TRAFFIC_LAST24_BASE_SHA" "$TRAFFIC_LAST24_PATCHED_SHA" "Main_TrafficMonitor_last24.asp" || return 1

    restore_menu_labels || return 1

    echo "WEBUI_PL_OVERLAY_UNMOUNT=PASS"
}

status_overlay() {
    echo "PL.dict=$(file_hash "$PL_TARGET")"
    echo "help.js=$(file_hash "$HELP_TARGET")"
    echo "Tools_Sysinfo.asp=$(file_hash "$SYSINFO_TARGET")"
    echo "Tools_OtherSettings.asp=$(file_hash "$TWEAKS_TARGET")"
    echo "Advanced_WAdvanced_Content.asp=$(file_hash "$WADV_TARGET")"
    echo "state.js=$(file_hash "$STATE_TARGET")"
    echo "router_status.asp=$(file_hash "$ROUTER_STATUS_TARGET")"
    echo "router.asp=$(file_hash "$ROUTER_TARGET")"
    echo "Advanced_WAN_Content.asp=$(file_hash "$ADV_WAN_TARGET")"
    echo "Advanced_BasicFirewall_Content.asp=$(file_hash "$ADV_BASICFW_TARGET")"
    echo "Advanced_Firewall_Content.asp=$(file_hash "$ADV_FIREWALL_TARGET")"
    echo "Advanced_FirmwareUpgrade_Content.asp=$(file_hash "$ADV_FWUP_TARGET")"
    echo "Advanced_System_Content.asp=$(file_hash "$ADV_SYSTEM_TARGET")"
    echo "Advanced_SettingBackup_Content.asp=$(file_hash "$ADV_BACKUP_TARGET")"
    echo "Advanced_SNMP_Content.asp=$(file_hash "$ADV_SNMP_TARGET")"
    echo "Main_LogStatus_Content.asp=$(file_hash "$MAIN_LOG_TARGET")"
    echo "Main_WStatus_Content.asp=$(file_hash "$MAIN_WSTATUS_TARGET")"
    echo "Main_DHCPStatus_Content.asp=$(file_hash "$MAIN_DHCP_TARGET")"
    echo "Main_IPV6Status_Content.asp=$(file_hash "$MAIN_IPV6_TARGET")"
    echo "Main_RouteStatus_Content.asp=$(file_hash "$MAIN_ROUTE_TARGET")"
    echo "Main_IPTStatus_Content.asp=$(file_hash "$MAIN_IPT_TARGET")"
    echo "Main_ConnStatus_Content.asp=$(file_hash "$MAIN_CONN_TARGET")"
    echo "internet.asp=$(file_hash "$INTERNET_TARGET")"

    echo "Main_TrafficMonitor_realtime.asp=$(file_hash "$TRAFFIC_RT_TARGET")"
    echo "Main_TrafficMonitor_last24.asp=$(file_hash "$TRAFFIC_LAST24_TARGET")"
    echo "Main_TrafficMonitor_daily.asp=$(file_hash "$TRAFFIC_DAILY_TARGET")"
    echo "Main_TrafficMonitor_monthly.asp=$(file_hash "$TRAFFIC_MONTHLY_TARGET")"
    echo "Main_TrafficMonitor_settings.asp=$(file_hash "$TRAFFIC_SETTINGS_TARGET")"
    echo "DNSDirector.asp=$(file_hash "$DNSDIRECTOR_TARGET")"

    if grep -F 'menuName: "Informacje o systemie",' "$MENU_TARGET" >/dev/null 2>&1 &&
       grep -F 'tabName: "Dostrajanie"' "$MENU_TARGET" >/dev/null 2>&1; then
        echo "menuTree=polish"
    elif grep -F 'menuName: "System Info",' "$MENU_TARGET" >/dev/null 2>&1 &&
         grep -F 'tabName: "Tweaks"' "$MENU_TARGET" >/dev/null 2>&1; then
        echo "menuTree=base"
    else
        echo "menuTree=unknown"
    fi
}

case "${1:-}" in
    mount)   mount_overlay ;;
    unmount) unmount_overlay ;;
    status)  status_overlay ;;
    *)
        echo "Usage: $0 {mount|unmount|status}" >&2
        exit 2
        ;;
esac
