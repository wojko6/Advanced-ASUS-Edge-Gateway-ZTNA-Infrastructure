#!/bin/sh
# shellcheck shell=dash

BASE_PATH="/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin"
if [ -n "${EDGE_TEST_PATH_PREFIX:-}" ]; then
    PATH="${EDGE_TEST_PATH_PREFIX}:${BASE_PATH}"
else
    PATH="$BASE_PATH"
fi
export PATH

CONFIG_FILE="${EDGE_CONFIG_FILE:-/jffs/configs/asus-edge.conf}"
LOCK_DIR="${EDGE_TAILSCALE_LOCK_DIR:-/var/run/asus-edge-tailscale.lock}"
log() { logger -t asus-edge "$*"; }

[ -r "$CONFIG_FILE" ] || { log "ERROR: missing $CONFIG_FILE"; exit 1; }
# shellcheck disable=SC1090
. "$CONFIG_FILE"

: "${EDGE_TS_SOCKET=/var/run/tailscale/tailscaled.sock}"
: "${EDGE_TS_STATE=/opt/var/lib/tailscale/tailscaled.state}"
: "${EDGE_TAILSCALED_LOG=/opt/var/log/tailscaled.log}"
: "${EDGE_TS_NETFILTER_MODE:=off}"
: "${EDGE_ADVERTISE_ROUTES:=}"
: "${EDGE_ENABLE_EXIT_NODE:=0}"
: "${EDGE_ACCEPT_DNS:=false}"
: "${EDGE_HOSTNAME:=asus-edge-gateway}"
: "${EDGE_REQUIRE_SWAP:=auto}"
: "${EDGE_SWAP_WAIT_SECONDS:=60}"
: "${EDGE_SERVICE_STABILITY_SECONDS:=5}"
: "${EDGE_SERVICE_START_ATTEMPTS:=6}"
: "${EDGE_SERVICE_RETRY_SECONDS:=5}"
: "${EDGE_TS_READY_WAIT_SECONDS:=20}"
: "${EDGE_TAILSCALE_LOCK_WAIT_SECONDS:=20}"

valid_positive_integer() {
    case "$1" in ''|*[!0-9]*) return 1 ;; esac
    [ "$1" -gt 0 ]
}

valid_absolute_path() {
    candidate_path="$1"
    case "$candidate_path" in /*) ;; *) return 1 ;; esac
    case "$candidate_path" in /|*'//'*) return 1 ;; */../*|*/..|*/./*|*/.) return 1 ;; esac
    return 0
}

path_below_prefix() {
    candidate_path="$1"; allowed_prefix="$2"
    valid_absolute_path "$candidate_path" || return 1
    [ "$candidate_path" != "$allowed_prefix" ] || return 1
    case "$candidate_path" in "$allowed_prefix"/*) return 0 ;; *) return 1 ;; esac
}

validate_mutable_path() {
    value_name="$1"; candidate_path="$2"; allowed_prefix="$3"
    path_below_prefix "$candidate_path" "$allowed_prefix" || {
        log "ERROR: $value_name must be an absolute path below $allowed_prefix"
        return 1
    }
    [ ! -L "$candidate_path" ] || {
        log "ERROR: $value_name must not reference a symlink: $candidate_path"
        return 1
    }
}

for timing in "$EDGE_SWAP_WAIT_SECONDS" "$EDGE_SERVICE_STABILITY_SECONDS" "$EDGE_SERVICE_START_ATTEMPTS" "$EDGE_SERVICE_RETRY_SECONDS" "$EDGE_TS_READY_WAIT_SECONDS" "$EDGE_TAILSCALE_LOCK_WAIT_SECONDS"; do
    valid_positive_integer "$timing" || { log "ERROR: Tailscale timing values must be positive integers"; exit 1; }
done
case "$EDGE_ENABLE_EXIT_NODE" in 0|1) ;; *) log "ERROR: EDGE_ENABLE_EXIT_NODE must be 0 or 1"; exit 1 ;; esac
case "$EDGE_ACCEPT_DNS" in true|false) ;; *) log "ERROR: EDGE_ACCEPT_DNS must be true or false"; exit 1 ;; esac
case "$EDGE_REQUIRE_SWAP" in 0|1|auto) ;; *) log "ERROR: EDGE_REQUIRE_SWAP must be 0, 1, or auto"; exit 1 ;; esac
[ "$EDGE_TS_NETFILTER_MODE" = "off" ] || { log "ERROR: EDGE_TS_NETFILTER_MODE must be off"; exit 1; }
validate_mutable_path EDGE_TS_SOCKET "$EDGE_TS_SOCKET" /var/run/tailscale || exit 1
validate_mutable_path EDGE_TS_STATE "$EDGE_TS_STATE" /opt/var/lib/tailscale || exit 1
validate_mutable_path EDGE_TAILSCALED_LOG "$EDGE_TAILSCALED_LOG" /opt/var/log || exit 1
if [ -n "${EDGE_TEST_PATH_PREFIX:-}" ]; then
    valid_absolute_path "$LOCK_DIR" || { log "ERROR: test lock path must be absolute"; exit 1; }
else
    case "$LOCK_DIR" in
        /var/run/asus-edge-tailscale.lock) ;;
        *) log "ERROR: unsupported Tailscale lock path"; exit 1 ;;
    esac
fi
[ ! -L "$LOCK_DIR" ] || { log "ERROR: Tailscale lock path must not be a symlink"; exit 1; }

lock_owned=0
release_lock() {
    if [ "$lock_owned" = "1" ] && [ -d "$LOCK_DIR" ] &&
       [ "$(cat "$LOCK_DIR/owner" 2>/dev/null)" = "$$" ]; then
        rm -f "$LOCK_DIR/owner" 2>/dev/null || true
        rmdir "$LOCK_DIR" 2>/dev/null || true
    fi
}
trap release_lock EXIT
trap 'exit 1' HUP INT TERM

acquire_lock() {
    elapsed=0
    while [ "$elapsed" -lt "$EDGE_TAILSCALE_LOCK_WAIT_SECONDS" ]; do
        if mkdir "$LOCK_DIR" 2>/dev/null; then
            printf '%s\n' "$$" >"$LOCK_DIR/owner" || { rmdir "$LOCK_DIR" 2>/dev/null || true; return 1; }
            lock_owned=1
            return 0
        fi

        owner_pid="$(cat "$LOCK_DIR/owner" 2>/dev/null)"
        if [ -z "$owner_pid" ] || ! kill -0 "$owner_pid" 2>/dev/null; then
            rm -f "$LOCK_DIR/owner" 2>/dev/null || true
            rmdir "$LOCK_DIR" 2>/dev/null || true
            continue
        fi

        elapsed=$((elapsed + 1))
        sleep 1
    done
    log "ERROR: timed out waiting for Tailscale reconciliation lock"
    return 1
}

process_stays_running() {
    monitored_process="$1"
    stable_seconds=0
    while [ "$stable_seconds" -lt "$EDGE_SERVICE_STABILITY_SECONDS" ]; do
        pidof "$monitored_process" >/dev/null 2>&1 || return 1
        stable_seconds=$((stable_seconds + 1))
        sleep 1
    done
}

swap_is_active() {
    [ -r /proc/swaps ] && awk 'NR > 1 { found=1 } END { exit !found }' /proc/swaps
}

swap_is_required() {
    case "$EDGE_REQUIRE_SWAP" in 1) return 0 ;; 0) return 1 ;; auto) ;; esac
    [ -r /proc/sys/vm/overcommit_memory ] || return 1
    [ "$(cat /proc/sys/vm/overcommit_memory 2>/dev/null)" = "2" ] || return 1
    case "$(uname -m 2>/dev/null)" in armv[5-8]*|i[3-6]86|mips*|ppc) return 0 ;; *) return 1 ;; esac
}

wait_for_required_swap() {
    swap_is_required || return 0
    swap_is_active && return 0
    elapsed=0
    while ! swap_is_active; do
        [ "$elapsed" -ge "$EDGE_SWAP_WAIT_SECONDS" ] && {
            log "ERROR: required swap not active after ${EDGE_SWAP_WAIT_SECONDS}s"
            return 1
        }
        elapsed=$((elapsed + 1))
        sleep 1
    done
}

rotate_log() {
    [ ! -L "$EDGE_TAILSCALED_LOG" ] || { log "ERROR: refusing symlink tailscaled log"; return 1; }
    [ ! -L "$EDGE_TAILSCALED_LOG.previous" ] || { log "ERROR: refusing symlink rotated tailscaled log"; return 1; }
    [ -s "$EDGE_TAILSCALED_LOG" ] || return 0
    cp -f "$EDGE_TAILSCALED_LOG" "$EDGE_TAILSCALED_LOG.previous" 2>/dev/null || return 1
    chmod 0600 "$EDGE_TAILSCALED_LOG.previous" 2>/dev/null || true
}

start_daemon() {
    wait_for_required_swap || return 1
    mkdir -p "$(dirname "$EDGE_TS_STATE")" "$(dirname "$EDGE_TS_SOCKET")" "$(dirname "$EDGE_TAILSCALED_LOG")" || return 1
    rotate_log || log "WARNING: could not preserve previous tailscaled log"
    [ ! -L "$EDGE_TAILSCALED_LOG" ] || return 1
    : >"$EDGE_TAILSCALED_LOG" || return 1
    chmod 0600 "$EDGE_TAILSCALED_LOG" 2>/dev/null || true

    attempt=1
    while [ "$attempt" -le "$EDGE_SERVICE_START_ATTEMPTS" ]; do
        if pidof tailscaled >/dev/null 2>&1 && process_stays_running tailscaled; then
            return 0
        fi
        [ ! -L "$EDGE_TS_SOCKET" ] || { log "ERROR: refusing symlink socket path"; return 1; }
        rm -f "$EDGE_TS_SOCKET"
        printf 'Attempt %s/%s: tailscaled startup\n' "$attempt" "$EDGE_SERVICE_START_ATTEMPTS" >>"$EDGE_TAILSCALED_LOG"
        tailscaled --state="$EDGE_TS_STATE" --socket="$EDGE_TS_SOCKET" >>"$EDGE_TAILSCALED_LOG" 2>&1 &
        if process_stays_running tailscaled; then
            return 0
        fi
        attempt=$((attempt + 1))
        [ "$attempt" -le "$EDGE_SERVICE_START_ATTEMPTS" ] && sleep "$EDGE_SERVICE_RETRY_SECONDS"
    done
    return 1
}

stop_daemon() {
    pids="$(pidof tailscaled 2>/dev/null)" || return 0
    [ -n "$pids" ] || return 0
    kill $pids 2>/dev/null || return 1
    elapsed=0
    while pidof tailscaled >/dev/null 2>&1; do
        [ "$elapsed" -ge "$EDGE_TS_READY_WAIT_SECONDS" ] && {
            log "ERROR: tailscaled did not stop within timeout"
            return 1
        }
        elapsed=$((elapsed + 1))
        sleep 1
    done
    return 0
}

wait_for_api() {
    elapsed=0
    while [ "$elapsed" -lt "$EDGE_TS_READY_WAIT_SECONDS" ]; do
        pidof tailscaled >/dev/null 2>&1 || return 1
        tailscale --socket="$EDGE_TS_SOCKET" status >/dev/null 2>&1 && return 0
        elapsed=$((elapsed + 1))
        sleep 1
    done
    return 1
}

apply_policy() {
    set -- tailscale --socket="$EDGE_TS_SOCKET" up         --netfilter-mode="$EDGE_TS_NETFILTER_MODE"         --accept-dns="$EDGE_ACCEPT_DNS"         --hostname="$EDGE_HOSTNAME"
    [ -n "$EDGE_ADVERTISE_ROUTES" ] && set -- "$@" --advertise-routes="$EDGE_ADVERTISE_ROUTES"
    [ "$EDGE_ENABLE_EXIT_NODE" = "1" ] && set -- "$@" --advertise-exit-node
    "$@" >/tmp/asus-edge-tailscale-up.log 2>&1 || return 1

    tailscale_netfilter_mode="$(
        tailscale --socket="$EDGE_TS_SOCKET" debug prefs 2>/dev/null |
            awk -F: '/"NetfilterMode"/ {
                value=$2
                gsub(/[[:space:],]/, "", value)
                print value
                exit
            }'
    )"
    [ "$tailscale_netfilter_mode" = "0" ] || {
        log "ERROR: Tailscale netfilter mode verification failed"
        return 1
    }
    tailscale --socket="$EDGE_TS_SOCKET" status >/dev/null 2>&1 || return 1
    return 0
}

MODE="${1:-ensure}"
case "$MODE" in ensure|restart) ;; *) echo "Usage: $0 [ensure|restart]" >&2; exit 2 ;; esac

acquire_lock || exit 1

if [ "$MODE" = "restart" ]; then
    stop_daemon || exit 1
fi

if ! pidof tailscaled >/dev/null 2>&1 || ! process_stays_running tailscaled; then
    start_daemon || { log "ERROR: failed to start tailscaled"; exit 1; }
fi

wait_for_api || { log "ERROR: Tailscale local API unavailable"; exit 1; }
apply_policy || { log "ERROR: failed to apply or verify Tailscale policy"; exit 1; }

log "Tailscale reconciliation completed (${MODE})"
exit 0
