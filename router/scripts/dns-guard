#!/bin/sh
# ASUS Edge DNS Guard v3.1
# Fail-open runtime resolver controller.

BASE_PATH="/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin"

if [ -n "${EDGE_TEST_PATH_PREFIX:-}" ]; then
    PATH="${EDGE_TEST_PATH_PREFIX}:${BASE_PATH}"
else
    PATH="$BASE_PATH"
fi
export PATH

BUSYBOX="${EDGE_BUSYBOX_BIN:-/bin/busybox}"

CONFIG_FILE="${EDGE_CONFIG_FILE:-/jffs/configs/asus-edge.conf}"
RESOLV_CONF="${EDGE_RESOLV_CONF:-/tmp/resolv.conf}"

STATE_DIR="${EDGE_DNS_STATE_DIR:-/jffs/addons/asus-edge/state}"
BREAKGLASS_FLAG="${EDGE_DNS_BREAKGLASS_FLAG:-$STATE_DIR/dns-breakglass}"

log() {
    logger -t asus-edge-dns "$*"
}

die() {
    echo "ERROR: $*" >&2
    log "ERROR: $*"
    exit 1
}

[ -r "$CONFIG_FILE" ] || die "missing $CONFIG_FILE"

# shellcheck disable=SC1090
. "$CONFIG_FILE"

: "${EDGE_UNBOUND_PORT:=53535}"
: "${EDGE_TS_PIHOLE_DNS_IP:=192.168.50.253}"

mkdir -p "$STATE_DIR" || die "cannot create $STATE_DIR"
chmod 700 "$STATE_DIR" 2>/dev/null || true

bootstrap_dns() {
    for key in wan0_dns_r wan0_dns wan_dns_r wan_dns; do
        value="$(nvram get "$key" 2>/dev/null)"

        if [ -n "$value" ]; then
            printf '%s\n' "$value"
            return 0
        fi
    done

    return 1
}

ntp_ready() {
    [ "$(nvram get ntp_ready 2>/dev/null)" = "1" ]
}

unbound_ready() {
    pidof unbound >/dev/null 2>&1 || return 1

    netstat -ln 2>/dev/null |
        grep -q "127\\.0\\.0\\.1:${EDGE_UNBOUND_PORT}[[:space:]]" ||
        return 1

    return 0
}

pihole_listener_ready() {
    pidof pihole-FTL >/dev/null 2>&1 || return 1

    netstat -ln 2>/dev/null |
        grep -q "${EDGE_TS_PIHOLE_DNS_IP}:53[[:space:]]" ||
        return 1

    return 0
}

pihole_query_ready() {
    probe="edge-health-$(date +%s).1-1-1-1.sslip.io"
    logfile="/tmp/asus-edge-dns-guard-query.log"

    "$BUSYBOX" nslookup "$probe" "$EDGE_TS_PIHOLE_DNS_IP" \
        >"$logfile" 2>&1 ||
        return 1

    grep -q '1\\.1\\.1\\.1' "$logfile" || return 1

    return 0
}

full_local_dns_ready() {
    ntp_ready || return 1
    unbound_ready || return 1
    pihole_listener_ready || return 1
    pihole_query_ready || return 1

    return 0
}

write_resolver() {
    mode="$1"
    tmp="${RESOLV_CONF}.asus-edge.$$"

    case "$mode" in
        local)
            printf 'nameserver %s\n'                 "$EDGE_TS_PIHOLE_DNS_IP" >"$tmp" ||
                return 1
            ;;

        bootstrap)
            dns_list="$(bootstrap_dns)" || return 1

            : >"$tmp" || return 1

            for dns in $dns_list; do
                printf 'nameserver %s\n' "$dns" >>"$tmp" ||
                    return 1
            done
            ;;

        *)
            return 1
            ;;
    esac

    [ -s "$tmp" ] || {
        rm -f "$tmp"
        return 1
    }

    if [ -f "$RESOLV_CONF" ] &&
       "$BUSYBOX" cmp -s "$tmp" "$RESOLV_CONF" 2>/dev/null; then
        rm -f "$tmp"
        return 2
    fi

    chmod 644 "$tmp" 2>/dev/null || true

    mv -f "$tmp" "$RESOLV_CONF" || {
        rm -f "$tmp"
        return 1
    }

    return 0
}

promote_local() {
    if [ -f "$BREAKGLASS_FLAG" ]; then
        echo "PROMOTE=BLOCKED_BREAKGLASS"
        log "local DNS promotion blocked by active break-glass"
        return 1
    fi

    if ! full_local_dns_ready; then
        echo "PROMOTE=BLOCKED_UNHEALTHY"
        log "local DNS promotion blocked because DNS path is unhealthy"
        return 1
    fi

    if [ -f "$BREAKGLASS_FLAG" ]; then
        echo "PROMOTE=BLOCKED_BREAKGLASS"
        log "local DNS promotion aborted: break-glass became active"
        return 1
    fi

    write_resolver local
    rc=$?

    case "$rc" in
        0)
            echo "PROMOTE=PASS"
            log "system resolver promoted to Pi-hole $EDGE_TS_PIHOLE_DNS_IP"
            return 0
            ;;
        2)
            echo "PROMOTE=ALREADY_LOCAL"
            return 0
            ;;
        *)
            echo "PROMOTE=FAILED"
            log "ERROR: failed to promote resolver to Pi-hole"
            return 1
            ;;
    esac
}

fallback_bootstrap() {
    write_resolver bootstrap
    rc=$?

    case "$rc" in
        0)
            echo "FALLBACK=PASS"
            log "system resolver restored to WAN bootstrap DNS"
            return 0
            ;;
        2)
            echo "FALLBACK=ALREADY_BOOTSTRAP"
            return 0
            ;;
        *)
            echo "FALLBACK=FAILED"
            log "ERROR: failed to restore WAN bootstrap DNS"
            return 1
            ;;
    esac
}

breakglass_on() {
    reason="${1:-manual}"
    tmp="${BREAKGLASS_FLAG}.tmp.$$"

    umask 077

    {
        printf 'active=1\n'
        printf 'activated=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
        printf 'reason=%s\n' "$reason"
    } >"$tmp" || {
        rm -f "$tmp"
        return 1
    }

    chmod 600 "$tmp" 2>/dev/null || true

    mv -f "$tmp" "$BREAKGLASS_FLAG" || {
        rm -f "$tmp"
        return 1
    }

    log "DNS break-glass activated: $reason"

    if ! fallback_bootstrap; then
        echo "BREAKGLASS=ACTIVE_FALLBACK_FAILED"
        return 1
    fi

    echo "BREAKGLASS=ACTIVE"
    return 0
}

breakglass_off() {
    if [ -f "$BREAKGLASS_FLAG" ]; then
        rm -f "$BREAKGLASS_FLAG" || return 1
        log "DNS break-glass cleared"
    fi

    echo "BREAKGLASS=INACTIVE"
    return 0
}

auto_policy() {
    if [ -f "$BREAKGLASS_FLAG" ]; then
        if fallback_bootstrap; then
            echo "AUTO=BOOTSTRAP_BREAKGLASS"
            return 0
        fi

        return 1
    fi

    if full_local_dns_ready; then
        if promote_local; then
            echo "AUTO=LOCAL_DNS"
            return 0
        fi

        fallback_bootstrap || return 1
        echo "AUTO=BOOTSTRAP"
        return 0
    fi

    fallback_bootstrap || return 1
    echo "AUTO=BOOTSTRAP_UNHEALTHY"
    return 0
}

show_status() {
    echo "=== ASUS EDGE DNS GUARD v3.1 ==="
    echo "resolver=$RESOLV_CONF"
    echo "pihole=$EDGE_TS_PIHOLE_DNS_IP"
    echo "unbound_port=$EDGE_UNBOUND_PORT"
    echo

    if [ -f "$BREAKGLASS_FLAG" ]; then
        echo "BREAKGLASS=ACTIVE"
    else
        echo "BREAKGLASS=INACTIVE"
    fi

    ntp_ready &&
        echo "NTP=PASS" ||
        echo "NTP=FAIL"

    unbound_ready &&
        echo "UNBOUND=PASS" ||
        echo "UNBOUND=FAIL"

    pihole_listener_ready &&
        echo "PIHOLE_LISTENER=PASS" ||
        echo "PIHOLE_LISTENER=FAIL"

    pihole_query_ready &&
        echo "PIHOLE_QUERY=PASS" ||
        echo "PIHOLE_QUERY=FAIL"

    echo
    echo "=== CURRENT RESOLVER ==="
    cat "$RESOLV_CONF" 2>/dev/null || true

    echo
    echo "=== BOOTSTRAP DNS ==="
    bootstrap_dns || echo "BOOTSTRAP_DNS=UNAVAILABLE"

    echo
    if [ -f "$BREAKGLASS_FLAG" ]; then
        echo "DECISION=KEEP_BOOTSTRAP_BREAKGLASS"
    elif full_local_dns_ready; then
        echo "DECISION=LOCAL_DNS_READY"
    else
        echo "DECISION=KEEP_BOOTSTRAP_DNS"
    fi
}

case "${1:-status}" in
    status|check)
        show_status
        ;;
    auto)
        auto_policy
        ;;
    promote)
        promote_local
        ;;
    fallback)
        fallback_bootstrap
        ;;
    breakglass-on)
        breakglass_on "${2:-manual}"
        ;;
    breakglass-off)
        breakglass_off
        ;;
    *)
        echo "Usage: $0 {status|check|auto|promote|fallback|breakglass-on [reason]|breakglass-off}"
        exit 2
        ;;
esac
