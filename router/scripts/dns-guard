#!/bin/sh
# ASUS Edge DNS Guard v3.2
# Fail-open runtime resolver controller.

BASE_PATH="/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin"

if [ -n "${EDGE_TEST_PATH_PREFIX:-}" ]; then
    PATH="${EDGE_TEST_PATH_PREFIX}:${BASE_PATH}"
else
    PATH="$BASE_PATH"
fi
export PATH

BUSYBOX="${EDGE_BUSYBOX_BIN:-/bin/busybox}"

executable_exists() {
    executable_name="$1"

    case "$executable_name" in
        */*)
            [ -x "$executable_name" ]
            return
            ;;
    esac

    for executable_dir in /opt/sbin /opt/bin /usr/sbin /usr/bin /sbin /bin; do
        [ -x "$executable_dir/$executable_name" ] && return 0
    done

    return 1
}

CONFIG_FILE="${EDGE_CONFIG_FILE:-/jffs/configs/asus-edge.conf}"
RESOLV_CONF="${EDGE_RESOLV_CONF:-/tmp/resolv.conf}"

STATE_DIR="${EDGE_DNS_STATE_DIR:-/jffs/addons/asus-edge/state}"
BREAKGLASS_FLAG="${EDGE_DNS_BREAKGLASS_FLAG:-$STATE_DIR/dns-breakglass}"
LOCK_FILE="${EDGE_DNS_LOCK_FILE:-$STATE_DIR/dns-guard.lock}"
RUNTIME_STATE_DIR="${EDGE_DNS_RUNTIME_STATE_DIR:-/tmp/asus-edge-dns-guard}"
RECOVERY_STREAK_FILE="$RUNTIME_STATE_DIR/recovery-success-streak"

log() {
    logger -t asus-edge-dns "$*"
}

die() {
    echo "ERROR: $*" >&2
    log "ERROR: $*"
    exit 1
}

[ -r "$CONFIG_FILE" ] || die "missing $CONFIG_FILE"

# shellcheck disable=SC1090
. "$CONFIG_FILE"

: "${EDGE_UNBOUND_PORT:=53535}"
: "${EDGE_DNS_LOCAL_RESOLVER_IP:=}"
: "${EDGE_DNS_FAILBACK_SUCCESS_THRESHOLD:=3}"

case "$EDGE_DNS_FAILBACK_SUCCESS_THRESHOLD" in
    ''|*[!0-9]*)
        die "EDGE_DNS_FAILBACK_SUCCESS_THRESHOLD must be a positive integer"
        ;;
esac

[ "$EDGE_DNS_FAILBACK_SUCCESS_THRESHOLD" -gt 0 ] ||
    die "EDGE_DNS_FAILBACK_SUCCESS_THRESHOLD must be greater than zero"

mkdir -p "$STATE_DIR" || die "cannot create $STATE_DIR"
chmod 700 "$STATE_DIR" 2>/dev/null || true

mkdir -p "$RUNTIME_STATE_DIR" || die "cannot create $RUNTIME_STATE_DIR"
chmod 700 "$RUNTIME_STATE_DIR" 2>/dev/null || true

executable_exists flock >/dev/null 2>&1 ||
    die "flock not found; cannot serialize DNS Guard state transitions"

exec 9>"$LOCK_FILE" || die "cannot open DNS Guard lock file"
flock -x 9 || die "cannot acquire DNS Guard lock"

secure_temp_dir() {
    temp_prefix="$1"
    temp_counter=0

    while [ "$temp_counter" -lt 100 ]; do
        temp_candidate="$temp_prefix.$.${temp_counter}"

        if (umask 077 && mkdir "$temp_candidate") 2>/dev/null; then
            printf '%s\n' "$temp_candidate"
            return 0
        fi

        temp_counter=$((temp_counter + 1))
    done

    return 1
}

recovery_streak_read() {
    [ -r "$RECOVERY_STREAK_FILE" ] || {
        printf '%s\n' 0
        return 0
    }

    streak="$(cat "$RECOVERY_STREAK_FILE" 2>/dev/null)" || streak=0

    case "$streak" in
        ''|*[!0-9]*)
            printf '%s\n' 0
            ;;
        *)
            printf '%s\n' "$streak"
            ;;
    esac
}

recovery_streak_write() {
    streak="$1"
    tmp="$RECOVERY_STREAK_FILE.tmp.$"

    umask 077
    printf '%s\n' "$streak" >"$tmp" || {
        rm -f "$tmp"
        return 1
    }

    chmod 600 "$tmp" 2>/dev/null || true

    mv -f "$tmp" "$RECOVERY_STREAK_FILE" || {
        rm -f "$tmp"
        return 1
    }

    return 0
}

recovery_streak_reset() {
    rm -f "$RECOVERY_STREAK_FILE" 2>/dev/null || true
}

recovery_streak_increment() {
    streak="$(recovery_streak_read)"
    streak=$((streak + 1))

    if [ "$streak" -gt "$EDGE_DNS_FAILBACK_SUCCESS_THRESHOLD" ]; then
        streak="$EDGE_DNS_FAILBACK_SUCCESS_THRESHOLD"
    fi

    recovery_streak_write "$streak" || return 1
    printf '%s\n' "$streak"
}

resolver_is_local() {
    [ -r "$RESOLV_CONF" ] || return 1

    awk -v local="$EDGE_DNS_LOCAL_RESOLVER_IP" '
        $1 == "nameserver" {
            count++
            if ($2 == local)
                local_count++
        }
        END {
            exit !(count == 1 && local_count == 1)
        }
    ' "$RESOLV_CONF"
}

bootstrap_dns_candidate_valid() {
    candidate="$1"

    valid_ipv4 "$candidate" || return 1

    case "$candidate" in
        127.*|0.0.0.0)
            return 1
            ;;
    esac

    if [ -n "$EDGE_DNS_LOCAL_RESOLVER_IP" ] &&
       [ "$candidate" = "$EDGE_DNS_LOCAL_RESOLVER_IP" ]; then
        return 1
    fi

    return 0
}

bootstrap_dns() {
    for key in wan0_dns_r wan0_dns wan_dns_r wan_dns; do
        value="$(nvram get "$key" 2>/dev/null)"
        [ -n "$value" ] || continue

        accepted=""

        for candidate in $value; do
            if ! bootstrap_dns_candidate_valid "$candidate"; then
                log "WARNING: rejected non-independent WAN bootstrap DNS candidate from $key: $candidate"
                continue
            fi

            case " $accepted " in
                *" $candidate "*)
                    ;;
                *)
                    accepted="$accepted $candidate"
                    ;;
            esac
        done

        if [ -n "$accepted" ]; then
            for candidate in $accepted; do
                printf '%s\n' "$candidate"
            done
            return 0
        fi

        log "WARNING: no valid independent WAN bootstrap DNS candidates in $key"
    done

    return 1
}

valid_ipv4() {
    old_ifs="$IFS"
    IFS=.
    set -- $1
    IFS="$old_ifs"

    [ "$#" -eq 4 ] || return 1

    for octet in "$@"; do
        case "$octet" in
            ''|*[!0-9]*)
                return 1
                ;;
        esac

        [ "$octet" -le 255 ] 2>/dev/null || return 1
    done

    return 0
}

local_resolver_config_valid() {
    [ -n "$EDGE_DNS_LOCAL_RESOLVER_IP" ] || return 1
    valid_ipv4 "$EDGE_DNS_LOCAL_RESOLVER_IP"
}

ntp_ready() {
    [ "$(nvram get ntp_ready 2>/dev/null)" = "1" ]
}

unbound_ready() {
    pidof unbound >/dev/null 2>&1 || return 1

    netstat -ln 2>/dev/null |
        grep -q "127\\.0\\.0\\.1:${EDGE_UNBOUND_PORT}[[:space:]]" ||
        return 1

    return 0
}

pihole_listener_ready() {
    local_resolver_config_valid || return 1
    pidof pihole-FTL >/dev/null 2>&1 || return 1

    netstat -ln 2>/dev/null |
        awk -v endpoint="$EDGE_DNS_LOCAL_RESOLVER_IP:53" '
            $4 == endpoint { found=1 }
            END { exit !found }
        ' ||
        return 1

    return 0
}

pihole_query_ready() {
    local_resolver_config_valid || return 1

    probe="edge-health-$(date +%s).1-1-1-1.sslip.io"

    query_output="$(
        "$BUSYBOX" nslookup "$probe" "$EDGE_DNS_LOCAL_RESOLVER_IP" 2>&1
    )" || return 1

    printf '%s\n' "$query_output" |
        grep -q '1\.1\.1\.1' ||
        return 1

    return 0
}

full_local_dns_ready() {
    ntp_ready || return 1
    unbound_ready || return 1
    pihole_listener_ready || return 1
    pihole_query_ready || return 1

    return 0
}

write_resolver() {
    mode="$1"

    resolv_dir="${RESOLV_CONF%/*}"
    [ "$resolv_dir" != "$RESOLV_CONF" ] || resolv_dir="."

    tmp_dir="$(secure_temp_dir "$resolv_dir/.asus-edge-dns-guard")" ||
        return 1
    tmp="$tmp_dir/resolv.conf"

    case "$mode" in
        local)
            if ! local_resolver_config_valid; then
                rm -f "$tmp"
                rmdir "$tmp_dir" 2>/dev/null || true
                return 1
            fi

            printf 'nameserver %s\n' \
                "$EDGE_DNS_LOCAL_RESOLVER_IP" >"$tmp" || {
                rm -f "$tmp"
                rmdir "$tmp_dir" 2>/dev/null || true
                return 1
            }
            ;;

        bootstrap)
            dns_list="$(bootstrap_dns)" || {
                rm -f "$tmp"
                rmdir "$tmp_dir" 2>/dev/null || true
                return 1
            }

            : >"$tmp" || return 1

            for dns in $dns_list; do
                printf 'nameserver %s\n' "$dns" >>"$tmp" ||
                    return 1
            done
            ;;

        *)
            rm -f "$tmp"
            rmdir "$tmp_dir" 2>/dev/null || true
            return 1
            ;;
    esac

    [ -s "$tmp" ] || {
        rm -f "$tmp"
        rmdir "$tmp_dir" 2>/dev/null || true
        return 1
    }

    if [ -f "$RESOLV_CONF" ] &&
       "$BUSYBOX" cmp -s "$tmp" "$RESOLV_CONF" 2>/dev/null; then
        rm -f "$tmp"
        rmdir "$tmp_dir" 2>/dev/null || true
        return 2
    fi

    chmod 644 "$tmp" 2>/dev/null || true

    mv -f "$tmp" "$RESOLV_CONF" || {
        rm -f "$tmp"
        rmdir "$tmp_dir" 2>/dev/null || true
        return 1
    }

    rmdir "$tmp_dir" 2>/dev/null || true
    return 0
}

promote_local_ready() {
    if [ -f "$BREAKGLASS_FLAG" ]; then
        echo "PROMOTE=BLOCKED_BREAKGLASS"
        log "local DNS promotion aborted: break-glass became active"
        return 1
    fi

    write_resolver local
    rc=$?

    case "$rc" in
        0)
            echo "PROMOTE=PASS"
            log "system resolver promoted to Pi-hole $EDGE_DNS_LOCAL_RESOLVER_IP"
            return 0
            ;;
        2)
            echo "PROMOTE=ALREADY_LOCAL"
            return 0
            ;;
        *)
            echo "PROMOTE=FAILED"
            log "ERROR: failed to promote resolver to Pi-hole"
            return 1
            ;;
    esac
}

promote_local() {
    if ! local_resolver_config_valid; then
        echo "PROMOTE=BLOCKED_INVALID_LOCAL_RESOLVER"
        log "ERROR: local DNS resolver target is missing or invalid"
        return 1
    fi

    if [ -f "$BREAKGLASS_FLAG" ]; then
        echo "PROMOTE=BLOCKED_BREAKGLASS"
        log "local DNS promotion blocked by active break-glass"
        return 1
    fi

    if ! full_local_dns_ready; then
        echo "PROMOTE=BLOCKED_UNHEALTHY"
        log "local DNS promotion blocked because DNS path is unhealthy"
        return 1
    fi

    promote_local_ready
}

fallback_bootstrap() {
    write_resolver bootstrap
    rc=$?

    case "$rc" in
        0)
            echo "FALLBACK=PASS"
            log "system resolver restored to WAN bootstrap DNS"
            return 0
            ;;
        2)
            echo "FALLBACK=ALREADY_BOOTSTRAP"
            return 0
            ;;
        *)
            echo "FALLBACK=FAILED"
            log "ERROR: failed to restore WAN bootstrap DNS"
            return 1
            ;;
    esac
}

breakglass_on() {
    reason="${1:-manual}"
    recovery_streak_reset
    tmp="${BREAKGLASS_FLAG}.tmp.$$"

    umask 077

    {
        printf 'active=1\n'
        printf 'activated=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
        printf 'reason=%s\n' "$reason"
    } >"$tmp" || {
        rm -f "$tmp"
        return 1
    }

    chmod 600 "$tmp" 2>/dev/null || true

    mv -f "$tmp" "$BREAKGLASS_FLAG" || {
        rm -f "$tmp"
        return 1
    }

    log "DNS break-glass activated: $reason"

    if ! fallback_bootstrap; then
        echo "BREAKGLASS=ACTIVE_FALLBACK_PENDING"
        log "WARNING: DNS break-glass is active but WAN bootstrap DNS is not available yet"
        return 0
    fi

    echo "BREAKGLASS=ACTIVE"
    return 0
}

local_dns_ready() {
    if local_resolver_config_valid && full_local_dns_ready; then
        echo "READY=PASS"
        return 0
    fi

    echo "READY=FAIL"
    return 1
}

breakglass_off() {
    if [ -f "$BREAKGLASS_FLAG" ]; then
        rm -f "$BREAKGLASS_FLAG" || return 1
        log "DNS break-glass cleared"
    fi

    echo "BREAKGLASS=INACTIVE"
    return 0
}

auto_policy() {
    if [ -f "$BREAKGLASS_FLAG" ]; then
        recovery_streak_reset

        if fallback_bootstrap; then
            echo "AUTO=BOOTSTRAP_BREAKGLASS"
            return 0
        fi

        return 1
    fi

    if ! local_resolver_config_valid; then
        recovery_streak_reset
        log "ERROR: local DNS resolver target is missing or invalid; keeping bootstrap DNS"
        fallback_bootstrap || return 1
        echo "AUTO=BOOTSTRAP_CONFIG_INVALID"
        return 0
    fi

    if ! full_local_dns_ready; then
        recovery_streak_reset
        fallback_bootstrap || return 1
        echo "AUTO=BOOTSTRAP_UNHEALTHY"
        return 0
    fi

    if resolver_is_local; then
        recovery_streak_reset

        if promote_local_ready; then
            echo "AUTO=LOCAL_DNS"
            return 0
        fi

        fallback_bootstrap || return 1
        echo "AUTO=BOOTSTRAP"
        return 0
    fi

    streak="$(recovery_streak_increment)" || {
        log "ERROR: failed to update DNS recovery hysteresis state"
        fallback_bootstrap || return 1
        echo "AUTO=BOOTSTRAP_HYSTERESIS_STATE_ERROR"
        return 0
    }

    echo "RECOVERY_STREAK=$streak/$EDGE_DNS_FAILBACK_SUCCESS_THRESHOLD"

    if [ "$streak" -lt "$EDGE_DNS_FAILBACK_SUCCESS_THRESHOLD" ]; then
        fallback_bootstrap || return 1
        echo "AUTO=BOOTSTRAP_RECOVERY_PENDING"
        return 0
    fi

    if promote_local_ready; then
        recovery_streak_reset
        echo "AUTO=LOCAL_DNS"
        return 0
    fi

    recovery_streak_reset
    fallback_bootstrap || return 1
    echo "AUTO=BOOTSTRAP"
    return 0
}

show_status() {
    echo "=== ASUS EDGE DNS GUARD v3.2 ==="
    echo "resolver=$RESOLV_CONF"
    if local_resolver_config_valid; then
        echo "local_resolver=$EDGE_DNS_LOCAL_RESOLVER_IP"
        echo "LOCAL_RESOLVER_CONFIG=PASS"
    else
        echo "local_resolver=UNCONFIGURED_OR_INVALID"
        echo "LOCAL_RESOLVER_CONFIG=FAIL"
    fi
    echo "unbound_port=$EDGE_UNBOUND_PORT"
    echo "failback_success_threshold=$EDGE_DNS_FAILBACK_SUCCESS_THRESHOLD"
    echo "recovery_streak=$(recovery_streak_read)/$EDGE_DNS_FAILBACK_SUCCESS_THRESHOLD"
    echo

    if [ -f "$BREAKGLASS_FLAG" ]; then
        echo "BREAKGLASS=ACTIVE"
    else
        echo "BREAKGLASS=INACTIVE"
    fi

    ntp_ready &&
        echo "NTP=PASS" ||
        echo "NTP=FAIL"

    unbound_ready &&
        echo "UNBOUND=PASS" ||
        echo "UNBOUND=FAIL"

    pihole_listener_ready &&
        echo "PIHOLE_LISTENER=PASS" ||
        echo "PIHOLE_LISTENER=FAIL"

    pihole_query_ready &&
        echo "PIHOLE_QUERY=PASS" ||
        echo "PIHOLE_QUERY=FAIL"

    echo
    echo "=== CURRENT RESOLVER ==="
    cat "$RESOLV_CONF" 2>/dev/null || true

    echo
    echo "=== BOOTSTRAP DNS ==="
    bootstrap_dns || echo "BOOTSTRAP_DNS=UNAVAILABLE"

    echo
    if [ -f "$BREAKGLASS_FLAG" ]; then
        echo "DECISION=KEEP_BOOTSTRAP_BREAKGLASS"
    elif ! local_resolver_config_valid; then
        echo "DECISION=KEEP_BOOTSTRAP_CONFIG_INVALID"
    elif full_local_dns_ready; then
        echo "DECISION=LOCAL_DNS_READY"
    else
        echo "DECISION=KEEP_BOOTSTRAP_DNS"
    fi
}

case "${1:-status}" in
    status|check)
        show_status
        ;;
    auto)
        auto_policy
        ;;
    promote)
        promote_local
        ;;
    fallback)
        recovery_streak_reset
        fallback_bootstrap
        ;;
    breakglass-on)
        breakglass_on "${2:-manual}"
        ;;
    breakglass-off)
        breakglass_off
        ;;
    ready)
        local_dns_ready
        ;;
    *)
        echo "Usage: $0 {status|check|auto|promote|fallback|ready|breakglass-on [reason]|breakglass-off}"
        exit 2
        ;;
esac
