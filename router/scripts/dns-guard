#!/bin/sh
# ASUS Edge DNS Guard v3.2
# Fail-open runtime resolver controller.

BASE_PATH="/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin"

if [ -n "${EDGE_TEST_PATH_PREFIX:-}" ]; then
    PATH="${EDGE_TEST_PATH_PREFIX}:${BASE_PATH}"
else
    PATH="$BASE_PATH"
fi
export PATH

BUSYBOX="${EDGE_BUSYBOX_BIN:-/bin/busybox}"

executable_exists() {
    executable_name="$1"

    case "$executable_name" in
        */*)
            [ -x "$executable_name" ]
            return
            ;;
    esac

    for executable_dir in /opt/sbin /opt/bin /usr/sbin /usr/bin /sbin /bin; do
        [ -x "$executable_dir/$executable_name" ] && return 0
    done

    return 1
}

CONFIG_FILE="${EDGE_CONFIG_FILE:-/jffs/configs/asus-edge.conf}"
RESOLV_CONF="${EDGE_RESOLV_CONF:-/tmp/resolv.conf}"

STATE_DIR="${EDGE_DNS_STATE_DIR:-/jffs/addons/asus-edge/state}"
BREAKGLASS_FLAG="${EDGE_DNS_BREAKGLASS_FLAG:-$STATE_DIR/dns-breakglass}"
LOCK_FILE="${EDGE_DNS_LOCK_FILE:-$STATE_DIR/dns-guard.lock}"
RUNTIME_STATE_DIR="${EDGE_DNS_RUNTIME_STATE_DIR:-/tmp/asus-edge-dns-guard}"
RECOVERY_STREAK_FILE="$RUNTIME_STATE_DIR/recovery-success-streak"
MODE_FILE="$RUNTIME_STATE_DIR/current-mode"
LAST_TRANSITION_FILE="$RUNTIME_STATE_DIR/last-transition-epoch"
FALLBACK_COUNT_FILE="$RUNTIME_STATE_DIR/fallback-transitions"
FALLBACK_SINCE_FILE="$RUNTIME_STATE_DIR/fallback-since-epoch"
BOOTSTRAP_HEALTH_FILE="$RUNTIME_STATE_DIR/bootstrap-dns-healthy"
BOOTSTRAP_HEALTH_CHECK_FILE="$RUNTIME_STATE_DIR/bootstrap-dns-last-check-epoch"

# Firmware BusyBox 1.25.1 on the reference TUF-AX5400 has sleep/kill but
# no timeout applet. Do not depend on Entware (/opt) for DNS boot recovery.
# Only bound directly executed commands here; do not use this for daemon trees.
native_bounded_exec() (
    duration="$1"
    shift

    case "$duration" in
        ''|0|*[!0-9]*) return 2 ;;
    esac
    [ "$#" -gt 0 ] || return 2
    # Guard against oversized durations before invoking firmware sleep.
    [ "${#duration}" -le 3 ] && [ "$duration" -le 120 ] || return 2

    # Fail visibly before launching a potentially blocking command if the
    # watchdog primitive itself is unavailable.
    "$BUSYBOX" sleep 0 >/dev/null 2>&1 || return 127

    # Close the guard lock fd in both child and timer; otherwise orphaned
    # subprocesses could accidentally retain the global lock after exit.
    "$@" 9>&- &
    worker_pid=$!

    (
        "$BUSYBOX" sleep "$duration" || exit 1
        kill -KILL "$worker_pid" 2>/dev/null || :
    ) </dev/null >/dev/null 2>&1 9>&- &
    timer_pid=$!

    if wait "$worker_pid"; then
        worker_rc=0
    else
        worker_rc=$?
    fi

    kill "$timer_pid" >/dev/null 2>&1 || :
    wait "$timer_pid" >/dev/null 2>&1 || :
    return "$worker_rc"
)

log() {
    # Logging must never be able to stall a DNS recovery transition while the
    # global guard lock is held. Before the project config is sourced, fall
    # back to a small known-good timeout if an invalid environment value was
    # supplied.
    log_timeout="${EDGE_DNS_LOG_TIMEOUT_SECONDS:-2}"
    case "$log_timeout" in
        ''|*[!0-9]*|0) log_timeout=2 ;;
    esac

    native_bounded_exec "$log_timeout" logger -t asus-edge-dns "$*" \
        >/dev/null 2>&1 || true
}

die() {
    echo "ERROR: $*" >&2
    log "ERROR: $*"
    exit 1
}

[ -r "$CONFIG_FILE" ] || die "missing $CONFIG_FILE"

# shellcheck disable=SC1090
. "$CONFIG_FILE"

: "${EDGE_UNBOUND_PORT:=53535}"
: "${EDGE_DNS_LOCAL_RESOLVER_IP:=}"
: "${EDGE_DNS_GUARD_WATCHDOG:=1}"
: "${EDGE_DNS_GUARD_BIN:=/jffs/addons/asus-edge/bin/dns-guard}"
: "${EDGE_DNS_FAILBACK_SUCCESS_THRESHOLD:=3}"
: "${EDGE_DNS_QUERY_TIMEOUT_SECONDS:=5}"
: "${EDGE_DNS_LOCK_WAIT_SECONDS:=5}"
: "${EDGE_DNS_LOG_TIMEOUT_SECONDS:=2}"
: "${EDGE_DNS_BOOTSTRAP_TEST_NAME:=example.com}"

case "$EDGE_DNS_FAILBACK_SUCCESS_THRESHOLD" in
    ''|*[!0-9]*)
        die "EDGE_DNS_FAILBACK_SUCCESS_THRESHOLD must be a positive integer"
        ;;
esac

[ "$EDGE_DNS_FAILBACK_SUCCESS_THRESHOLD" -gt 0 ] ||
    die "EDGE_DNS_FAILBACK_SUCCESS_THRESHOLD must be greater than zero"

case "$EDGE_DNS_QUERY_TIMEOUT_SECONDS" in
    ''|*[!0-9]*)
        die "EDGE_DNS_QUERY_TIMEOUT_SECONDS must be a positive integer"
        ;;
esac

[ "$EDGE_DNS_QUERY_TIMEOUT_SECONDS" -gt 0 ] ||
    die "EDGE_DNS_QUERY_TIMEOUT_SECONDS must be greater than zero"

case "$EDGE_DNS_LOCK_WAIT_SECONDS" in
    ''|*[!0-9]*)
        die "EDGE_DNS_LOCK_WAIT_SECONDS must be a positive integer"
        ;;
esac

[ "$EDGE_DNS_LOCK_WAIT_SECONDS" -gt 0 ] ||
    die "EDGE_DNS_LOCK_WAIT_SECONDS must be greater than zero"

case "$EDGE_DNS_LOG_TIMEOUT_SECONDS" in
    ''|*[!0-9]*)
        die "EDGE_DNS_LOG_TIMEOUT_SECONDS must be a positive integer"
        ;;
esac

[ "$EDGE_DNS_LOG_TIMEOUT_SECONDS" -gt 0 ] ||
    die "EDGE_DNS_LOG_TIMEOUT_SECONDS must be greater than zero"

[ -n "$EDGE_DNS_BOOTSTRAP_TEST_NAME" ] ||
    die "EDGE_DNS_BOOTSTRAP_TEST_NAME must not be empty"

bounded_exec() {
    native_bounded_exec "$EDGE_DNS_QUERY_TIMEOUT_SECONDS" "$@"
}

mkdir -p "$STATE_DIR" || die "cannot create $STATE_DIR"
chmod 700 "$STATE_DIR" 2>/dev/null || true

mkdir -p "$RUNTIME_STATE_DIR" || die "cannot create $RUNTIME_STATE_DIR"
chmod 700 "$RUNTIME_STATE_DIR" 2>/dev/null || true

executable_exists flock >/dev/null 2>&1 ||
    die "flock not found; cannot serialize DNS Guard state transitions"

exec 9>"$LOCK_FILE" || die "cannot open DNS Guard lock file"
lock_waited=0
while ! flock -xn 9; do
    [ "$lock_waited" -lt "$EDGE_DNS_LOCK_WAIT_SECONDS" ] ||
        die "cannot acquire DNS Guard lock within ${EDGE_DNS_LOCK_WAIT_SECONDS}s"
    lock_waited=$((lock_waited + 1))
    sleep 1
done

secure_temp_dir() {
    temp_prefix="$1"
    temp_counter=0

    while [ "$temp_counter" -lt 100 ]; do
        temp_candidate="$temp_prefix.$$.${temp_counter}"

        if (umask 077 && mkdir "$temp_candidate") 2>/dev/null; then
            printf '%s\n' "$temp_candidate"
            return 0
        fi

        temp_counter=$((temp_counter + 1))
    done

    return 1
}

recovery_streak_read() {
    [ -r "$RECOVERY_STREAK_FILE" ] || {
        printf '%s\n' 0
        return 0
    }

    streak="$(cat "$RECOVERY_STREAK_FILE" 2>/dev/null)" || streak=0

    case "$streak" in
        ''|*[!0-9]*)
            printf '%s\n' 0
            return 0
            ;;
    esac

    # Keep shell arithmetic bounded on 32-bit BusyBox targets. A corrupted
    # runtime file with an arbitrarily long digit string must not abort auto.
    [ "${#streak}" -le 9 ] || {
        printf '%s\n' 0
        return 0
    }

    if [ "$streak" -gt "$EDGE_DNS_FAILBACK_SUCCESS_THRESHOLD" ]; then
        printf '%s\n' "$EDGE_DNS_FAILBACK_SUCCESS_THRESHOLD"
    else
        printf '%s\n' "$streak"
    fi
}

runtime_state_write() {
    state_file="$1"
    state_value="$2"
    tmp="$state_file.tmp.$$"

    umask 077
    printf '%s\n' "$state_value" >"$tmp" || {
        rm -f "$tmp"
        return 1
    }

    chmod 600 "$tmp" 2>/dev/null || true

    mv -f "$tmp" "$state_file" || {
        rm -f "$tmp"
        return 1
    }

    return 0
}

runtime_uint_read() {
    state_file="$1"
    default_value="${2:-0}"
    max_digits="${3:-10}"

    case "$max_digits" in
        ''|*[!0-9]*|0)
            max_digits=10
            ;;
    esac

    [ -r "$state_file" ] || {
        printf '%s\n' "$default_value"
        return 0
    }

    state_value="$(cat "$state_file" 2>/dev/null)" || state_value="$default_value"

    case "$state_value" in
        ''|*[!0-9]*)
            printf '%s\n' "$default_value"
            ;;
        *)
            # Epoch seconds legitimately require 10 digits. Runtime counters
            # use a tighter bound at their call sites so corrupted telemetry
            # cannot feed implausible values back into shell arithmetic.
            if [ "${#state_value}" -le "$max_digits" ]; then
                printf '%s\n' "$state_value"
            else
                printf '%s\n' "$default_value"
            fi
            ;;
    esac
}

record_bootstrap_health() {
    health_value="$1"

    case "$health_value" in
        0|1) ;;
        *) return 1 ;;
    esac

    now_epoch="$(date +%s 2>/dev/null)" || return 1
    case "$now_epoch" in
        ''|*[!0-9]*) return 1 ;;
    esac

    runtime_state_write "$BOOTSTRAP_HEALTH_FILE" "$health_value" || return 1
    runtime_state_write "$BOOTSTRAP_HEALTH_CHECK_FILE" "$now_epoch" || return 1
    return 0
}

recovery_streak_write() {
    runtime_state_write "$RECOVERY_STREAK_FILE" "$1"
}

recovery_streak_reset() {
    rm -f "$RECOVERY_STREAK_FILE" 2>/dev/null || true
}

recovery_streak_increment() {
    streak="$(recovery_streak_read)"
    streak=$((streak + 1))

    if [ "$streak" -gt "$EDGE_DNS_FAILBACK_SUCCESS_THRESHOLD" ]; then
        streak="$EDGE_DNS_FAILBACK_SUCCESS_THRESHOLD"
    fi

    recovery_streak_write "$streak" || return 1
    printf '%s\n' "$streak"
}

resolver_is_local() {
    [ -r "$RESOLV_CONF" ] || return 1

    awk -v local="$EDGE_DNS_LOCAL_RESOLVER_IP" '
        $1 == "nameserver" {
            count++
            if ($2 == local)
                local_count++
        }
        END {
            exit !(count == 1 && local_count == 1)
        }
    ' "$RESOLV_CONF"
}

bootstrap_dns_candidate_valid() {
    candidate="$1"

    valid_ipv4 "$candidate" || return 1

    case "$candidate" in
        127.*|0.0.0.0)
            return 1
            ;;
    esac

    if [ -n "$EDGE_DNS_LOCAL_RESOLVER_IP" ] &&
       [ "$candidate" = "$EDGE_DNS_LOCAL_RESOLVER_IP" ]; then
        return 1
    fi

    return 0
}

bootstrap_dns() {
    accepted=""
    accepted_count=0

    # Collect across all known Asuswrt WAN DNS keys instead of trusting the
    # first syntactically valid source exclusively. /etc/resolv.conf-compatible
    # resolvers commonly honor at most three nameserver entries, so retain the
    # first three unique validated candidates across the ordered sources.
    for key in wan0_dns_r wan0_dns wan_dns_r wan_dns; do
        value="$(bounded_exec nvram get "$key" 2>/dev/null)"
        [ -n "$value" ] || continue

        key_accepted=0

        for candidate in $value; do
            if ! bootstrap_dns_candidate_valid "$candidate"; then
                log "WARNING: rejected non-independent WAN bootstrap DNS candidate from $key: $candidate"
                continue
            fi

            case " $accepted " in
                *" $candidate "*)
                    key_accepted=1
                    continue
                    ;;
            esac

            if [ "$accepted_count" -lt 3 ]; then
                accepted="$accepted $candidate"
                accepted_count=$((accepted_count + 1))
                key_accepted=1
            fi
        done

        [ "$key_accepted" -eq 1 ] ||
            log "WARNING: no usable new WAN bootstrap DNS candidates in $key"
    done

    [ -n "$accepted" ] || return 1

    for candidate in $accepted; do
        printf '%s\n' "$candidate"
    done
    return 0
}

valid_ipv4() {
    old_ifs="$IFS"
    IFS=.
    set -- $1
    IFS="$old_ifs"

    [ "$#" -eq 4 ] || return 1

    for octet in "$@"; do
        case "$octet" in
            ''|*[!0-9]*)
                return 1
                ;;
        esac

        [ "$octet" -le 255 ] 2>/dev/null || return 1
    done

    return 0
}

local_resolver_config_valid() {
    [ -n "$EDGE_DNS_LOCAL_RESOLVER_IP" ] || return 1
    valid_ipv4 "$EDGE_DNS_LOCAL_RESOLVER_IP"
}

resolver_is_bootstrap() {
    [ -r "$RESOLV_CONF" ] || return 1

    expected_bootstrap="$(bootstrap_dns)" || return 1
    current_resolvers="$(awk '$1 == "nameserver" {print $2}' "$RESOLV_CONF" 2>/dev/null)"

    [ -n "$current_resolvers" ] || return 1
    [ "$current_resolvers" = "$expected_bootstrap" ]
}

resolver_mode_observed() {
    if local_resolver_config_valid && resolver_is_local; then
        printf '%s\n' local
        return 0
    fi

    if resolver_is_bootstrap; then
        printf '%s\n' bootstrap
        return 0
    fi

    printf '%s\n' unknown
    return 1
}

record_resolver_mode() {
    new_mode="$1"

    case "$new_mode" in
        local|bootstrap) ;;
        *) return 1 ;;
    esac

    previous_mode="unknown"
    [ -r "$MODE_FILE" ] && previous_mode="$(cat "$MODE_FILE" 2>/dev/null || printf '%s\n' unknown)"

    now_epoch="$(date +%s 2>/dev/null)" || return 1
    case "$now_epoch" in
        ''|*[!0-9]*) return 1 ;;
    esac

    if [ "$previous_mode" != "$new_mode" ]; then
        runtime_state_write "$MODE_FILE" "$new_mode" || return 1
        runtime_state_write "$LAST_TRANSITION_FILE" "$now_epoch" || return 1

        if [ "$new_mode" = "bootstrap" ]; then
            fallback_count="$(runtime_uint_read "$FALLBACK_COUNT_FILE" 0 9)"
            fallback_count=$((fallback_count + 1))
            runtime_state_write "$FALLBACK_COUNT_FILE" "$fallback_count" || return 1
            runtime_state_write "$FALLBACK_SINCE_FILE" "$now_epoch" || return 1
        else
            rm -f "$FALLBACK_SINCE_FILE" 2>/dev/null || true
        fi
        return 0
    fi

    [ -r "$LAST_TRANSITION_FILE" ] || runtime_state_write "$LAST_TRANSITION_FILE" "$now_epoch" || return 1

    if [ "$new_mode" = "bootstrap" ] && [ ! -r "$FALLBACK_SINCE_FILE" ]; then
        runtime_state_write "$FALLBACK_SINCE_FILE" "$now_epoch" || return 1
    fi

    return 0
}

ntp_ready() {
    [ "$(bounded_exec nvram get ntp_ready 2>/dev/null)" = "1" ]
}

unbound_ready() {
    bounded_exec pidof unbound >/dev/null 2>&1 || return 1

    bounded_exec netstat -ln 2>/dev/null |
        grep -q "127\\.0\\.0\\.1:${EDGE_UNBOUND_PORT}[[:space:]]" ||
        return 1

    return 0
}

pihole_listener_ready() {
    local_resolver_config_valid || return 1
    bounded_exec pidof pihole-FTL >/dev/null 2>&1 || return 1

    bounded_exec netstat -ln 2>/dev/null |
        awk -v endpoint="$EDGE_DNS_LOCAL_RESOLVER_IP:53" '
            $4 == endpoint && $1 ~ /^udp/ { udp=1 }
            $4 == endpoint && $1 ~ /^tcp/ { tcp=1 }
            END { exit !(udp && tcp) }
        ' ||
        return 1

    return 0
}

probe_output_has_expected_ipv4() {
    probe_output="$1"
    expected_ipv4s="$2"

    for expected_ipv4 in $expected_ipv4s; do
        printf '%s\n' "$probe_output" |
            grep -F "$expected_ipv4" >/dev/null 2>&1 &&
            return 0
    done

    return 1
}

bounded_nslookup() {
    query_name="$1"
    query_server="${2:-}"

    if [ -n "$query_server" ]; then
        bounded_exec "$BUSYBOX" nslookup "$query_name" "$query_server"
        return
    fi

    bounded_exec "$BUSYBOX" nslookup "$query_name"
}

dns_probe_udp_ready() {
    probe_name="$1"
    expected_ipv4s="$2"

    query_output="$(
        bounded_nslookup "$probe_name" "$EDGE_DNS_LOCAL_RESOLVER_IP" 2>&1
    )" || return 1

    probe_output_has_expected_ipv4 "$query_output" "$expected_ipv4s"
}

dns_probe_tcp_ready() {
    probe_name="$1"
    expected_ipv4s="$2"

    # dig is optional on the router. Treat it as available only when the
    # binary can actually execute; an installed but ABI-incompatible Entware
    # binary must not force DNS Guard into fail-open by itself.
    executable_exists dig >/dev/null 2>&1 || return 0

    if ! bounded_exec dig -v >/dev/null 2>&1; then
        log "WARNING: dig is installed but not runnable; skipping active TCP DNS query probe"
        return 0
    fi

    query_output="$(
        bounded_exec dig +tcp +time=2 +tries=1 +short \
            @"$EDGE_DNS_LOCAL_RESOLVER_IP" "$probe_name" A 2>&1
    )" || return 1

    probe_output_has_expected_ipv4 "$query_output" "$expected_ipv4s"
}

dns_probe_path_ready() {
    probe_name="$1"
    expected_ipv4s="$2"

    dns_probe_udp_ready "$probe_name" "$expected_ipv4s" || return 1
    dns_probe_tcp_ready "$probe_name" "$expected_ipv4s" || return 1

    return 0
}

pihole_query_ready() {
    local_resolver_config_valid || return 1

    # Use two stable, cache-friendly public names from independent providers.
    # A successful primary OR secondary path is enough to avoid making one
    # external domain/provider the sole availability oracle.
    dns_probe_path_ready one.one.one.one "1.1.1.1 1.0.0.1" &&
        return 0

    dns_probe_path_ready dns.google "8.8.8.8 8.8.4.4" &&
        return 0

    return 1
}

bootstrap_dns_ready() {
    dns_list="$(bootstrap_dns)" || {
        record_bootstrap_health 0 ||
            log "WARNING: failed to record unavailable bootstrap DNS health"
        return 1
    }

    for dns in $dns_list; do
        if bounded_nslookup "$EDGE_DNS_BOOTSTRAP_TEST_NAME" "$dns" >/dev/null 2>&1; then
            record_bootstrap_health 1 ||
                log "WARNING: failed to record healthy bootstrap DNS state"
            return 0
        fi
    done

    record_bootstrap_health 0 ||
        log "WARNING: failed to record unhealthy bootstrap DNS state"
    return 1
}

full_local_dns_ready() {
    ntp_ready || return 1
    unbound_ready || return 1
    pihole_listener_ready || return 1
    pihole_query_ready || return 1

    return 0
}

watchdog_present() {
    [ "$EDGE_DNS_GUARD_WATCHDOG" = "1" ] || return 1

    expected="* * * * * $EDGE_DNS_GUARD_BIN auto >/dev/null 2>&1 #AsusEdgeDNSGuard#"
    watchdog_entries="$(bounded_exec cru l 2>/dev/null)" || return 1

    printf '%s\n' "$watchdog_entries" |
        grep -F -x "$expected" >/dev/null 2>&1
}

write_resolver() {
    mode="$1"

    resolv_dir="${RESOLV_CONF%/*}"
    [ "$resolv_dir" != "$RESOLV_CONF" ] || resolv_dir="."

    tmp_dir="$(secure_temp_dir "$resolv_dir/.asus-edge-dns-guard")" ||
        return 1
    tmp="$tmp_dir/resolv.conf"

    case "$mode" in
        local)
            if ! local_resolver_config_valid; then
                rm -f "$tmp"
                rmdir "$tmp_dir" 2>/dev/null || true
                return 1
            fi

            printf 'nameserver %s\n' \
                "$EDGE_DNS_LOCAL_RESOLVER_IP" >"$tmp" || {
                rm -f "$tmp"
                rmdir "$tmp_dir" 2>/dev/null || true
                return 1
            }
            ;;

        bootstrap)
            dns_list="$(bootstrap_dns)" || {
                rm -f "$tmp"
                rmdir "$tmp_dir" 2>/dev/null || true
                return 1
            }

            : >"$tmp" || return 1

            for dns in $dns_list; do
                printf 'nameserver %s\n' "$dns" >>"$tmp" ||
                    return 1
            done
            ;;

        *)
            rm -f "$tmp"
            rmdir "$tmp_dir" 2>/dev/null || true
            return 1
            ;;
    esac

    [ -s "$tmp" ] || {
        rm -f "$tmp"
        rmdir "$tmp_dir" 2>/dev/null || true
        return 1
    }

    if [ -f "$RESOLV_CONF" ] &&
       "$BUSYBOX" cmp -s "$tmp" "$RESOLV_CONF" 2>/dev/null; then
        rm -f "$tmp"
        rmdir "$tmp_dir" 2>/dev/null || true
        return 2
    fi

    chmod 644 "$tmp" 2>/dev/null || true

    mv -f "$tmp" "$RESOLV_CONF" || {
        rm -f "$tmp"
        rmdir "$tmp_dir" 2>/dev/null || true
        return 1
    }

    rmdir "$tmp_dir" 2>/dev/null || true
    return 0
}

promote_local_ready() {
    if [ -f "$BREAKGLASS_FLAG" ]; then
        echo "PROMOTE=BLOCKED_BREAKGLASS"
        log "local DNS promotion aborted: break-glass became active"
        return 1
    fi

    write_resolver local
    rc=$?

    case "$rc" in
        0)
            record_resolver_mode local ||
                log "WARNING: failed to record local DNS Guard monitoring state"
            echo "PROMOTE=PASS"
            log "system resolver promoted to Pi-hole $EDGE_DNS_LOCAL_RESOLVER_IP"
            return 0
            ;;
        2)
            record_resolver_mode local ||
                log "WARNING: failed to record local DNS Guard monitoring state"
            echo "PROMOTE=ALREADY_LOCAL"
            return 0
            ;;
        *)
            echo "PROMOTE=FAILED"
            log "ERROR: failed to promote resolver to Pi-hole"
            return 1
            ;;
    esac
}

promote_local() {
    if ! local_resolver_config_valid; then
        echo "PROMOTE=BLOCKED_INVALID_LOCAL_RESOLVER"
        log "ERROR: local DNS resolver target is missing or invalid"
        return 1
    fi

    if [ -f "$BREAKGLASS_FLAG" ]; then
        echo "PROMOTE=BLOCKED_BREAKGLASS"
        log "local DNS promotion blocked by active break-glass"
        return 1
    fi

    if ! full_local_dns_ready; then
        echo "PROMOTE=BLOCKED_UNHEALTHY"
        log "local DNS promotion blocked because DNS path is unhealthy"
        return 1
    fi

    promote_local_ready
}

fallback_bootstrap() {
    write_resolver bootstrap
    rc=$?

    case "$rc" in
        0|2)
            record_resolver_mode bootstrap ||
                log "WARNING: failed to record bootstrap DNS Guard monitoring state"

            if ! bootstrap_dns_ready; then
                echo "FALLBACK=UNHEALTHY_BOOTSTRAP"
                log "ERROR: WAN bootstrap DNS was selected but no configured resolver answered the functional probe"
                return 1
            fi

            if [ "$rc" -eq 0 ]; then
                echo "FALLBACK=PASS"
                log "system resolver restored to functional WAN bootstrap DNS"
            else
                echo "FALLBACK=ALREADY_BOOTSTRAP"
            fi
            return 0
            ;;
        *)
            record_bootstrap_health 0 ||
                log "WARNING: failed to record failed bootstrap DNS state"
            echo "FALLBACK=FAILED"
            log "ERROR: failed to restore WAN bootstrap DNS"
            return 1
            ;;
    esac
}

breakglass_on() {
    reason="${1:-manual}"
    recovery_streak_reset
    tmp="${BREAKGLASS_FLAG}.tmp.$$"

    umask 077

    {
        printf 'active=1\n'
        printf 'activated=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
        printf 'reason=%s\n' "$reason"
    } >"$tmp" || {
        rm -f "$tmp"
        return 1
    }

    chmod 600 "$tmp" 2>/dev/null || true

    mv -f "$tmp" "$BREAKGLASS_FLAG" || {
        rm -f "$tmp"
        return 1
    }

    log "DNS break-glass activated: $reason"

    if ! fallback_bootstrap; then
        echo "BREAKGLASS=ACTIVE_FALLBACK_PENDING"
        log "WARNING: DNS break-glass is active but WAN bootstrap DNS is not available yet"
        return 0
    fi

    echo "BREAKGLASS=ACTIVE"
    return 0
}

local_dns_ready() {
    if local_resolver_config_valid && full_local_dns_ready; then
        echo "READY=PASS"
        return 0
    fi

    echo "READY=FAIL"
    return 1
}

breakglass_off() {
    if [ -f "$BREAKGLASS_FLAG" ]; then
        rm -f "$BREAKGLASS_FLAG" || return 1
        log "DNS break-glass cleared"
    fi

    echo "BREAKGLASS=INACTIVE"
    return 0
}

auto_policy() {
    if [ -f "$BREAKGLASS_FLAG" ]; then
        recovery_streak_reset

        if fallback_bootstrap; then
            echo "AUTO=BOOTSTRAP_BREAKGLASS"
            return 0
        fi

        return 1
    fi

    if ! local_resolver_config_valid; then
        recovery_streak_reset
        log "ERROR: local DNS resolver target is missing or invalid; keeping bootstrap DNS"
        fallback_bootstrap || return 1
        echo "AUTO=BOOTSTRAP_CONFIG_INVALID"
        return 0
    fi

    if ! full_local_dns_ready; then
        recovery_streak_reset
        fallback_bootstrap || return 1
        echo "AUTO=BOOTSTRAP_UNHEALTHY"
        return 0
    fi

    if resolver_is_local; then
        recovery_streak_reset

        if promote_local_ready; then
            echo "AUTO=LOCAL_DNS"
            return 0
        fi

        fallback_bootstrap || return 1
        echo "AUTO=BOOTSTRAP"
        return 0
    fi

    # Hysteresis protects against local-path flapping only while the current
    # bootstrap escape path is itself usable. If bootstrap DNS is known-broken
    # and the complete local path is healthy, staying on bootstrap would create
    # an avoidable outage, so recover to local immediately.
    if ! bootstrap_dns_ready; then
        recovery_streak_reset

        if promote_local_ready; then
            echo "AUTO=LOCAL_DNS_BOOTSTRAP_UNHEALTHY"
            log "bootstrap DNS unhealthy; promoted immediately to healthy local DNS"
            return 0
        fi

        fallback_bootstrap || return 1
        echo "AUTO=BOOTSTRAP"
        return 0
    fi

    streak="$(recovery_streak_increment)" || {
        log "ERROR: failed to update DNS recovery hysteresis state"
        fallback_bootstrap || return 1
        echo "AUTO=BOOTSTRAP_HYSTERESIS_STATE_ERROR"
        return 0
    }

    echo "RECOVERY_STREAK=$streak/$EDGE_DNS_FAILBACK_SUCCESS_THRESHOLD"

    if [ "$streak" -lt "$EDGE_DNS_FAILBACK_SUCCESS_THRESHOLD" ]; then
        fallback_bootstrap || return 1
        echo "AUTO=BOOTSTRAP_RECOVERY_PENDING"
        return 0
    fi

    if promote_local_ready; then
        recovery_streak_reset
        echo "AUTO=LOCAL_DNS"
        return 0
    fi

    recovery_streak_reset
    fallback_bootstrap || return 1
    echo "AUTO=BOOTSTRAP"
    return 0
}

show_metrics() {
    observed_mode="$(resolver_mode_observed 2>/dev/null || true)"

    case "$observed_mode" in
        local)
            mode_local=1
            mode_bootstrap=0
            state_valid=1
            record_resolver_mode local || log "WARNING: failed to reconcile local DNS Guard monitoring state"
            ;;
        bootstrap)
            mode_local=0
            mode_bootstrap=1
            state_valid=1
            record_resolver_mode bootstrap || log "WARNING: failed to reconcile bootstrap DNS Guard monitoring state"
            ;;
        *)
            mode_local=0
            mode_bootstrap=0
            state_valid=0
            ;;
    esac

    if [ -f "$BREAKGLASS_FLAG" ]; then
        breakglass_active=1
    else
        breakglass_active=0
    fi

    last_transition="$(runtime_uint_read "$LAST_TRANSITION_FILE" 0)"
    fallback_count="$(runtime_uint_read "$FALLBACK_COUNT_FILE" 0 9)"
    fallback_since="$(runtime_uint_read "$FALLBACK_SINCE_FILE" 0)"
    bootstrap_healthy="$(runtime_uint_read "$BOOTSTRAP_HEALTH_FILE" 0)"
    bootstrap_last_check="$(runtime_uint_read "$BOOTSTRAP_HEALTH_CHECK_FILE" 0)"

    if watchdog_present; then
        watchdog_present_metric=1
    else
        watchdog_present_metric=0
    fi

    case "$bootstrap_healthy" in
        1) ;;
        *) bootstrap_healthy=0 ;;
    esac

    printf '%s\n' \
        "asus_edge_dns_guard_mode_local $mode_local" \
        "asus_edge_dns_guard_mode_bootstrap $mode_bootstrap" \
        "asus_edge_dns_guard_state_valid $state_valid" \
        "asus_edge_dns_guard_breakglass_active $breakglass_active" \
        "asus_edge_dns_guard_last_transition_timestamp_seconds $last_transition" \
        "asus_edge_dns_guard_fallback_transitions_runtime_total $fallback_count" \
        "asus_edge_dns_guard_fallback_since_timestamp_seconds $fallback_since" \
        "asus_edge_dns_guard_bootstrap_dns_healthy $bootstrap_healthy" \
        "asus_edge_dns_guard_bootstrap_dns_last_check_timestamp_seconds $bootstrap_last_check" \
        "asus_edge_dns_guard_watchdog_present $watchdog_present_metric"
}

show_status() {
    echo "=== ASUS EDGE DNS GUARD v3.2 ==="
    echo "resolver=$RESOLV_CONF"
    if local_resolver_config_valid; then
        echo "local_resolver=$EDGE_DNS_LOCAL_RESOLVER_IP"
        echo "LOCAL_RESOLVER_CONFIG=PASS"
    else
        echo "local_resolver=UNCONFIGURED_OR_INVALID"
        echo "LOCAL_RESOLVER_CONFIG=FAIL"
    fi
    echo "unbound_port=$EDGE_UNBOUND_PORT"
    echo "failback_success_threshold=$EDGE_DNS_FAILBACK_SUCCESS_THRESHOLD"
    echo "query_timeout_seconds=$EDGE_DNS_QUERY_TIMEOUT_SECONDS"
    echo "lock_wait_seconds=$EDGE_DNS_LOCK_WAIT_SECONDS"
    echo "recovery_streak=$(recovery_streak_read)/$EDGE_DNS_FAILBACK_SUCCESS_THRESHOLD"
    echo

    if [ -f "$BREAKGLASS_FLAG" ]; then
        echo "BREAKGLASS=ACTIVE"
    else
        echo "BREAKGLASS=INACTIVE"
    fi

    ntp_ready &&
        echo "NTP=PASS" ||
        echo "NTP=FAIL"

    unbound_ready &&
        echo "UNBOUND=PASS" ||
        echo "UNBOUND=FAIL"

    pihole_listener_ready &&
        echo "PIHOLE_LISTENER=PASS" ||
        echo "PIHOLE_LISTENER=FAIL"

    pihole_query_ready &&
        echo "PIHOLE_QUERY=PASS" ||
        echo "PIHOLE_QUERY=FAIL"

    echo
    echo "=== CURRENT RESOLVER ==="
    cat "$RESOLV_CONF" 2>/dev/null || true

    echo
    echo "=== BOOTSTRAP DNS ==="
    bootstrap_dns || echo "BOOTSTRAP_DNS=UNAVAILABLE"

    bootstrap_health="$(runtime_uint_read "$BOOTSTRAP_HEALTH_FILE" 0)"
    bootstrap_health_epoch="$(runtime_uint_read "$BOOTSTRAP_HEALTH_CHECK_FILE" 0)"
    case "$bootstrap_health_epoch:$bootstrap_health" in
        0:*) echo "BOOTSTRAP_DNS_HEALTH=UNKNOWN" ;;
        *:1) echo "BOOTSTRAP_DNS_HEALTH=PASS" ;;
        *) echo "BOOTSTRAP_DNS_HEALTH=FAIL" ;;
    esac
    echo "BOOTSTRAP_DNS_HEALTH_LAST_CHECK=$bootstrap_health_epoch"

    echo
    if [ -f "$BREAKGLASS_FLAG" ]; then
        echo "DECISION=KEEP_BOOTSTRAP_BREAKGLASS"
    elif ! local_resolver_config_valid; then
        echo "DECISION=KEEP_BOOTSTRAP_CONFIG_INVALID"
    elif full_local_dns_ready; then
        echo "DECISION=LOCAL_DNS_READY"
    else
        echo "DECISION=KEEP_BOOTSTRAP_DNS"
    fi
}

case "${1:-status}" in
    status|check)
        show_status
        ;;
    auto)
        auto_policy
        ;;
    promote)
        promote_local
        ;;
    fallback)
        recovery_streak_reset
        fallback_bootstrap
        ;;
    breakglass-on)
        breakglass_on "${2:-manual}"
        ;;
    breakglass-off)
        breakglass_off
        ;;
    ready)
        local_dns_ready
        ;;
    metrics)
        show_metrics
        ;;
    *)
        echo "Usage: $0 {status|check|auto|promote|fallback|ready|metrics|breakglass-on [reason]|breakglass-off}"
        exit 2
        ;;
esac
