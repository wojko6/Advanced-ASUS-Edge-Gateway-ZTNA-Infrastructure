# shellcheck shell=sh
# ISSUE #235 / DRAFT INSERTION ONLY — NOT ACTIVE, DO NOT DEPLOY.
# Proposed insertion: existing live JFFS post-mount blank line 17,
# after its swap section and before sourcing AMTM on line 18.
# Intentionally no "exit", "return", set -e, or early boot /opt dependency.
# The UUID mapping is PRIVATE and must never be committed to this repository.
ISSUE235_SSD_HELPER='/jffs/addons/asus-edge/bin/issue235-ssd-mount-mode'
ISSUE235_SSD_UUID_ROOT='/jffs/addons/asus-edge/private'
ISSUE235_SSD_UUID_FILE=''
# These checks run before reading a private UUID, without relying on Entware.
# The subshell prevents field-splitting/set -f from changing post-mount's $1.
ISSUE235_SSD_JFFS_ROOT='/jffs'
ISSUE235_SSD_ADDONS_ROOT='/jffs/addons'
ISSUE235_SSD_ADDON_ROOT='/jffs/addons/asus-edge'
ISSUE235_SSD_BIN_ROOT='/jffs/addons/asus-edge/bin'
ISSUE235_SSD_LS='/bin/busybox'
ISSUE235_SSD_OWNER='0:0'

issue235_secure_metadata() (
    expected=$1
    path=$2
    [ ! -L "$path" ] || return 1
    case "$expected" in
        drwxr-xr-x|drwx------) [ -d "$path" ] || return 1 ;;
        -rwxr-xr-x|-rw-------) [ -f "$path" ] || return 1 ;;
        *) return 1 ;;
    esac
    listing=$("$ISSUE235_SSD_LS" ls -ldn "$path" 2>/dev/null) || return 1
    set -f
    set -- $listing
    [ "$#" -ge 4 ] &&
        [ "$1" = "$expected" ] &&
        [ "$3:$4" = "$ISSUE235_SSD_OWNER" ]
)
case "${1-}" in
    /tmp/mnt/ROUTER_DATA)
        ISSUE235_SSD_UUID_FILE="$ISSUE235_SSD_UUID_ROOT/router-data.uuid"
        ;;
    /tmp/mnt/ENTWARE)
        ISSUE235_SSD_UUID_FILE="$ISSUE235_SSD_UUID_ROOT/entware.uuid"
        ;;
esac
if [ -n "$ISSUE235_SSD_UUID_FILE" ]; then
    if issue235_secure_metadata drwxr-xr-x "$ISSUE235_SSD_JFFS_ROOT" &&
       issue235_secure_metadata drwxr-xr-x "$ISSUE235_SSD_ADDONS_ROOT" &&
       issue235_secure_metadata drwxr-xr-x "$ISSUE235_SSD_ADDON_ROOT" &&
       issue235_secure_metadata drwxr-xr-x "$ISSUE235_SSD_BIN_ROOT" &&
       issue235_secure_metadata drwx------ "$ISSUE235_SSD_UUID_ROOT" &&
       issue235_secure_metadata -rwxr-xr-x "$ISSUE235_SSD_HELPER" &&
       issue235_secure_metadata -rw------- "$ISSUE235_SSD_UUID_FILE" &&
       [ -x "$ISSUE235_SSD_HELPER" ] &&
       [ -r "$ISSUE235_SSD_UUID_FILE" ]; then
        ISSUE235_SSD_UUID=''
        IFS= read -r ISSUE235_SSD_UUID < "$ISSUE235_SSD_UUID_FILE" || ISSUE235_SSD_UUID=''
        if [ -n "$ISSUE235_SSD_UUID" ]; then
            if "$ISSUE235_SSD_HELPER" "$1" "$ISSUE235_SSD_UUID"; then
                :
            else
                printf '%s\n' 'ISSUE235_POSTMOUNT_REPAIR=REVIEW'
            fi
        else
            printf '%s\n' 'ISSUE235_POSTMOUNT_REPAIR=NO_UUID'
        fi
    else
        printf '%s\n' 'ISSUE235_POSTMOUNT_REPAIR=NOT_READY'
    fi
fi
# END ISSUE235 / DRAFT INSERTION ONLY
