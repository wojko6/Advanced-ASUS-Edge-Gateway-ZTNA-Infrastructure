# Advanced ASUS Edge Gateway v2.0
# Copy to /jffs/configs/asus-edge.conf and adapt before applying.

EDGE_TS_IF="tailscale0"
EDGE_LAN_IF="br0"
EDGE_TS_SOCKET="/var/run/tailscale/tailscaled.sock"
EDGE_TS_STATE="/opt/var/lib/tailscale/tailscaled.state"

# ASUS Edge owns the iptables/ip6tables policy. Disable Tailscale's native
# netfilter management to avoid competing ts-* chains on Asuswrt-Merlin.
EDGE_TS_NETFILTER_MODE="off"

# Tailscale package changes are explicit maintenance actions. Keep automatic
# application disabled so updates cannot bypass project preflight/rollback.
EDGE_TS_AUTO_UPDATE="false"

EDGE_ROUTER_LAN_IP="192.168.50.1"
EDGE_TAILNET_V4_CIDR="100.64.0.0/10"

# Space-separated Tailscale IPv4 addresses/CIDRs allowed to administer the router.
# Keep empty until you know the stable Tailscale IP of each admin device.
EDGE_ADMIN_TS_SOURCES=""

# Router-local services available to EDGE_ADMIN_TS_SOURCES.
EDGE_ALLOW_ROUTER_HTTPS="1"
# External/admin port exposed through Tailscale.
EDGE_ROUTER_HTTPS_PORT="8443"
# Actual HTTPS listener used by ASUS httpds on the LAN address.
EDGE_ROUTER_HTTPS_TARGET_PORT="443"
EDGE_ALLOW_ROUTER_SSH="0"
EDGE_ROUTER_SSH_PORT="22"

# Optional RouterCloud service bound to a router-local IPv4 alias.
# When enabled, every EDGE_ADMIN_TS_SOURCES entry may access this HTTPS endpoint.
EDGE_ALLOW_ROUTERCLOUD="0"
EDGE_ROUTERCLOUD_IP=""
EDGE_ROUTERCLOUD_HTTPS_PORT="443"

# Force classic DNS from Tailscale clients through the router's resolver.
# This does not intercept DoH, DoT, or DoQ; control those with endpoint policy.
EDGE_INTERCEPT_DNS="1"

# Optional source-scoped Pi-hole path for selected Tailscale clients.
# Matching sources are DNATed to the dedicated Pi-hole DNS address before the
# normal Tailscale DNS REDIRECT fallback. Keep empty by default.
EDGE_TS_PIHOLE_SOURCES=""
EDGE_TS_PIHOLE_DNS_IP=""

# Router system-resolver target used by DNS Guard after the complete local DNS
# path is healthy. This is intentionally separate from EDGE_TS_PIHOLE_DNS_IP:
# the latter controls source-scoped Tailscale DNAT, while this setting controls
# /tmp/resolv.conf promotion for router-originated DNS. Configure the validated
# local Pi-hole IPv4 address explicitly; DNS Guard fails open to WAN bootstrap
# DNS when this value is missing or invalid.
EDGE_DNS_LOCAL_RESOLVER_IP=""

# Optional LAN classic-DNS enforcement. When enabled, TCP/UDP port 53 arriving
# from EDGE_LAN_IF is redirected to the router resolver even if a client targets
# an external DNS server. This does not intercept DoH, DoT, DoQ, VPN-carried DNS,
# or other encrypted/application-specific resolver transports.
# Keep disabled until the deployment has been validated and rollback is ready.
EDGE_ENFORCE_LAN_DNS="0"

# Optional LAN DNS-over-TLS control. When enabled, block direct TCP/853 from
# EDGE_LAN_IF with an immediate TCP reset. This is a DoT-specific control only:
# it does not block DoH/HTTPS, DoQ/QUIC, VPN-carried DNS, or other encrypted
# resolver transports. Strict/private-DNS clients may report DNS failure rather
# than fall back, so validate client compatibility before enabling permanently.
EDGE_BLOCK_LAN_DOT="0"
EDGE_DOT_PORT="853"

EDGE_DNS_PORT="53"

# Optional local resolver destinations that LAN classic-DNS enforcement must not
# redirect back to the router's default port-53 listener. Values are
# space-separated IPv4 addresses. This is intended for deliberately staged
# local resolvers, for example Pi-hole on a dedicated LAN alias. Keep empty
# unless listener ownership, rollback and health checks have been validated.
EDGE_LAN_DNS_BYPASS_IPS=""

EDGE_UNBOUND_PORT="53535"

# WAN-connected can race with services-start while Unbound is still recovering.
# The handler exits as soon as the local DNS path is ready; this is only the
# maximum startup wait, not an unconditional 90-second delay.
EDGE_WAN_DNS_WAIT_SECONDS="90"
EDGE_DNS_GUARD_WATCHDOG="1"
# Fail open immediately on an unhealthy local DNS path, but require this many
# consecutive healthy watchdog checks before switching back from WAN bootstrap
# DNS to the local Pi-hole path. Runtime streak state lives under /tmp and is
# intentionally reset on reboot.
EDGE_DNS_FAILBACK_SUCCESS_THRESHOLD="3"
# Leave empty to auto-detect amtm Unbound Manager first, then standard Entware.
# Set an explicit path if more than one Unbound configuration is present.
EDGE_UNBOUND_CONFIG=""
# Used only for direct recovery after the amtm-managed startup has settled.
EDGE_UNBOUND_BIN="/opt/sbin/unbound"
# Scope Entware's glibc to resolver recovery; do not export it globally.
EDGE_ENTWARE_LD_LIBRARY_PATH="/opt/lib:/opt/usr/lib"

# Least-privilege access to LAN services. Host entries are space-separated IPv4
# addresses or IPv4 CIDRs; hostnames are intentionally not resolved here so the
# firewall policy remains deterministic and does not depend on DNS at apply time.
# TCP/UDP port lists are also space-separated. Every listed host/network receives
# every listed TCP/UDP port below.
EDGE_ALLOWED_LAN_HOSTS=""
EDGE_ALLOWED_LAN_TCP_PORTS=""
EDGE_ALLOWED_LAN_UDP_PORTS=""
EDGE_ALLOW_LAN_ICMP="0"

# Optional source-scoped access for a legacy network printer. The policy stays
# disabled until both a printer address and at least one Tailscale source are set.
# Keep deployment-specific addresses in the router-local configuration.
EDGE_PRINTER_TS_SOURCES=""
EDGE_PRINTER_LAN_IP=""
EDGE_PRINTER_TCP_PORTS="80 631 9100"
EDGE_PRINTER_UDP_PORTS="161"

# Require the router's legacy USB print server to remain disabled. This is
# independent of direct access to a standalone LAN printer above. healthcheck.sh
# and check-usb-exposure.sh verify NVRAM, lpd/u2ec runtime processes, and the
# router TCP/515 listener. Set to 0 only when a USB printer is intentionally
# attached to the ASUS router.
EDGE_REQUIRE_USB_PRINTER_DISABLED="1"

# Preserve the original project's exit-node function while keeping LAN denied.
# The firewall allows forwarding only from tailscale0 to the detected WAN interface.
EDGE_ENABLE_EXIT_NODE="1"
EDGE_WAN_IF=""

EDGE_ADVERTISE_ROUTES="192.168.50.0/24"
EDGE_ACCEPT_DNS="false"
EDGE_HOSTNAME="asus-edge-gateway"

# Existing Merlin hooks are backed up but must not run before the managed hooks
# unless they have been reviewed and are known to be compatible.
EDGE_RUN_LEGACY_HOOKS="0"

EDGE_LOG_DROPS="1"
EDGE_LOG_PREFIX="ASUS-EDGE-DROP "
EDGE_OPT_WAIT_SECONDS="90"

# Router-attached storage service hardening. Keep these enabled when the device
# hosting /opt/Entware is infrastructure storage (for example the reference SSD)
# and is not intended to expose a user file share or media library through the router.
# These controls are independent of whether the physical medium is flash or SSD.
# Set either control to 0 only for a deliberate, documented exception.
EDGE_REQUIRE_DLNA_DISABLED="1"
EDGE_REQUIRE_SMB_DISABLED="1"

# amtm already runs rc.unslung from post-mount. Keep this disabled to avoid
# parallel Entware startup; enable only when no external hook owns rc.unslung.
EDGE_RUN_RC_UNSLUNG="0"
EDGE_ENTWARE_START_WAIT_SECONDS="330"
# Require a quiet interval after amtm/rc.unslung activity before recovery starts.
EDGE_ENTWARE_QUIET_SECONDS="20"
EDGE_SERVICE_STABILITY_SECONDS="5"
EDGE_SERVICE_START_ATTEMPTS="6"
EDGE_SERVICE_RETRY_SECONDS="5"
EDGE_UNBOUND_PIDFILE="/opt/var/run/unbound.pid"

# A Go daemon can fail before swap activation on a low-memory 32-bit router
# using strict vm.overcommit_memory=2. "auto" waits on affected platforms.
# Set to "1" to require swap on this deployment, or "0" to disable the guard.
EDGE_REQUIRE_SWAP="auto"
EDGE_SWAP_WAIT_SECONDS="60"
EDGE_TS_READY_WAIT_SECONDS="20"
EDGE_TAILSCALED_LOG="/opt/var/log/tailscaled.log"

# Optional centralized logging health target used by healthcheck.sh.
EDGE_SYSLOG_HOST=""
EDGE_SYSLOG_PORT="6514"

# Management-plane drift guards. Keep WAN WebUI disabled and require the stock
# ASUS access-restriction allowlist. EDGE_EXPECT_HTTP_AUTOLOGOUT is optional
# because deployments may deliberately choose a finite timeout or 0 (disabled).
EDGE_REQUIRE_WAN_WEBUI_DISABLED="1"
EDGE_REQUIRE_ACCESS_RESTRICTION="1"
EDGE_EXPECT_HTTP_AUTOLOGOUT=""

# Optional read-only Edge Gateway service portal links.
# Keep deployment-specific/private addresses in /jffs/configs/asus-edge.conf,
# not in the public repository. Empty values render as "Nie skonfigurowano".
EDGE_PORTAL_GRAFANA_URL=""
EDGE_PORTAL_NETWORK_DASHBOARD_URL=""
EDGE_PORTAL_ENGINEERING_DASHBOARD_URL=""
EDGE_PORTAL_DNS_ACTIVITY_URL=""
EDGE_PORTAL_PIHOLE_URL=""
EDGE_PORTAL_PERSONAL_CLOUD_URL=""
